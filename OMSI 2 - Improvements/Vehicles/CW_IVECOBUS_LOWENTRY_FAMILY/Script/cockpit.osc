				{endif}

				(L.L.cp_kneel_down_mode_pos) 1 >
				(L.L.cp_kneel_down_mode_drag_loop) 0 = &&
				{if}
					1 (S.L.cp_kneel_down_mode_drag_loop)
					(T.L.ev_kneel_stop)
				{endif}
			{endif}
		{endif}
		1 (S.L.cp_kneel_down_mode_drag)
	{endif}
{end}
			
