	(L.L.cp_klappfenster_UR2) ! (S.L.cp_klappfenster_UR2) s1
	(M.L.klappfenstersound)
{end}

{trigger:cp_klappfenster_UR3}
	(L.L.cp_klappfenster_UR3) ! (S.L.cp_klappfenster_UR3) s1
	(M.L.klappfenstersound)
{end}

{trigger:cp_klappfenster_UR4}
	(L.L.cp_klappfenster_UR4) ! (S.L.cp_klappfenster_UR4) s1
	(M.L.klappfenstersound)
{end}

{trigger:cp_klappfenster_UL1}
	(L.L.cp_klappfenster_UL1) ! (S.L.cp_klappfenster_UL1) s1
	(M.L.klappfenstersound)
{end}

{trigger:cp_klappfenster_UL2}
	(L.L.cp_klappfenster_UL2) ! (S.L.cp_klappfenster_UL2) s1
	(M.L.klappfenstersound)
{end}

{trigger:gasoline_hood}
	(L.L.bus_10meter) 1 =
	{if}
		(L.L.gasoline_hood_sw) ! (S.L.gasoline_hood_sw) s1
		(M.L.exthoodsound)
	{else}
		(C.L.door_middle_type) 2 <
		{if}
			(L.L.door_1) 0.38 <
			{if}
				(L.L.gasoline_hood_sw) ! (S.L.gasoline_hood_sw) s1
				(M.L.exthoodsound)
			{endif}
		{else}
			(L.L.gasoline_hood_sw) ! (S.L.gasoline_hood_sw) s1
			(M.L.exthoodsound)
		{endif}
	{endif}
{end}

{trigger:gasoline_hood2}
	(L.L.gasoline_hood2_sw) ! (S.L.gasoline_hood2_sw) s1
	(M.L.exthoodsound)
{end}

{trigger:adblue_hood}
	(L.L.adblue_hood_sw) ! (S.L.adblue_hood_sw) s1
	(M.L.exthoodsound)
{end}

{trigger:engine_hood}
	(L.L.Velocity) 50 <
	{if}
		(L.L.engine_hood_sw) ! (S.L.engine_hood_sw) s1
		(M.L.enginehoodsound)
	{endif}
{end}

{trigger:cp_Fahrertuer_drag}

	1 (S.L.cp_fahrertuer_dragged)
	(L.L.cp_fahrertuer_pos) (S.L.cp_fahrertuer_lastpos)

	(L.S.mouse_x) 500 / (L.L.cp_fahrertuer_pos) + (S.L.cp_fahrertuer_pos) s0
	l0 0 <
	{if}
		0 (S.L.cp_fahrertuer_pos)		
	{endif}
	l0 1 >
	{if}
		1 (S.L.cp_fahrertuer_pos)
	{endif}

	(L.L.cp_fahrertuer_pos) (L.L.cp_fahrertuer_lastpos) - (L.S.Timegap) / (S.L.cp_fahrertuer_speed)
{end}


{trigger:cp_Fahrertuer_off}
	0 (S.L.cp_fahrertuer_dragged)
{end}

{trigger:FM_toggle}
	(L.L.cp_elecidle)
	{if}
		(L.L.Snd_Radio) ! (S.L.Snd_Radio)

		(L.L.lights_fmtuner) 1 =
		{if}
			(T.L.ev_fmoff)
		{endif}

		(L.L.lights_fmtuner) ! (S.L.lights_fmtuner)
	{endif}
{end}


{trigger:taster_standheizung}
	(L.L.cp_taster_standheizung_target) ! (S.L.cp_taster_standheizung_target) s1

	1 (S.L.cp_taster_standheizung)	
{end}

{trigger:taster_standheizung_off}
	
	(L.L.cp_taster_standheizung_target)
	{if}
		0 (S.L.cp_taster_standheizung)
	{else}
		1 (S.L.cp_taster_standheizung)
	{endif}

{end}


{trigger:taster_nebelschluss}

	(L.L.cp_taster_nebelschluss_target) ! (S.L.cp_taster_nebelschluss_target)
	1 (S.L.cp_taster_nebelschluss) (M.L.kippschaltersound)		
{end}

{trigger:taster_nebelschluss_off}
	
	(L.L.cp_taster_nebelschluss_target)
	{if}
		0.6 (S.L.cp_taster_nebelschluss)
	{else}
		0 (S.L.cp_taster_nebelschluss)
	{endif}

{end}

{trigger:cp_wiperlever_drag}

'	Fallunterscheidung: Hebel in x- oder y-Richtung?

	(C.L.wiper_lever)
	{if}
	
		(L.S.mouse_y) abs (L.S.mouse_x) abs >=
		{if}
			(L.S.mouse_y) -50 / (L.L.cockpit_wischerhebel) + 0 max 1 min (S.L.cockpit_wischerhebel) s0
		
'			Stufen:
'			0: Aus
'			1: Intervall
'			2: Langsam
'			3: Schnell

			l0 0.17 <
			{if}
				1 (S.L.cockpit_wischerhebel_mode) (S.L.cp_wischer_intervall_sw)
				0 (S.L.cp_wischer_einaus_sw) (S.L.cp_wischer_schnell_sw)
			{else} 
				l0 0.5 <
				{if}
					0 (S.L.cockpit_wischerhebel_mode) (S.L.cp_wischer_intervall_sw)
					0 (S.L.cp_wischer_schnell_sw) (S.L.cp_wischer_einaus_sw)
				{else}
					l0 0.83 <
					{if}
						2 (S.L.cockpit_wischerhebel_mode)
						1 (S.L.cp_wischer_einaus_sw)
						0 (S.L.cp_wischer_intervall_sw) (S.L.cp_wischer_schnell_sw)
					{else}
						3 (S.L.cockpit_wischerhebel_mode)
						1 (S.L.cp_wischer_einaus_sw) (S.L.cp_wischer_schnell_sw)
						0 (S.L.cp_wischer_intervall_sw)
					{endif}
				{endif}
			{endif}
		{else}
			(L.S.mouse_x) -50 / (L.L.cockpit_wischerhebel_x) + 0 max 1 min (S.L.cockpit_wischerhebel_x) s1

'			Waschanlage (Hebel nach oben)	
			l1 0.9 >
			{if}
				(L.L.cp_wischer_wascher_sw) !
				{if}
					(T.L.ev_wischerhebel)
				{endif}
				1 (S.L.cp_wischer_wascher_sw)
			{else}
				(L.L.cp_wischer_wascher_sw)
				{if}
					(T.L.ev_wischerhebel)
				{endif}
				0 (S.L.cp_wischer_wascher_sw)
			{endif}

		{endif}
	{endif}

{end}

{trigger:cp_wiperlever_off}

'	Einrasten auf den festen Positionen:
	(L.L.cockpit_wischerhebel_mode) 3 / (S.L.cockpit_wischerhebel)
	(L.L.cp_wischer_wascher_sw)
	{if}
		(T.L.ev_wischerhebel)
		0 (S.L.cockpit_wischerhebel_x) (S.L.cp_wischer_wascher_sw)
	{endif}
{end}


{trigger:cp_wiper_turnswitch_drag}

'	(C.L.wiper_turnswitch)
'	{if}
	
		(L.S.mouse_y) -50 / (L.L.cockpit_wischer_drehschalter) + 0 max 1 min (S.L.cockpit_wischer_drehschalter) s0
	
'		Stufen:
'		0: Intervall
'		1: Aus
'		2: Langsam
'		3: Schnell

		l0 0.17 <
		{if}
			0 (S.L.cp_wischer_intervall_sw)
			0 (S.L.cockpit_wischer_drehschalter_mode) (S.L.cp_wischer_schnell_sw) (S.L.cp_wischer_einaus_sw)		
		{else} 
			l0 0.5 <
			{if}
				1 (S.L.cp_wischer_intervall_sw)
				0 (S.L.cp_wischer_einaus_sw) (S.L.cp_wischer_schnell_sw)
				1 (S.L.cockpit_wischer_drehschalter_mode)
			{else}
				l0 0.83 <
				{if}
					2 (S.L.cockpit_wischer_drehschalter_mode)
					1 (S.L.cp_wischer_einaus_sw)
					0 (S.L.cp_wischer_intervall_sw) (S.L.cp_wischer_schnell_sw)
				{else}
					3 (S.L.cockpit_wischer_drehschalter_mode)
					1 (S.L.cp_wischer_einaus_sw) (S.L.cp_wischer_schnell_sw)
					0 (S.L.cp_wischer_intervall_sw)
				{endif}
			{endif}
		{endif}
'	{endif}

{end}

{trigger:cp_wiper_turnswitch_off}

'	Einrasten auf den festen Positionen:
	(L.L.cockpit_wischer_drehschalter_mode) 3 / (S.L.cockpit_wischer_drehschalter)
{end}

{trigger:cp_wischer_schnell_toggle}
	(L.L.cp_wischer_schnell_sw) ! (S.L.cp_wischer_schnell_sw) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_schedule_pos_toggle}
	(L.L.cp_schedule_pos_int) ! (S.L.cp_schedule_pos_int)
{end}

'----------------------
'	Init
'----------------------

{macro:cockpit_init}

(L.L.bus_cng)
{if}
	1 (S.L.cng_cam_screen)
{endif}

	(C.L.dashboard_type) 1 =
	{if}
		1 (S.L.bus_sys_actia_dashboard)
	{endif}

90 100 random (S.L.display_actia_brakes_1_pr)
90 100 random (S.L.display_actia_brakes_2_pr)
90 100 random (S.L.display_actia_brakes_3_pr)
90 100 random (S.L.display_actia_brakes_4_pr)

	0.75 (S.L.actia_pos)
	0.9 (S.L.actia_posrot)

(L.L.bus_sys_actia_dashboard)
{if}

	-1 (S.L.cp_retarder_sw_actia)
	1 (S.L.cp_uncoupled_warning_tuer_sw)
	1 (S.L.cp_disabled_service_sw_actia)
	1 (S.L.cp_doors_single_sw_actia)
	-1 (S.L.cp_uncoupled_warning_tuer_sw_actia)
{endif}


'Setvar display frame

	(C.L.door_front_type) 0 =
	(C.L.door_front_type) 1 = ||
	(C.L.door_front_type) 4 = ||
	{if}
		0 (S.L.dash_has_doorlock)
	{else}
		1 (S.L.dash_has_doorlock)
	{endif}

	(L.L.sv_display_color) 0 =
	{if}
		60 (S.L.sv_display_color_hue)
		1 (S.L.sv_display_color_sat)
	{else}
		0 (S.L.sv_display_color_hue)
		0 (S.L.sv_display_color_sat)
	{endif}

'

0 (S.L.onboard_function)
15 (S.L.onboard_function_timer)


'

5 (S.L.speedlimiter_active_timer)
200 (S.L.Velocity_Max_Last)

'

(C.L.max_speed) (S.L.Velocity_Max)

' PMR

(C.L.door_rear_type) 1 =
{if}
	0 (S.L.cp_pmr_available)
{else}
	1 (S.L.cp_pmr_available)
{endif}

' HV PRO


'

	1 (S.L.onboard_getr_gang_delay)
	0 (S.L.cockpit_gangN) (S.L.cockpit_gangD) (S.L.cockpit_gangR) (S.L.cockpit_gang1) (S.L.cockpit_gang2) (S.L.cockpit_gang3) (S.L.cockpit_gang4)


' Check if polihv or pro


	0 (S.L.cockpit_hupe_volume) (S.L.cp_trip1_driving_time)
	1 (S.L.cp_lenkrad_visible)

	0 (S.L.cp_wischer_intervall_sw)
	0 (S.L.cockpit_wischer_drehschalter_mode)		

	0 (S.L.cp_taster_standheizung)

	(C.L.cockpit_zentralschmierung_dist) random (S.L.cp_zentralschmierung_nextkm)

	1 (S.L.haltewunsch_avail)
	0 (S.L.cp_mirrors_defrost_time_elapse)
	0 (S.L.cp_tuer_defrost_time_elapse)
	0 (S.L.cp_retarder_sw)
	0.2 (S.L.cp_whe_pos_rot)
	0.2 (S.L.cp_whe_pos_trans)
	2 (S.L.cp_schedule_pos)

' French plates init

	(L.L.sv_disable_plate) 0 =
	{if}
		(L.$.ident) $length 9 <
		{if}
			1 9 random s4
			0 9 random s5
			0 9 random s6
			
			1 9 random s2
			l2 0 =
			{if}
				"FS" (S.$.ident_prefix)
			{endif}
			l2 1 =
			{if}
				"EC" (S.$.ident_prefix)
			{endif}
			l2 2 =
			{if}
				"EG" (S.$.ident_prefix)
			{endif}
			l2 3 =
			{if}
				"DL" (S.$.ident_prefix)
			{endif}
			l2 4 =
			{if}
				"DT" (S.$.ident_prefix)
			{endif}
			l2 5 =
			{if}
				"DX" (S.$.ident_prefix)
			{endif}
			l2 6 =
			{if}
				"EE" (S.$.ident_prefix)
			{endif}
			l2 7 =
			{if}
				"EY" (S.$.ident_prefix)
			{endif}
			l2 8 =
			{if}
				"DX" (S.$.ident_prefix)
			{endif}
			l2 9 =
			{if}
				"DV" (S.$.ident_prefix)
			{endif}
		
			1 9 random s3
			l3 0 =
			{if}
				"DH" (S.$.ident_subfix)
			{endif}
			l3 1 =
			{if}
				"YZ" (S.$.ident_subfix)
			{endif}
			l3 2 =
			{if}
				"DV" (S.$.ident_subfix)
			{endif}
			l3 3 =
			{if}
				"PQ" (S.$.ident_subfix)
			{endif}
			l3 4 =
			{if}
				"PS" (S.$.ident_subfix)
			{endif}
			l3 5 =
			{if}
				"RR" (S.$.ident_subfix)
			{endif}
			l3 6 =
			{if}
				"LA" (S.$.ident_subfix)
			{endif}
			l3 7 =
			{if}
				"WN" (S.$.ident_subfix)
			{endif}
			l3 8 =
			{if}
				"AY" (S.$.ident_subfix)
			{endif}
			l3 9 =
			{if}
				"AG" (S.$.ident_subfix)
			{endif}
		
			"" (S.$.ident_generated)
		
			(L.$.ident_prefix) $+
			"-" $+
			l4 $IntToStr $+
			l5 $IntToStr $+
			l6 $IntToStr $+
			"-" $+
			(L.$.ident_subfix) $+
			(S.$.ident_generated)
		{else}
			(L.$.ident) (S.$.ident_generated)
		{endif}
	{endif}

	1 (S.L.bremse_doorsunlock_rep)
{end}

'----------------------
'	Frame
'----------------------
{macro:cockpit_frame}
	(C.L.dashboard_type) 1 =
	{if}
		1 (S.L.bus_sys_actia_dashboard)
	{endif}



	(L.L.elec_busbar_main)
	(L.L.cp_seatheater_sw) &&
	{if}
		1 (S.L.cp_seatheater_licht)
	{else}
		0 (S.L.cp_seatheater_licht)
	{endif}

	(L.L.elec_busbar_main) !
	(L.L.cp_brakevalve_licht_rep) 0 = &&
	(L.L.cp_brakevalve_licht) 1 = &&
	{if}
		0 (S.L.cp_brakevalve_licht)
		1 (S.L.cp_brakevalve_licht_rep)
		(T.L.ev_brake_valve_rel)
	{endif}
	(L.L.elec_busbar_main)
	{if}
		0 (S.L.cp_brakevalve_licht_rep)
	{endif}

	(L.L.elec_busbar_main)
	(L.L.cp_gong_sw) &&
	{if}
		1 (S.L.cp_gong_active)
	{else}
		0 (S.L.cp_gong_active)
	{endif}

' Actia modifications

' 	Driver door alert

	(L.L.elec_busbar_main)
	(L.L.bus_sys_actia_dashboard) &&
	(L.L.Velocity) 3 > &&
	(L.L.cp_fahrertuer_pos) 0.019 > &&
	{if}
		1 (S.L.cp_fahrertuer_alert)
	{else}
		0 (S.L.cp_fahrertuer_alert)
	{endif}

'   Hazard lights
	(L.L.lights_blinker_r) 1 =
	(L.L.lights_blinker_l) 1 = &&
	{if}
		1 (S.L.cp_blinker_warn_sw_active)
	{else}
		0 (S.L.cp_blinker_warn_sw_active)
	{endif}

'   ASR
	(L.L.elec_busbar_main)
	(L.L.cp_asr_sw) &&
	{if}
		1 (S.L.cp_asr_sw_active)
	{else}
		0 (S.L.cp_asr_sw_active)
	{endif}

'   Driver light
	(L.L.cp_licht_coupled_tuer_sw) 1 =
	(L.L.elec_busbar_main) &&
	{if}
		1 (S.L.cp_licht_coupled_tuer_active_up)
	{else}
		0 (S.L.cp_licht_coupled_tuer_active_up)
	{endif}

'   Passenger lights

	(L.L.cp_elecidle)
	{if}
		(L.L.cp_licht_passenger_sw) 1 =
		{if}
			1 (S.L.cp_licht_passenger_active_up)
		{endif}

		(L.L.cp_licht_passenger_sw) 0 =
		{if}
			0 (S.L.cp_licht_passenger_active_up)
		{endif}

		(L.L.cp_licht_passenger_sw) -1 =
		{if}
			1 (S.L.cp_licht_passenger_active_bottom) 1 (S.L.cp_licht_passenger_active_up)
		{else}
			0 (S.L.cp_licht_passenger_active_bottom)
		{endif}
	{else}
		0 (S.L.cp_licht_passenger_active_up) (S.L.cp_licht_passenger_active_bottom)
	{endif}

'   Passenger lights

	(L.L.elec_busbar_main)
	{if}
		(L.L.cp_onboard_btn_0_sw) -1 =
		{if}
			1 (S.L.cp_onboard_btn_0_sw_upactive)
		{else}
			0 (S.L.cp_onboard_btn_0_sw_upactive)
		{endif}

		(L.L.cp_onboard_btn_0_sw) 1 =
		{if}
			1 (S.L.cp_onboard_btn_0_sw_dwactive)
		{else}
			0 (S.L.cp_onboard_btn_0_sw_dwactive)
		{endif}
	{else}
		0 (S.L.cp_onboard_btn_0_sw_dwactive) (S.L.cp_onboard_btn_0_sw_upactive)
	{endif}

'   Engine on/off

	(L.L.bus_sys_actia_dashboard)
	{if}
		(L.L.cp_taster_motorabstellung) 1 =
		(L.L.cp_engine_start_sw) 0 = &&
		{if}
			1 (S.L.cp_engine_sw_actia)
		{else}
			(L.L.cp_taster_motorabstellung) 0 =
			(L.L.cp_engine_start_sw) 1 = &&
			{if}
				-1 (S.L.cp_engine_sw_actia)
			{else}
				0 (S.L.cp_engine_sw_actia)
			{endif}
		{endif}
	{endif}

	(L.L.elec_busbar_main)
	{if}
		(L.L.cp_engine_sw_actia) -1 = 
		{if}
			1 (S.L.cp_licht_engineon_sw)
		{else}
			0 (S.L.cp_licht_engineon_sw)
		{endif}
		(L.L.cp_engine_sw_actia) 1 = 
		{if}
			1 (S.L.cp_licht_engineoff_sw)
		{else}
			0 (S.L.cp_licht_engineoff_sw)
		{endif}
	{endif}

	(L.L.elec_busbar_main)
	(L.L.cp_test_sw_actia) &&
	{if}
'		1 (S.L.cp_test_sw_active)
	{else}
		0 (S.L.cp_test_sw_active)
	{endif}

'   PMR
	(L.L.cp_disabled_service_sw)
	{if}
		1 (S.L.cp_disabled_service_sw_actia)
	{else}
		-1 (S.L.cp_disabled_service_sw_actia)
	{endif}

	(L.L.cp_doors_single_sw)
	{if}
		1 (S.L.cp_doors_single_sw_actia)
	{else}
		-1 (S.L.cp_doors_single_sw_actia)
	{endif}
	
	(L.L.cp_uncoupled_warning_tuer_sw)
	{if}
		1 (S.L.cp_uncoupled_warning_tuer_sw_actia)
	{else}
		-1 (S.L.cp_uncoupled_warning_tuer_sw_actia)
	{endif}

'

	(L.L.elec_busbar_main)
	{if}
		(L.L.cp_actia_hornlight_sw) (S.L.cp_actia_hornlight_sw_active)
	{else}
		0 (S.L.cp_actia_hornlight_sw_active)
	{endif}

'

	(L.L.elec_busbar_main)
	{if}
		(L.L.cp_susp_lever_sw) -1 =
		{if}
			1 (S.L.cp_bremse_lever_sw_active_up)
		{else}
			0 (S.L.cp_bremse_lever_sw_active_up)
		{endif}

		(L.L.cp_susp_lever_sw) 1 =
		{if}
			1 (S.L.cp_bremse_lever_sw_active_bottom)
		{else}
			0 (S.L.cp_bremse_lever_sw_active_bottom)
		{endif}
	{else}
		0 (S.L.cp_bremse_lever_sw_active_up) (S.L.cp_bremse_lever_sw_active_bottom)
	{endif}

'

	(L.L.elec_busbar_main)
	{if}
		(L.L.cp_bremse_lever_sw) -1 =
		{if}
			1 (S.L.cp_kneel_lever_sw_active_up)
		{else}
			0 (S.L.cp_kneel_lever_sw_active_up)
		{endif}

