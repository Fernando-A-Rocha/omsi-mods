{trigger:cp_tuer0_toggle_a}
	1 (S.L.cp_tuer0_sw)
	0 (S.L.haltewunschlampe)
	(T.L.ev_sw_doors_on)
	
	(L.L.cp_door_lock_sw) 0 =
	(L.L.bremse_p_tank01) 550000 <
	(L.L.bremse_p_tank02) 550000 < || !	&&
	(L.L.cp_elecidle) &&
	{if}
		0 (S.L.doors_beep_front_duration)
		1 (S.L.doors_beep_front_running)




' 00 left 01 right

		(L.L.cp_doors_single_sw)
		{if}


			(L.L.doorTarget_0) 0 =
			{if}
				(L.L.cp_doors_single_sw) (S.L.cp_doors_single_sw_updated)

				(L.L.doorTarget_01) 1 = {if} 0 (S.L.doorTarget_01) {endif}

				1 (S.L.doorTarget_0)
				
				(L.L.door_front_type_val) 3 =
				(L.L.cp_doors_single_sw) &&
				{if}
					(T.L.ev_0_doortriggeropen_01)
				{else}
					(L.L.door_front_type_val) 2 =
					(L.L.cp_doors_single_sw) &&
					{if}
						(T.L.ev_0_doortriggeropen_01)
					{else}
						(T.L.ev_0_doortriggeropen_0)
					{endif}
				{endif}
				1 (S.L.doors_beep_front_avail)
			{else}
				(L.L.elec_busbar_main) {if} (T.L.ev_doortarget_0_on) 0 (S.L.doors_beep_front_avail) {endif}
			{endif}

		{else}


			(L.L.doorTarget_0) 0 =
			{if}
				1 (S.L.doorTarget_01) (S.L.doorTarget_0)
				
					(T.L.ev_0_doortriggeropen_0)
				
				
				1 (S.L.doors_beep_front_avail)
				(L.L.cp_doors_single_sw) (S.L.cp_doors_single_sw_updated)
			{else}
				(L.L.elec_busbar_main) {if} (T.L.ev_doortarget_0_on) 0 (S.L.doors_beep_front_avail) {endif}
			{endif}

		{endif}



	{endif}
{end}

{trigger:cp_tuer0_toggle_a_off}
	0 (S.L.cp_tuer0_sw)
	(T.L.ev_sw_doors_off)
	(T.L.ev_sw_doors_off)

	(L.L.door_0) 0.9 >
	(L.L.cp_elecidle) &&
	{if}
		(T.L.ev_doortarget_0_off)
	{endif}
{end}

{trigger:cp_tuer0_toggle_b}
	(T.L.ev_sw_doors_on)
	(L.L.cp_door_lock_sw) 0 =
	(L.L.bremse_p_tank01) 550000 <
	(L.L.bremse_p_tank02) 550000 < || !	&&
	(L.L.cp_elecidle) &&
	(L.L.Velocity) (C.L.door_close_max_velocity_target) < &&
	{if}
		0 (S.L.doors_beep_front_duration)
		1 (S.L.doors_beep_front_running)








		(L.L.doorTarget_0) 1 =
		{if}
			(L.L.cp_doors_single_sw) (S.L.cp_doors_single_sw_updated)

			(L.L.cp_doors_single_sw)
			{if}
				(L.L.doorTarget_01) 1 = {if} 0 (S.L.doorTarget_01) {endif}

				0 (S.L.doorTarget_0)


				(L.L.door_front_type_val) 3 =
				(L.L.cp_doors_single_sw) &&
				{if}
					(T.L.ev_0_doortriggerclose_01)
				{else}
					(L.L.door_front_type_val) 2 =
					(L.L.cp_doors_single_sw) &&
					{if}
						(T.L.ev_0_doortriggerclose_01)
					{else}
						(T.L.ev_0_doortriggerclose_0)
					{endif}
				{endif}
				
				1 (S.L.doors_beep_front_avail)
			{else}
				0 (S.L.doorTarget_01) (S.L.doorTarget_0)
				(T.L.ev_0_doortriggerclose_0) 1 (S.L.doors_beep_front_avail)
			{endif}

		{else}
			(L.L.elec_busbar_main) {if} (T.L.ev_doortarget_0_on) 0 (S.L.doors_beep_front_avail) {endif}
		{endif}


	{endif}
	-1 (S.L.cp_tuer0_sw)
{end}

