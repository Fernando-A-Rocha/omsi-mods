	(L.L.bus_sys_actia_dashboard) 0 =
	{if}
		(L.L.cp_uncoupled_retarder_sw)
		{if}
			0 (S.L.cp_uncoupled_retarder_sw) s1
			(T.L.ev_sw_main_off)
		{else}
			1 (S.L.cp_uncoupled_retarder_sw) s1
			(T.L.ev_sw_main_on)
		{endif}
	{else}
		(L.L.cp_uncoupled_retarder_sw)
		{if}
			-1 (S.L.cp_retarder_sw_actia)
			0 (S.L.cp_uncoupled_retarder_sw) s1
			(T.L.ev_sw_main_off)
		{else}
			1 (S.L.cp_uncoupled_retarder_sw) s1
			1 (S.L.cp_retarder_sw_actia)
			(T.L.ev_sw_main_on)
		{endif}
	{endif}

{end}

