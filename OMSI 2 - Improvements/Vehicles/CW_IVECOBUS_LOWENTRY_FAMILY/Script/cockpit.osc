{macro:tacho_frame}
	(L.L.elec_busbar_main) !
	{if}
		0 (S.L.throttle) (S.L.engine_throttle_injection) (S.L.engine_internal_throttle) (S.L.engine_additional_throttle)
		(L.L.cockpit_off_timer) 2 >
		{if}
			-7 (S.L.cockpit_drehzahlwinkel) (S.L.cockpit_tachowinkel)
		{else}
			0 (S.L.cockpit_tachowinkel) (S.L.cockpit_drehzahlwinkel)
		{endif}
		"" (S.$.cockpit_time)

		(L.L.cockpit_off_timer) (L.S.Timegap) + (S.L.cockpit_off_timer)
	{else}
		0 (S.L.cockpit_off_timer)
		(L.L.cockpit_init_timer) 4.5 <
		{if}
			-4 (S.L.cockpit_drehzahlwinkel)
		{else}

			(L.L.bus_sys_actia_dashboard)
			{if}
				(L.L.engine_n) 1 >
				{if}
					(L.L.engine_n) (F.L.cockpit_tachometer_actia) (S.L.cockpit_drehzahlwinkel)
				{else}
					0 (S.L.cockpit_drehzahlwinkel)
				{endif}
			{else}
				(L.L.cp_engine_running_time) 1 >
				{if}

					(L.L.bus_sys_actia_dashboard) 0 =
					{if}
						(L.L.tacho_rpmmeter) 0 =
						{if}
							(L.L.engine_n) (F.L.cockpit_tachometer_C9D) (S.L.cockpit_drehzahlwinkel)
						{else}
							(L.L.tacho_rpmmeter) 1 =
							{if}
								(L.L.engine_n) (F.L.cockpit_tachometer_T7D) (S.L.cockpit_drehzahlwinkel)
							{else}
								(L.L.tacho_rpmmeter) 2 =
								{if}
									(L.L.engine_n) (F.L.cockpit_tachometer_C9CNG) (S.L.cockpit_drehzahlwinkel)
								{else}
									(L.L.engine_n) (F.L.cockpit_tachometer_T72) (S.L.cockpit_drehzahlwinkel)
								{endif}
							{endif}
						{endif}
					{else}
						(L.L.engine_n) (F.L.cockpit_tachometer_actia) (S.L.cockpit_drehzahlwinkel)
					{endif}
				{else}
					0 (S.L.cockpit_drehzahlwinkel)
				{endif}
			{endif}

		{endif}

		(L.L.engine_on) 0 =
		(L.L.engine_n) 100 < &&
		{if}
			0 (S.L.cp_engine_running_time) (S.L.cp_engine_running_time_throttle)
			(L.L.cp_engine_running_time_throttle_b) (L.S.Timegap) + (S.L.cp_engine_running_time_throttle_b)

			(L.L.cp_engine_running_time_throttle_b) 5.5 >
			{if}
				0 (S.L.emergency_alarm_engine)
			{endif}
		{else}
			(L.L.cp_engine_running_time) (L.S.Timegap) + (S.L.cp_engine_running_time)
			(L.L.cp_engine_running_time_throttle) (L.S.Timegap) + (S.L.cp_engine_running_time_throttle)
		{endif}

		(L.L.engine_n) 650 >
		(L.L.engine_temperature) 39 < ||
		(L.L.cockpit_has_emergency_pressure) 1 = ||
		(L.L.bremse_feststell) 0 = ||
		(L.L.antrieb_getr_gangvorwahl) 1 > ||
		{if}
			0 (S.L.cp_engine_running_time_throttle)
			(L.L.engine_on) 1 = {if} 0 (S.L.emergency_alarm_engine) {endif}
		{endif}

		(L.L.emergency_alarm_engine) 0 = {if} 0 (S.L.cp_engine_running_time_throttle_b) {endif}

		(L.L.bussystem_phase) 1 =
		(L.L.cp_engine_running_time_throttle) 300 > &&
		(L.L.engine_temperature) 40 > &&
		(L.L.engine_on) 1 = &&
		(L.L.elec_busbar_main) &&
		(L.L.cockpit_has_emergency_pressure) 0 = &&
		{if}
