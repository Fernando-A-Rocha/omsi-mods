{trigger:cp_schluessel_mov_drag}

'	Fallunterscheidung: Schl�ssel in x- oder y-Richtung?
	
	(L.S.mouse_y) abs (L.S.mouse_x) abs >=
	{if}

'		Zun�chst Translation (Einstecken)
		
		(L.L.cp_schluessel_trans_mode)
		{if}
			(L.S.mouse_y) -25 / (L.L.cp_schluessel_rot) + 0 max 1.15 min (S.L.cp_schluessel_rot) s0
			(L.L.engine_on)
			{if}
				l0 1 max (S.L.cp_schluessel_rot) s0
			{endif}
		{else}
			0 (S.L.cp_schluessel_rot)
		{endif}
		
'		Stufen:
'		0: Schl�ssel abgezogen
'		1: Schl�ssel eingesteckt

		l0 0.2 <
		{if}
			0 (S.L.cp_schluessel_rot_mode) (S.L.elec_busbar_main_sw)
		{else} 
			l0 1.1 <
			{if}
				1 (S.L.cp_schluessel_rot_mode)
				(L.L.cp_elec_emergency_sw) 0 =
				{if}
					1 (S.L.elec_busbar_main_sw)
				{endif}
			{else}
				(L.L.cp_elec_emergency_sw) 0 =
				{if}
					2 (S.L.cp_schluessel_rot_mode) 
					(L.L.antrieb_getr_gang) 0 = (L.L.engine_n) 100 < && (L.L.elec_busbar_main) 0.3 > && (L.L.engine_starter_antirepeat) ! &&
					{if}
						1 (S.L.engine_starter) (S.L.engine_injection_on)
						(L.L.bus_cng) 1 =
						{if}
						{else}
							(L.L.engine_sv) 1 =
							{if}
								(T.L.ev_engine_starter)
							{else}

							{endif}
						{endif}
					{endif}
					1 (S.L.engine_starter_antirepeat)
				{endif}
			{endif}
				

'			Wenn beim Einstecken bereits der Stromkreis geschlossen werden soll, ohne Trennschalter:

			(C.L.automatic_battery_switch)
			(L.L.cp_elec_emergency_sw) 0 = &&
			{if}
				1 (S.L.elec_busbar_main_sw)
			{endif}		
		{endif}
	{else}
		(L.L.cp_schluessel_rot) 0.05 >
		{if}
			1 (S.L.cp_schluessel_trans)
			1 (S.L.cp_schluessel_trans_mode)
		{else}
			(L.S.mouse_x) -15 / (L.L.cp_schluessel_trans) + 0 max 1 min (S.L.cp_schluessel_trans) s0
			l0 0.8 <
			{if}
				0 (S.L.cp_schluessel_trans_mode)
			{else}
				1 (S.L.cp_schluessel_trans_mode)
			{endif}
		{endif}
	{endif}
{end}

