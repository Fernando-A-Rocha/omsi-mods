 		0 (S.L.onboard_actia_bus) (S.L.onboard_actia_bus_door_front) (S.L.onboard_actia_bus_door_middle) (S.L.onboard_actia_bus_door_rear) (S.L.onboard_actia_bus_wheels) (S.L.cockpit_light_enginehood_status_actia) (S.L.cockpit_light_brake_valve_actia) (S.L.cockpit_light_stop_request_actia)
