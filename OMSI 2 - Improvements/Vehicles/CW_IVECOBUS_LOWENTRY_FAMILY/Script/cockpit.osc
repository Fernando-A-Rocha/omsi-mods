{macro:onboard_frame}

' Onboard function screen
(L.L.onboard_function_timer) (L.S.Timegap) + (S.L.onboard_function_timer) 


(L.L.onboard_current) 1 =
(L.L.onboard_function_timer) 5 < &&
{if}
	1 (S.L.onboard_function)
{else}
	0 (S.L.onboard_function)
{endif}


(L.L.bus_suspensions_normal_timer) (L.S.Timegap) + (S.L.bus_suspensions_normal_timer) 

' LCD lightning

	(L.L.lights_stand)
	{if}
		0 (S.L.onboard_lighta)
		1 (S.L.onboard_lightb)
	{else}
		(L.L.elec_busbar_main)
		{if}
			0 (S.L.onboard_lightb)
			1 (S.L.onboard_lighta)
		{else}
			0 (S.L.onboard_lighta) (S.L.onboard_lightb)
		{endif}
	{endif}

	(L.L.cp_onboard_btn_0_timer) (L.S.Timegap) + (S.L.cp_onboard_btn_0_timer) 0.3 >
	(L.L.cp_onboard_btn_0_rep) 0 = &&
	(L.L.cockpit_init_timer) 3 > &&
	{if}

		1 (S.L.cp_onboard_btn_0_rep)
		0 (S.L.cp_onboard_btn_0_rep_trg)
		(L.L.cp_onboard_btn_0_type) 1 =
		{if}

			(L.L.bus_cng) 0 =
			{if}
				(L.L.onboard_current_step) 9 <
				{if}
					(L.L.onboard_current_step) 1 + (S.L.onboard_current_step)
				{else}
					1 (S.L.onboard_current_step)
				{endif}

				(L.L.onboard_current_step) abs (F.L.cockpit_onbo_phase1) (S.L.onboard_current)
			{endif}

			(L.L.bus_cng) 1 =
			{if}
				(L.L.onboard_current_step) 10 <
				{if}
					(L.L.onboard_current_step) 1 + (S.L.onboard_current_step)
				{else}
					1 (S.L.onboard_current_step)
				{endif}

				(L.L.onboard_current_step) abs (F.L.cockpit_onbo_cng) (S.L.onboard_current)
			{endif}

		{endif}

		(L.L.cp_onboard_btn_0_type) 2 =
		{if}

			(L.L.bus_cng) 0 =
			{if}
				(L.L.onboard_current_step) 1 >
				{if}
					(L.L.onboard_current_step) 1 - (S.L.onboard_current_step)
				{else}
					9 (S.L.onboard_current_step)
				{endif}

				(L.L.onboard_current_step) abs (F.L.cockpit_onbo_phase1) (S.L.onboard_current)
			{endif}

			(L.L.bus_cng) 1 =
			{if}
				(L.L.onboard_current_step) 1 >
				{if}
					(L.L.onboard_current_step) 1 - (S.L.onboard_current_step)
				{else}
					10 (S.L.onboard_current_step)
				{endif}

				(L.L.onboard_current_step) abs (F.L.cockpit_onbo_cng) (S.L.onboard_current)
			{endif}

