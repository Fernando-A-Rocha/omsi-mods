{trigger:cp_lightswitch_mov_drag}

'	Fallunterscheidung: Schl�ssel in x- oder y-Richtung?
	
	(L.S.mouse_y) abs (L.S.mouse_x) abs >=
	{if}

'		Zun�chst Translation (Einstecken)

'		Stufen:
'		1: Schl�ssel eingesteckt


'		Sonst Rotation (Lichtschalter)

		(L.S.mouse_x) -20 / (L.L.cp_lightswitch_rot) + 0 max 1 min (S.L.cp_lightswitch_rot) s1

		l1 0.8 >
		{if}
			(L.S.mouse_y) -50 / (L.L.lights_nebelschluss) + 0 max 1 min (S.L.lights_nebelschluss) s2
		{else}
			0 (S.L.lights_nebelschluss) s2
		{endif}


'		Stufen:
'		0: Licht aus
'		1: Standlicht
'		2: Abblendlicht

		l1 0.2 <
		{if}
			0 (S.L.cp_lightswitch_rot_mode) 
		{else} 
			l1 0.8 <
			{if}
				1 (S.L.cp_lightswitch_rot_mode) 
			{else}
				l2 0.2 <
				{if}
					0 (S.L.lights_nebel) (S.L.lights_nebelschluss)
				{else} 
					l2 0.5 <
					{if}
						0.5 (S.L.lights_nebel) (S.L.lights_nebelschluss)
					{else}
						1 (S.L.lights_nebel) (S.L.lights_nebelschluss)
					{endif}
				{endif}

				2 (S.L.cp_lightswitch_rot_mode)
			{endif}
		{endif}
	{endif}
{end}




{trigger:cp_lightswitch_mov_off}

