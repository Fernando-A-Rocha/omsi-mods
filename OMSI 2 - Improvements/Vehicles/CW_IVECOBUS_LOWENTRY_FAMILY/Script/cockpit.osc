'----------------------
'	Trigger
'----------------------


{trigger:cp_batterietrennschalter_toggle}
'	Aufschl�sselung
'	0 - Schl�ssel ziehen
'	1 - Schl�ssel stecken / Elektrik aus
'	2 - Elektrik ein / Motor aus
'	3 - Z�ndung ein
'	4 - Motor starten

	(L.L.key_mode) 1 + 4 min (S.L.key_mode)


	(L.L.key_mode) 1 =
	{if}
		1 (S.L.cp_key_pull)
		(T.L.ev_schluessel_steck)
	{endif}
	(L.L.key_mode) 2 =
	{if}
		1 (S.L.elec_busbar_main_sw) (S.L.bremse_ABS_selftest)
		(T.L.ev_schluessel_dreh)
		0.2 (S.L.cp_key_rot)
	{endif}
	(L.L.key_mode) 3 =
	{if}
		(T.L.ev_schluessel_dreh)
		0.4 (S.L.cp_key_rot)
		(T.L.ev_ignition)
	{endif}
	(L.L.key_mode) 4 =
	{if}
		(T.L.ev_schluessel_dreh)
	
		(L.L.antrieb_getr_gangwahl) 1 = (L.L.elec_busbar_main) 0.3 > &&
		(L.L.engine_on) ! &&
		(L.L.engine_starter_antirepeat) ! &&
		{if}
			1 (S.L.engine_starter) (S.L.engine_injection_on)
			(T.L.ev_engine_starter)
		{endif}	
		1 (S.L.engine_starter_antirepeat)

		0.6 (S.L.cp_key_rot)
	{endif}
{end}
			
{trigger:cp_batterietrennschalter_toggle_off}
	(L.L.key_mode) 4 =
	{if}
		3 (S.L.key_mode)
		(T.L.ev_schluessel_dreh)
		0 (S.L.engine_starter_antirepeat) (S.L.engine_starter)
		1 (S.L.engine_injection_on)

		0.4 (S.L.cp_key_rot)
	{endif}
{end}

{trigger:kw_m_enginestart}
	(L.L.key_mode) 1 - 0 max (S.L.key_mode)

	(L.L.key_mode) 0 =
	{if}
		(T.L.ev_schluessel_weg)
		0 (S.L.cp_key_pull)
	{endif}
	(L.L.key_mode) 1 =
	{if}
		0 (S.L.elec_busbar_main_sw)
		(T.L.ev_schluessel_dreh)
		0 (S.L.cp_key_rot)
	{endif}
	(L.L.key_mode) 2 =
	{if}
		(T.L.ev_schluessel_dreh)
	
		(L.L.elec_busbar_main) (C.L.elec_busbar_minV) > (L.L.bremse_p_Tank04) 400000 > &&
		(L.L.engine_on) &&
		(L.L.engine_starter_antirepeat) ! &&
		{if}
			0 (S.L.engine_injection_on)
			1 (S.L.engine_starter_antirepeat)
			(T.L.ev_engineshutdown)
		{endif}
		0.2 (S.L.cp_key_rot)
	{endif}
{end}

{trigger:kw_m_enginestart_off}
	0 (S.L.engine_starter_antirepeat)
{end}

{trigger:veh_tank}
	(L.L.engine_tank_content) (L.S.Timegap) 3 * + 250 min (S.L.engine_tank_content)
	(L.L.engine_adblue_content) (L.S.Timegap) 3 * + 250 min (S.L.engine_adblue_content)
{end}


{trigger:automatic_D}
	(L.L.antrieb_getr_gangvorwahl) 0 >
	(L.L.sys_geartype) &&
	(L.L.Velocity) 1 < &&
	(L.L.gearbox_sv) 0 > &&
	(L.L.brake) 0.08 > &&
	{if}
		(L.L.antrieb_getr_gangvorwahl) 4 = !
		{if}
			(T.L.ev_gangwahltaster)
			(L.S.getTime) (S.L.antrieb_getr_gangwahlzeitpunkt)
			0 (S.L.antrieb_getr_aktugang_last_onbochangetimer_drive)
		{endif}
		4 (S.L.antrieb_getr_gangvorwahl)
		1 (S.L.cockpit_gangD)
		0 (S.L.cockpit_gangN) (S.L.cockpit_gangR) (S.L.cockpit_gang1) (S.L.cockpit_gang2) (S.L.cockpit_gang3) (S.L.cockpit_gang4)
	{endif}
{end}

{trigger:automatic_D_off}
	(L.L.cockpit_gangD) 1 =
	{if}
		0.7 (S.L.cockpit_gangD)
	{endif}
{end}

{trigger:automatic_R}
	(L.L.antrieb_getr_gangvorwahl) 1 =
	(L.L.sys_geartype) &&
	(L.L.brake) 0.08 > &&
	(L.L.Velocity) 1 < &&
	(L.L.gearbox_sv) 0 > &&
	{if}
			(L.L.antrieb_getr_gangvorwahl) 0 = !
			{if}
				(T.L.ev_gangwahltaster)
				(L.S.getTime) (S.L.antrieb_getr_gangwahlzeitpunkt)
			{endif}
			
			0 (S.L.antrieb_getr_gangvorwahl)
				
			1 (S.L.cockpit_gangR)
			0 (S.L.cockpit_gangD) (S.L.cockpit_gangN) (S.L.cockpit_gang1) (S.L.cockpit_gang2) (S.L.cockpit_gang3) (S.L.cockpit_gang4)
	{endif}
{end}

{trigger:automatic_R_off}
	(L.L.cockpit_gangR) 1 =
	{if}
		0.7 (S.L.cockpit_gangR)
	{endif}
{end}

{trigger:automatic_N}
	(L.L.antrieb_getr_gangvorwahl) 1 = !
	(L.L.sys_geartype) &&
	(L.L.gearbox_sv) 0 > &&
	{if}
		(L.L.antrieb_getr_gangvorwahl) 1 = !
			{if}
				(T.L.ev_gangwahltaster_N)
				(L.S.getTime) (C.L.antrieb_gangwahlzeit) (C.L.antrieb_neutralwahlzeit) -  - (S.L.antrieb_getr_gangwahlzeitpunkt)
			{endif}
		1 (S.L.antrieb_getr_gangvorwahl) (S.L.cockpit_gangN)
		0 (S.L.cockpit_gangD) (S.L.cockpit_gangR) (S.L.cockpit_gang1) (S.L.cockpit_gang2) (S.L.cockpit_gang3) (S.L.cockpit_gang4)
	{endif}
{end}

{trigger:automatic_N_off}
	0 (S.L.cockpit_gangN)
{end}

{trigger:top_hatch_front}
	(L.L.cp_hatch_front_pos) 1 + (S.L.cp_hatch_front_pos)
	(L.L.cp_hatch_front_pos) 3 >
	{if}
		0 (S.L.cp_hatch_front_pos)
	{endif}

	(L.L.cp_hatch_front_pos) 0 = {if} 1 (S.L.cp_hatch_front_up) (S.L.cp_hatch_front_3) (S.L.cp_hatch_front_4) (T.L.ev_front_hatch_open) {endif}
	(L.L.cp_hatch_front_pos) 1 = {if} 1 (S.L.cp_hatch_front_down) (S.L.cp_hatch_front_1) (S.L.cp_hatch_front_2) (T.L.ev_front_hatch_open_) {endif}
	(L.L.cp_hatch_front_pos) 2 = {if} 0 (S.L.cp_hatch_front_up) (S.L.cp_hatch_front_3) (S.L.cp_hatch_front_4) (T.L.ev_front_hatch_close) {endif}
	(L.L.cp_hatch_front_pos) 3 = {if} 0 (S.L.cp_hatch_front_down) (S.L.cp_hatch_front_1) (S.L.cp_hatch_front_2) (T.L.ev_front_hatch_close_) {endif}
{end}

{trigger:top_hatch_rear}
	(L.L.cp_hatch_rear_pos) 1 + (S.L.cp_hatch_rear_pos)
	(L.L.cp_hatch_rear_pos) 3 >
	{if}
		0 (S.L.cp_hatch_rear_pos)
	{endif}

	(L.L.cp_hatch_rear_pos) 0 = {if} 1 (S.L.cp_hatch_rear_up) (S.L.cp_hatch_rear_3) (S.L.cp_hatch_rear_4) (T.L.ev_rear_hatch_open) {endif}
	(L.L.cp_hatch_rear_pos) 1 = {if} 1 (S.L.cp_hatch_rear_down) (S.L.cp_hatch_rear_1) (S.L.cp_hatch_rear_2) (T.L.ev_rear_hatch_open_) {endif}
	(L.L.cp_hatch_rear_pos) 2 = {if} 0 (S.L.cp_hatch_rear_up) (S.L.cp_hatch_rear_3) (S.L.cp_hatch_rear_4) (T.L.ev_rear_hatch_close) {endif}
	(L.L.cp_hatch_rear_pos) 3 = {if} 0 (S.L.cp_hatch_rear_down) (S.L.cp_hatch_rear_1) (S.L.cp_hatch_rear_2) (T.L.ev_rear_hatch_close_) {endif}
{end}

{trigger:driver_hood}
	(L.L.driver_hood_sw) ! (S.L.driver_hood_sw)
{end}

{trigger:automatic_1}
	(L.L.antrieb_getr_gangvorwahl) 0 >
	(L.L.sys_geartype) &&
	(L.L.brake) 0.12 > &&
	(L.L.gearbox_sv) 0 > &&
	(L.L.cp_geartype_123) 0 > &&
	{if}
		(L.L.antrieb_getr_gangvorwahl) 2 = !
		{if}
			(T.L.ev_gangwahltaster)
			(L.S.getTime) (S.L.antrieb_getr_gangwahlzeitpunkt)
			0 (S.L.antrieb_getr_aktugang_last_onbochangetimer_drive)
		{endif}
		2 (S.L.antrieb_getr_gangvorwahl)
		1 (S.L.cockpit_gang1)
		0 (S.L.cockpit_gangD) (S.L.cockpit_gangR) (S.L.cockpit_gangN) (S.L.cockpit_gang2) (S.L.cockpit_gang3) (S.L.cockpit_gang4)
	{endif}
{end}

{trigger:automatic_1_off}
	(L.L.cockpit_gang1) 1 =
	{if}
		0.7 (S.L.cockpit_gang1)
	{endif}
{end}

{trigger:automatic_2}
	(L.L.antrieb_getr_gangvorwahl) 0 >
	(L.L.sys_geartype) &&
	(L.L.brake) 0.12 > &&
	(L.L.gearbox_sv) 0 > &&
	(L.L.cp_geartype_123) 0 > &&
	{if}
		(L.L.antrieb_getr_gangvorwahl) 3 = !
		{if}
			(T.L.ev_gangwahltaster)
			(L.S.getTime) (S.L.antrieb_getr_gangwahlzeitpunkt)
			0 (S.L.antrieb_getr_aktugang_last_onbochangetimer_drive)
		{endif}
		3 (S.L.antrieb_getr_gangvorwahl)
		1 (S.L.cockpit_gang2)
		0 (S.L.cockpit_gangD) (S.L.cockpit_gangR) (S.L.cockpit_gangN) (S.L.cockpit_gang1) (S.L.cockpit_gang3) (S.L.cockpit_gang4)
	{endif}
{end}

{trigger:automatic_2_off}
	(L.L.cockpit_gang2) 1 =
	{if}
		0.7 (S.L.cockpit_gang2)
	{endif}
{end}

{trigger:automatic_3}

{end}

{trigger:automatic_3_off}
	(L.L.cockpit_gang3) 1 =
	{if}
		0.7 (S.L.cockpit_gang3)
	{endif}	
{end}

{trigger:horn}
	(L.L.cockpit_hupe) ! (L.L.elec_busbar_main) &&
	{if}
		(T.L.ev_hupe_an)
	{endif}
	1 (S.L.cockpit_hupe)
{end}

{trigger:horn_off}	
	(L.L.cockpit_hupe) (L.L.elec_busbar_main) &&
	{if}
		(T.L.ev_hupe_aus)
	{endif}
	0 (S.L.cockpit_hupe)	
{end}



{trigger:cp_motorkuehlung_toggle}
	(C.L.cockpit_has_coolingswitch)
	{if}
		(L.L.cp_motorkuehlung_sw) ! (S.L.cp_motorkuehlung_sw) s1
		(M.L.kippschaltersound)
	{endif}
{end}

{trigger:cp_fahrerlicht_toggle}
	(L.L.cp_fahrerlicht_sw) ! (S.L.cp_fahrerlicht_sw) s1
	(M.L.kippschaltersound)
{end}



{trigger:kw_wipermode_up}
	(L.L.cp_wischer_einaus_sw) ! (S.L.cp_wischer_einaus_sw) s1
	{if}
		2 (S.L.cockpit_wischerhebel_mode) (S.L.cockpit_wischer_drehschalter_mode)
		2 3 / (S.L.cockpit_wischerhebel) (S.L.cockpit_wischer_drehschalter)
		(L.L.cp_wischer_intervall_sw) !
		{if}
			(T.L.ev_wischerhebel)
		{endif}
	{else}
		(L.L.cp_wischer_intervall_sw)
		{if}
			1 (S.L.cockpit_wischerhebel_mode) (S.L.cockpit_wischer_drehschalter_mode)
			1 3 / (S.L.cockpit_wischerhebel) 
			0 (S.L.cockpit_wischer_drehschalter)
		{else}
			0 (S.L.cockpit_wischerhebel_mode) (S.L.cockpit_wischer_drehschalter_mode) (S.L.cockpit_wischerhebel) 
			1 3 / (S.L.cockpit_wischer_drehschalter)
			(T.L.ev_wischerhebel)
		{endif}
	{endif}
	(C.L.wiper_lever) !
	{if}
		l1 (M.L.kippschaltersound)
	{endif}
{end}

{trigger:cp_wischer_intervall_toggle}
	(L.L.cockpit_wischerhebel_mode) !
	{if}
		1 (S.L.cockpit_wischerhebel_mode) (S.L.cp_wischer_intervall_sw)
		1 (S.L.cp_wischer_einaus_sw) (S.L.cp_wischer_schnell_sw)
	{else}
		0 (S.L.cockpit_wischerhebel_mode) (S.L.cp_wischer_intervall_sw)
		0 (S.L.cp_wischer_schnell_sw) (S.L.cp_wischer_einaus_sw)
	{endif}
{end}

{trigger:cp_wischer_wascher_button}
	(T.L.ev_wischerhebel_btn_on)
	1 (S.L.cp_wischer_wascher_sw) s1
	(C.L.wiper_lever)
	{if}
		(T.L.ev_wischerhebel)
		1 (S.L.cockpit_wischerhebel_x)
	{endif}
{end}

{trigger:cp_wischer_wascher_button_off}
	0 (S.L.cp_wischer_wascher_sw) s1
	(T.L.ev_wischerhebel_btn_off)
	0 (S.L.cockpit_wischerhebel_x)
{end}



{trigger:cp_heizluefter_toggle}
	(L.L.cp_heizluefter_sw) 0 =
	{if}
		0.5 (S.L.cp_heizluefter_sw) s1
	{endif}
	
	(L.L.cp_heizluefter_sw) 0.5 =
	{if}
		1 (S.L.cp_heizluefter_sw) s1
	{endif}

	(L.L.cp_heizluefter_sw) 1 =
	{if}
		0 (S.L.cp_heizluefter_sw) s1
	{endif}
'	(L.L.cp_heizluefter_sw) ! (S.L.cp_heizluefter_sw) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_spiegelheizung_toggle}
	(L.L.cp_spiegelheizung_sw) ! (S.L.cp_spiegelheizung_sw) s1
	(M.L.kippschaltersound)
{end}



{trigger:cp_dummy_sw01_toggle}
	(L.L.cp_dummy_sw01) ! (S.L.cp_dummy_sw01) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_dummy_sw02_toggle}
	(L.L.cp_dummy_sw02) ! (S.L.cp_dummy_sw02) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_dummy_sw03_toggle}
	(L.L.cp_dummy_sw03) ! (S.L.cp_dummy_sw03) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_dummy_sw04_toggle}
	(L.L.cp_dummy_sw04) ! (S.L.cp_dummy_sw04) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_dummy_sw05_toggle}
	(L.L.cp_dummy_sw05) ! (S.L.cp_dummy_sw05) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_dummy_sw06_toggle}
	(L.L.cp_dummy_sw06) ! (S.L.cp_dummy_sw06) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_dummy_sw07_toggle}
	(L.L.cp_dummy_sw07) ! (S.L.cp_dummy_sw07) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_dummy_sw08_toggle}
	(L.L.cp_dummy_sw08) ! (S.L.cp_dummy_sw08) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_dummy_sw09_toggle}
	(L.L.cp_dummy_sw09) ! (S.L.cp_dummy_sw09) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_dummy_sw10_toggle}
	(L.L.cp_dummy_sw10) ! (S.L.cp_dummy_sw10) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_schalter_ASR_off_toggle}
	(L.L.cp_ASR_off) ! (S.L.cp_ASR_off) s1
	(M.L.kippschaltersound)
{end}

{trigger:cp_klimator_sw_drag}
	1 (S.L.cp_klimator_sw_last_ev_a)
	(L.S.mouse_y) -100 / (L.L.cp_klimator_sw) + (S.L.cp_klimator_sw) s0
	l0 0 <
	{if}
		0 (S.L.cp_klimator_sw)
	{endif}
	l0 1 >
	{if}
		1 (S.L.cp_klimator_sw)
	{endif}

	(L.L.cp_klimator_sw) (F.L.klimator_sw_curve) (S.L.cp_klimator_sw_curve)
{end}

{trigger:cp_klimator_sw_off}
	0 (S.L.cp_klimator_sw_last_ev_a)
	(L.L.cp_klimator_sw) s0
	l0 0.2 <
	{if}
		0 (S.L.cp_klimator_sw)
	{endif}

	l0 0.2 >
	{if}
		0.35 (S.L.cp_klimator_sw)
	{endif}

	l0 0.4 >
	{if}
		0.6 (S.L.cp_klimator_sw)
	{endif}
	
	l0 0.6 >
	{if}
		0.8 (S.L.cp_klimator_sw)
	{endif}

	l0 0.8 >
	{if}
		1 (S.L.cp_klimator_sw)
	{endif}
{end}

{trigger:cp_heizregler_temp_drag}
	(L.S.mouse_x) -150 / (L.L.cockpit_heizregler_temp) + 0 max 1 min (S.L.cockpit_heizregler_temp)

	(L.L.cp_rear_fan_sw) 0 =
	{if}
		(L.S.mouse_x) -150 / (L.L.cockpit_heizregler_temp) + 0 max 1 min (S.L.cockpit_heizregler_temp_val)
	{endif}
	
{end}

{trigger:cp_heizregler_fussraum_drag}
	(L.S.mouse_x) -150 / (L.L.cockpit_heizregler_fussraum) + 0 max 1 min (S.L.cockpit_heizregler_fussraum)
{end}

{trigger:cp_heizregler_umluft_drag}
	(L.S.mouse_x) -150 / (L.L.cockpit_heizregler_umluft) + 0 max 1 min (S.L.cockpit_heizregler_umluft) s0

'	Stufen:
'	0: Umluftheizung
