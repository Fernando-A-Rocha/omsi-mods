				(T.L.ev_kneel_stop)
			{endif}
		{else}
			(L.L.bremse_p_Tank04) 550000 >
			{if}
				(L.L.cp_kneel_down_mode_pos) (L.S.Timegap) 0.05 * + (S.L.cp_kneel_down_mode_pos)
				1 >
