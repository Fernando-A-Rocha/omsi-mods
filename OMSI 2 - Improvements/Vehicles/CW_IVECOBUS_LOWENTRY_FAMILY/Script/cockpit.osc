	{if}
		1.2 (S.L.cp_rear_fan_sw)
		0.8 (S.L.cockpit_heizregler_temp_val)
		(T.L.ev_sw_leftheat_1)
	{else}
		(L.L.cp_rear_fan_sw) 1.2 =
		{if}
			2 (S.L.cp_rear_fan_sw)
			1 (S.L.cockpit_heizregler_temp_val)
			(T.L.ev_sw_leftheat_2)
		{else}
			0 (S.L.cp_rear_fan_sw)
			0 (S.L.cockpit_heizregler_temp_val)
			(T.L.ev_sw_leftheat_dw)
		{endif}
	{endif}
{end}

{trigger:cp_leftrollo}
	(L.L.cp_leftrollo_sw) 0 =
	{if}
		1 (S.L.cp_leftrollo_sw)
	{else}
		0 (S.L.cp_leftrollo_sw)
	{endif}
{end}

{trigger:cp_socket_1}
	(L.L.cp_socket_1_obj) 0 =
	{if}
		1 (S.L.cp_socket_1_obj)
	{else}
		0 (S.L.cp_socket_1_obj)
	{endif}
{end}

{trigger:cp_socket_2}
	(L.L.cp_socket_2_obj) 0 =
	{if}
		1 (S.L.cp_socket_2_obj)
	{else}
		0 (S.L.cp_socket_2_obj)
	{endif}
{end}

{trigger:cp_socket_3}
	(L.L.cp_socket_3_obj) 0 =
	{if}
		1 (S.L.cp_socket_3_obj)
	{else}
		0 (S.L.cp_socket_3_obj)
	{endif}
{end}

{trigger:cp_driver_belt_put}
	1 (S.L.cp_driver_belt_vis)
	(T.L.ev_belt_on)
{end}

{trigger:cp_driver_belt_release}
	(L.L.cp_driver_belt_vis) 1 =
	{if}
		0 (S.L.cp_driver_belt_vis)
		(T.L.ev_belt_off)
	{else}
		(T.L.ev_belt_btn_on)
	{endif}
{end}

{trigger:cp_driver_belt_release_off}
	(T.L.ev_belt_btn_off)
{end}

{trigger:rampe_drag}
	(L.L.door_1) 0.9 >
	{if}
		(L.L.door_handrampe) 
		{if}
			0 (S.L.door_handrampe)	
			(T.L.ev_handrampe)		
		{else}	
			-180 (S.L.door_handrampe)
			(T.L.ev_handrampe)
		{endif} 
	{endif} 
{end}


{trigger:actia_move_drag}
	(L.L.cp_whe_pos_lock) 1 =
	{if}
		(L.S.mouse_y) -400 / (L.L.actia_pos) + (S.L.actia_pos) s0
		l0 0.3 <
		{if}
			0.3 (S.L.actia_pos)
			(L.L.actia_endanschlag) !
			{if}
				(T.L.ev_actia_move_up)
			{endif}		
			
		{endif}
		l0 1 >
		{if}
			1 (S.L.actia_pos)
			(L.L.actia_endanschlag) !
			{if}
				(T.L.actia_move_down)
			{endif}
			1 (S.L.actia_endanschlag)
		{endif}

		(L.L.actia_pos) s0 0 > l0 1 < &&
		{if}
			0 (S.L.actia_endanschlag)
		{endif}


		(L.S.mouse_x) 400 / (L.L.actia_posrot) + (S.L.actia_posrot) s0
		l0 0.67 <
		{if}
			0.67 (S.L.actia_posrot)
			(L.L.actia_endanschlagrot) !
			{if}
				(T.L.ev_actia_moverot_up)
			{endif}
			
			
		{endif}
		l0 1 >
		{if}
			1 (S.L.actia_posrot)
			(L.L.actia_endanschlagrot) !
			{if}
				(T.L.actia_moverot_down)
			{endif}
			1 (S.L.actia_endanschlagrot)
		{endif}

		(L.L.actia_posrot) s0 0 > l0 1 < &&
		{if}
			0 (S.L.actia_endanschlagrot)
		{endif}	
	{endif}
{end}


{trigger:cp_nebelswitch_mov_drag}
	(L.L.cp_lightswitch_rot) 0.8 >
	{if}
		(L.S.mouse_y) -400 / (L.L.actia_pos) + (S.L.lights_nebelschluss) s0
		l0 0 <
		{if}
			0 (S.L.lights_nebelschluss)
			
		{endif}
		l0 1 >
		{if}
			1 (S.L.lights_nebelschluss)
		{endif}
	{endif}
{end}