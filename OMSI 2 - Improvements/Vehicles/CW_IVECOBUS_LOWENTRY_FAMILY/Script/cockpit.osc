		{if}
			(T.L.ev_sw_e_elec_off)
		{else}
			(T.L.ev_sw_main_off)
		{endif}
		0 (S.L.elec_busbar_main_sw) (S.L.cp_schluessel_trans_lastmode) (S.L.cp_schluessel_rot) (S.L.cp_schluessel_rot_mode) (S.L.cp_schluessel_rot_lastmode)		
	{else}
		1 (S.L.cp_elec_emergency_sw) s1
		(L.L.bus_sys_actia_dashboard)
		{if}
			(T.L.ev_sw_e_elec_on)
		{else}
			(T.L.ev_sw_main_on)
		{endif}
		0 (S.L.elec_busbar_main) (S.L.elec_busbar_main_sw) (S.L.cp_elecidle) (S.L.engine_injection_on) (S.L.elec_busbar_avail) (S.L.cp_schluessel_trans) (S.L.cp_schluessel_trans_mode) (S.L.cp_schluessel_trans_lastmode) (S.L.cp_schluessel_rot) (S.L.cp_schluessel_rot_mode) (S.L.cp_schluessel_rot_lastmode)
