{trigger:bus_doorfront0}


	(L.L.cp_elecidle) (C.L.door_needs_stopbrake) ! &&
	(L.L.cp_elecidle) (L.L.bremse_halte) (C.L.door_needs_stopbrake) && && ||
	{if}


' 00 left 01 right

		(L.L.cp_doors_single_sw)
		{if}
			(L.L.doorTarget_01) 1 = {if} (M.L.trg_bus_doorfront01) {endif}

			(M.L.trg_bus_doorfront0)
		{else}

			(L.L.doorTarget_01) 1 =
			(L.L.doorTarget_0) 0 = &&
			{if}
				(M.L.trg_bus_doorfront01)
			{else}
				(L.L.doorTarget_01) 0 =
				(L.L.doorTarget_0) 1 = &&
				{if}
					(M.L.trg_bus_doorfront0)
				
				{else}
					(L.L.doorTarget_01) 0 =
					(L.L.doorTarget_0) 0 = &&
					{if}
						(M.L.trg_bus_doorfront0)
						(M.L.trg_bus_doorfront01)
					{else}
						(L.L.doorTarget_01) 1 =
						(L.L.doorTarget_0) 1 = &&
						{if}
							(M.L.trg_bus_doorfront0)
							(M.L.trg_bus_doorfront01)
						{endif}
					{endif}
				{endif}
			{endif}
		{endif}

	{else}
		1 (S.L.cp_tuer0_sw)
	{endif}
	(T.L.ev_sw_doors_on)
{end}

{trigger:bus_doorfront0_off}
	0 (S.L.cp_tuer0_sw)
	(L.L.doorTarget_0) 0 =
	{if}
		(T.L.ev_sw_doors_off)
	{else}
		(T.L.ev_sw_doors_on)
	{endif}
{end}

{trigger:bus_doorfront0_external}
	-1 (S.L.door_external_sw)
	(L.L.elec_busbar_avail)
	{if}
	0 (S.L.doors_beep_front_duration)
	1 (S.L.doors_beep_front_running) (S.L.doors_beep_front_avail)
	(T.L.ev_busdoorfrontexternal)
	
		(L.L.doorTarget_0) !
		{if}


				(L.L.door_front_type_val) 3 =
				(L.L.cp_doors_single_sw) &&
				{if}
					(T.L.ev_0_doortriggeropen_01)
					(L.L.doorTarget_0) ! (S.L.doorTarget_0)
				{else}
					(L.L.door_front_type_val) 2 =
					(L.L.cp_doors_single_sw) &&
					{if}
						(L.L.doorTarget_0) ! (S.L.doorTarget_0)
						(T.L.ev_0_doortriggeropen_01)
					{else}
						(L.L.doorTarget_01) ! (S.L.doorTarget_01)
						(L.L.doorTarget_0) ! (S.L.doorTarget_0)
						(T.L.ev_0_doortriggeropen_0)
					{endif}
				{endif}

		{else}
			(L.L.Velocity) (C.L.door_close_max_velocity_target) <
			{if}


				(L.L.door_front_type_val) 3 =
				(L.L.cp_doors_single_sw) &&
				{if}
					(L.L.doorTarget_0) ! (S.L.doorTarget_0)
					(T.L.ev_0_doortriggerclose_01)
				{else}
					(L.L.door_front_type_val) 2 =
					(L.L.cp_doors_single_sw) &&
					{if}
						(L.L.doorTarget_0) ! (S.L.doorTarget_0)
						(T.L.ev_0_doortriggerclose_01)
					{else}
						(L.L.doorTarget_01) ! (S.L.doorTarget_01)
						(L.L.doorTarget_0) ! (S.L.doorTarget_0)
						(T.L.ev_0_doortriggerclose_0)
					{endif}
				{endif}
			{endif}
		{endif}
	{endif}
	(T.L.ev_doorexternal_on)
{end}

{trigger:bus_doorfront0_external_off}
	0 (S.L.door_external_sw)
	(T.L.ev_doorexternal_off)
{end}

{trigger:bus_doorfront1}
	(L.L.cp_elecidle)
	{if}
		(M.L.trg_bus_doorfront1)
	{else}
		1 (S.L.cp_tuer1_sw)
	{endif}
	(T.L.ev_sw_doors_on)
{end}

{trigger:bus_doorfront1_off}
	(T.L.ev_kippschalter_aus)
	0 (S.L.cp_tuer1_sw)
	(L.L.doorTarget_1) 0 =
	{if}
		(T.L.ev_sw_doors_off)
	{else}
		(T.L.ev_sw_doors_on)
	{endif}
{end}

{trigger:bus_dooraft}
	1 (S.L.cp_brakevalve_sw)

	(L.L.sv_dash_bvalve_callback)
	(L.L.Velocity) abs 1 < &&
	(L.L.elec_busbar_main) &&
	{if}
		(L.L.cp_brakevalve_licht) ! (S.L.cp_brakevalve_licht)
		
		(L.L.cp_brakevalve_licht) 1 =
		{if}
			(T.L.ev_brake_valve_set)
		{else}
			(T.L.ev_brake_valve_rel)
		{endif}
	{endif}

	(L.L.sv_dash_bvalve_callback)
	{if}
		(T.L.ev_sw_main_on)
	{endif}
{end}

{trigger:bus_dooraft_off}
	0 (S.L.cp_brakevalve_sw)
	(L.L.sv_dash_bvalve_callback)
	{if}
		(T.L.ev_sw_main_off)
	{endif}
{end}

{trigger:bus_20h-switch}
	(C.L.cockpit_has_20h_switch)
	{if}
		(M.L.trg_bus_20h-switch)
	{endif}
{end}

{trigger:int_haltewunsch}
	1 (S.L.haltewunsch)
{end}

{trigger:door_haltewunsch}
	1 (S.L.haltewunsch) (S.L.door_haltewunsch_knopfdruck)
{end}

{trigger:door_haltewunsch_off}
	0 (S.L.door_haltewunsch_knopfdruck)
{end}

{trigger:cp_schalter_kinderwagen}
	(L.L.door_handsteuerung) ! (S.L.door_handsteuerung)
	{if}
		0 (S.L.door_kinderwagenwunsch)
		(T.L.ev_kippschalter_ein)
	{else}
		(T.L.ev_kippschalter_aus)
	{endif}
		
{end}

{trigger:door_kinderwagenwunsch}
	(L.L.bremse_halte) (L.L.door_handsteuerung) ! &&
	{if}
		1 (S.L.door_kinderwagenwunsch)
	{endif}
{end}

{trigger:cp_doorEntriegelung_01}

{end}


{macro:Door_Init}
	1000 random 500 / 1 - (C.L.door_acc_var) * (C.L.fdoor_acc) + (S.L.doorAcc_0)
	1000 random 500 / 1 - (C.L.door_acc_var) * (C.L.fdoor_acc) + (S.L.doorAcc_01)
	1000 random 500 / 1 - (C.L.door_acc_var) * (C.L.fdoor_acc) + (S.L.doorAcc_1)
	1000 random 500 / 1 - (C.L.door_acc_var) * (C.L.bdoor_acc) + (S.L.doorAcc_2)
	1000 random 500 / 1 - (C.L.door_acc_var) * (C.L.bdoor_acc) + (S.L.doorAcc_3)

	1000 random 500 / 1 - (C.L.door_maxspeed_var) * (C.L.fdoor_maxspeed) + (S.L.doorMaxSpeed_0_norm)
	1000 random 500 / 1 - (C.L.door_maxspeed_var) * (C.L.fdoor_maxspeed) + (S.L.doorMaxSpeed_01_norm)
	1000 random 500 / 1 - (C.L.door_maxspeed_var) * (C.L.fdoor_maxspeed) + (S.L.doorMaxSpeed_1_norm)
	1000 random 500 / 1 - (C.L.door_maxspeed_var) * (C.L.bdoor_maxspeed) + (S.L.doorMaxSpeed_2_norm)
	1000 random 500 / 1 - (C.L.door_maxspeed_var) * (C.L.bdoor_maxspeed) + (S.L.doorMaxSpeed_3_norm)


	(C.L.door_front_type) 3 =
	{if}
		0.25 (S.L.doorRefl_0)
	{endif}

	(C.L.door_front_type) 2 =
	{if}
		0.25 (S.L.doorRefl_0)
	{endif}


	(C.L.door_middle_type) 0 =
	{if}
		0.25 (S.L.doorRefl_1)
	{endif}

	(C.L.door_middle_type) 1 =
	{if}
		0.25 (S.L.doorRefl_1)
	{endif}
	
{end}

{macro:Door_Frame}

	(C.L.door_front_type) (S.L.door_front_type_val)
	(C.L.door_middle_type) (S.L.door_middle_type_val)
	(C.L.door_rear_type) (S.L.door_rear_type_val)

	(M.L.Door0_Calc)
	(M.L.Door1_Calc)
	(M.L.Door2_Calc)
	(M.L.DoorAftCalc)

	(L.L.doorTarget_1) (S.L.doorTarget_2)
	(L.L.doorTarget_1) (S.L.doorTarget_21)

	(L.L.door_0) 0.9 > (S.L.PAX_Entry0_Open)
	


	(L.L.door_1) 0.9 > (S.L.PAX_Exit0_Open) (S.L.PAX_Exit1_Open)


'	Gasoline hood prevent
		(L.L.door_1) 0.38 >
		(C.L.door_middle_type) 2 < &&
		{if}
			(L.L.gasoline_hood_sw) 1 =
			(L.L.gasoline_hood_repeat) 0 = &&
			{if}
				1 (S.L.gasoline_hood_repeat)
				(T.L.ev_exthood_cls)
			{endif}
			0 (S.L.gasoline_hood_sw)
		{else}
			0 (S.L.gasoline_hood_repeat)
		{endif}

	(L.L.door_rear_type_val) 0 >
	(L.L.door_21) 0.38 > &&
	(L.L.adblue_hood_sw) 1 = &&
	{if}
		0 (S.L.adblue_hood_sw)
	{endif}


'	Doors status

	(L.L.door_0) 0.1 >
	(L.L.cp_elecidle) &&
	{if}
		1 (S.L.doors_are_open)
		1 (S.L.door_light_1)
		1 (S.L.doors_toplights_front)
	{else}
		(L.L.cp_licht_emer_sw)
		(L.L.cp_elecidle) &&
		{if}
			1 (S.L.door_light_1)
			0 (S.L.doors_toplights_front)
		{else}
			0 (S.L.door_light_1)
			0 (S.L.doors_toplights_front)
		{endif}
	{endif}

	(C.L.door_rear_type) 0 =
	{if}
		(L.L.door_0) 0.1 <
		(L.L.door_11) 0.05 < &&
		{if}
			0 (S.L.doors_are_open)
		{endif}

		(L.L.door_11) 0.05 >
		(L.L.cp_elecidle) &&
		{if}
			1 (S.L.doors_are_open)
			1 (S.L.door_light_2)
			1 (S.L.doors_toplights_rear)
		{else}
			(L.L.cp_licht_emer_sw)
			(L.L.cp_elecidle) &&
			{if}
				1 (S.L.door_light_2)
				0 (S.L.doors_toplights_rear)
			{else}
				0 (S.L.door_light_2)
				0 (S.L.doors_toplights_rear)
			{endif}
		{endif}
	{else}
		(L.L.door_0) 0.1 <
		(L.L.door_1) 0.05 < &&
		{if}
			0 (S.L.doors_are_open)
		{endif}

		(L.L.door_1) 0.05 >
		(L.L.cp_elecidle) &&
		{if}
			1 (S.L.doors_are_open)
			1 (S.L.door_light_2)
			1 (S.L.doors_toplights_rear)
		{else}
			(L.L.cp_licht_emer_sw)
			(L.L.cp_elecidle) &&
			{if}
				1 (S.L.door_light_2)
				0 (S.L.doors_toplights_rear)
			{else}
				0 (S.L.door_light_2)
				0 (S.L.doors_toplights_rear)
			{endif}
		{endif}
	{endif}


	(L.L.throttle) 0.06 >
	(L.L.doors_bremse) 1 = &&
	(L.L.doors_bremse_active) 0 = &&
	(L.L.elec_busbar_main) &&
	{if}
		(T.L.ev_doors_bremse_rel)
		0 (S.L.doors_bremse)
		0 (S.L.doors_bremse_active)
	{endif}

	(L.L.throttle) 0.06 >
	(L.L.doors_bremse_active) 0 = &&
	(L.L.elec_busbar_main) &&
	{if}
		0 (S.L.doors_bremse)
	{endif}

	(L.L.throttle) 0.06 >
	(L.L.cp_brakevalve_licht) 1 = &&
	(L.L.elec_busbar_main) &&
	{if}
		(T.L.ev_brake_valve_rel)
		0 (S.L.cp_brakevalve_licht)
	{endif}

'	Haltewunschlampe:

	(L.L.haltewunsch)
	(L.L.doors_are_open) 0 = &&
	(L.L.elec_busbar_main) &&
	{if}
		1 (S.L.haltewunschlampe)
	{else}
		0 (S.L.haltewunschlampe) (S.L.haltewunsch)
	{endif}

'	Bing:

	(L.L.haltewunsch) (L.L.prev_haltewunsch) ! && (L.L.elec_busbar_main) (C.L.elec_busbar_minV) > &&
	{if}
		(T.L.ev_stop_request)
	{endif}		

	(L.L.haltewunsch) (S.L.prev_haltewunsch)



'	"Dauerfeuer"-Haltewunsch �ber Kinderwagenschalter (macht genau dasselbe wie der "trigger:int_haltewunsch"):
	(L.L.door_handsteuerung) (L.L.door_haltewunsch_knopfdruck) ||
	{if}
		1 (S.L.haltewunsch)
	{endif}

'	Setzen der Haltestellenbremse erst bei Stillstand des Busses:
	(L.L.bremse_halte_sw) (L.L.door_20h_sw) ||
	(L.L.bremse_halte) ! (L.L.Velocity) (C.L.Door_Bremse_Halte_MaxKMH) < && &&
	{if}
		(L.L.elec_busbar_main)
		{if}
			(T.L.ev_haltebremse_an)		
			1 (S.L.bremse_halte)
		{endif}
	{endif}

'	T�rfreigabekriterium

	(L.L.bremse_halte_sw) (L.L.bremse_halte) && (S.L.door_freigabe)

'	Abfall des Kinderwagenwunsch-Relais bei fehlender Stromversorgung:

	(L.L.elec_busbar_main) 0 = 
	{if}
		0 (S.L.door_kinderwagenwunsch)
	{endif}

'	Beleuchtung der Einstiege

	(L.L.cp_elecidle)
	{if}
		(L.L.cockpit_has_emergency_pressure)
		(L.L.elec_busbar_main) &&
		{if}
			(L.L.cockpit_has_emergency_pressure_timer_doors) (L.S.Timegap) + (S.L.cockpit_has_emergency_pressure_timer_doors) 0.5 >
			{if}
				(L.L.cp_tuer0_licht) ! (L.L.cp_tuer1_licht)
				{if}
					0 (S.L.cp_tuer0_licht) (S.L.cp_tuer1_licht)
				{else}
					(L.L.cp_tuer0_licht) ! (S.L.cp_tuer0_licht)
					(L.L.cp_tuer1_licht) ! (S.L.cp_tuer1_licht)
				{endif}
				0 (S.L.cockpit_has_emergency_pressure_timer_doors)
			{endif}
		{else}
			(L.L.door_0) 0.01 > (S.L.cp_tuer0_licht)
			(L.L.door_1) 0.01 > (S.L.cp_tuer1_licht)
		{endif}
	{else}
		0 (S.L.cp_tuer0_licht) (S.L.cp_tuer1_licht)
		0 (S.L.doors_beep_front_running) (S.L.doors_beep_rear_running)
		0 (S.L.haltewunschlampe)
	{endif}


'	Druckabh�ngige T�rgeschwindigkeit
	
	(C.L.door_druckluft)
	{if}
		(L.L.doorMaxSpeed_0_norm) (L.L.bremse_p_Tank04) 100000 - 850000 / (S.L.doorMaxSpeed_0)
		(L.L.doorMaxSpeed_01_norm) (L.L.bremse_p_Tank04) 100000 - 850000 / (S.L.doorMaxSpeed_01)
		(L.L.doorMaxSpeed_1_norm) (L.L.bremse_p_Tank04) 100000 - 850000 / (S.L.doorMaxSpeed_1)
		(L.L.doorMaxSpeed_2_norm) (L.L.bremse_p_Tank04) 100000 - 850000 / (S.L.doorMaxSpeed_2)
		(L.L.doorMaxSpeed_3_norm) (L.L.bremse_p_Tank04) 100000 - 850000 / (S.L.doorMaxSpeed_3)
	{endif}
'----------------------
'	AI-Ablauf:

(L.L.AI_Scheduled_AtStation) s0
1 =
{if}
'Wenn T�ren ge�ffnet werden sollen:
	(L.L.Velocity) (C.L.Door_Bremse_Halte_MaxKMH) <
	{if}
'Nur, wenn v < maxkmh, sonst warten
'Taster jeweils nur bet�tigen, falls noch nicht an
		(L.L.bremse_halte_sw) !
		{if}
			(M.L.trg_bus_dooraft)
		{endif}
		(L.L.doorTarget_0) ! (L.L.door_AI_timer) 0.3 > &&
		{if}
			(M.L.trg_bus_doorfront0)
		{endif}
		(L.L.doorTarget_1) ! (L.L.door_AI_timer) 0.6 > &&
		{if}
			(M.L.trg_bus_doorfront1)
		{endif}
	{else}
		0 (S.L.door_AI_timer)
	{endif}
	(L.L.door_AI_timer) (L.S.Timegap) + (S.L.door_AI_timer)
{else}
l0 -1 =
{if}
'Wenn T�ren geschlossen werden sollen:
'Taster jeweils nur bet�tigen, falls noch nicht aus:
	(L.L.doorTarget_1)
	{if}
		(M.L.trg_bus_doorfront1)
		0 (S.L.door_AI_timer)
	{endif}
	(L.L.doorTarget_0) (L.L.door_AI_timer) 0.3 > &&
	{if}
		(M.L.trg_bus_doorfront0)
	{endif}
'Haltestellenbremse erst wegnehmen, wenn alle T�ren zu. Dann auch erst den Bus AI-m��ig freigeben:
	(L.L.door_0) 0.1 <
	(L.L.door_1) 0.1 < &&
	{if}
		(L.L.bremse_halte_sw) (L.L.door_AI_timer) 0.3 > &&
		{if}
			(M.L.trg_bus_dooraft)
		{endif}
		(L.L.bremse_halte_sw) !
		{if}
			0 (S.L.AI_Scheduled_AtStation)
		{endif}
	{else}
'Sollte eine der T�ren auf sein und die Haltestellenbremse aus, dann sofort diese einlegen
		(L.L.bremse_halte_sw) !
		{if}
			(M.L.trg_bus_dooraft)
		{endif}
		(L.L.doorTarget_0) !
		(L.L.doorTarget_1) ! &&
		{if}
			0 (S.L.door_AI_timer)
		{endif}
	{endif}
	(L.L.door_AI_timer) (L.S.Timegap) + (S.L.door_AI_timer)
{endif}
{endif}


{end}




{macro:Door0_Calc}


' 800MN Mono Front
	(C.L.door_front_type) 0 =
	{if}
		(L.L.doorTarget_0) (L.L.door0_pos_z) 1 < &&
		{if}
			(L.L.door0_pos_z) (C.L.door0_pos_z_speed) 5 / (L.S.Timegap) * + 1 min (S.L.door0_pos_z)
		{else}
			(C.L.electric_doors)
			{if}
				(L.L.doorTarget_0)
				{if}
					(L.L.door_0) (F.L.door_fsingle_opn_speed) (S.L.doorMaxSpeed_0)
				{else}
					(L.L.door_0) (F.L.door_fsingle_cls_speed) (S.L.doorMaxSpeed_0)
				{endif}

				(C.L.fdoor_acc) (S.L.doorAcc_0)

				(L.L.doorTarget_0) ! (L.L.doorSpeed_0) s0 abs 0.05 > (L.L.door_0) 0 > || && 
				{if}
					l0 /-/ (L.L.doorMaxSpeed_0) <
					{if}
						(L.L.doorSpeed_0) (L.L.doorAcc_0) (L.S.Timegap) * - (S.L.doorSpeed_0)
					{else}
