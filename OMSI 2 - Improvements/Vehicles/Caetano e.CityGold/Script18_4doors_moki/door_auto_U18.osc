{trigger:door_all}
	1 (S.L.door_all)  (S.L.doorsy0_awaryjne) (S.L.doorsy1_awaryjne)  (S.L.doorsy2_awaryjne) (S.L.doorsy3_awaryjne) (S.L.doorsy4_awaryjne)
	(T.L.ev_VDV_toggle_on)
{end}

{trigger:door_all_off}
	0 (S.L.door_all)  (S.L.doorsy0_awaryjne) (S.L.doorsy1_awaryjne)  (S.L.doorsy2_awaryjne) (S.L.doorsy3_awaryjne) (S.L.doorsy4_awaryjne)
	0 (S.L.door_all_lock)
	(T.L.ev_VDV_toggle_off)
{end}

{trigger:CG_active}
	(L.L.CG_active) ! (S.L.CG_active)
	(L.L.CG_active) !
	{if}
	(T.L.ev_VDV_on)
	{else}
	(T.L.ev_VDV_off)
	{endif}
{end}

{trigger:bus_doorfront0}
	(L.L.Door_Error_Count) 1 + (S.L.Door_Error_Count)
		(L.L.tuersperre) 0 =
		{if}
		(M.L.trg_bus_doorfront0)
		(M.L.trg_bus_doorfront1)
		{endif}
		
		(L.L.tuersperre) 0 > 
		{if}
		(M.L.trg_bus_doorfront0)
		{endif}
		
		(L.L.tuersperre) 0 <
		{if}
		(M.L.trg_bus_doorfront1)
		{endif}
	1 (S.L.cockpit_tuertaster1)
	(T.L.ev_tuertaster_ein)
{end}

{trigger:bus_doorfront0_off}
	0 (S.L.cockpit_tuertaster1) (S.L.doorsy0) (S.L.doorsy1) (S.L.doorsy0_awaryjne) (S.L.doorsy1_awaryjne)
	(T.L.ev_tuertaster_aus)
{end}

{trigger:bus_doorfront0_external}
	1 (S.L.exter_hold)
{end}

{trigger:bus_doorfront0_external_off}
	0 (S.L.exter_hold) (S.L.lights_sw_warnblinker)
{end}

{trigger:bus_doorfront1}
	1 (S.L.doorsy2)  (S.L.doorsy2_awaryjne)
	1 (S.L.cockpit_tuertaster2)
	(T.L.ev_tuertaster_ein)
{end}

{trigger:bus_doorfront1_off}
	0 (S.L.cockpit_tuertaster2)
	(S.L.doorsy2)  (S.L.doorsy2_awaryjne)
	(T.L.ev_tuertaster_aus)
{end}

{trigger:bus_doorfront2}
	1 (S.L.doorsy3)	(S.L.doorsy3_awaryjne)
	1 (S.L.cockpit_tuertaster3)
	(T.L.ev_tuertaster_ein)
{end}

{trigger:bus_doorfront2_off}
	0 (S.L.cockpit_tuertaster3)
	(S.L.doorsy3) (S.L.doorsy3_awaryjne)
	(T.L.ev_tuertaster_aus)
{end}

{trigger:bus_doorfront3}
	1 (S.L.doorsy4) (S.L.doorsy4_awaryjne)
	1 (S.L.cockpit_tuertaster4)
	(T.L.ev_tuertaster_ein)
{end}

{trigger:bus_doorfront3_off}
	0 (S.L.cockpit_tuertaster4)
	(S.L.doorsy4) (S.L.doorsy4_awaryjne)
	(T.L.ev_tuertaster_aus)
{end}


{trigger:bus_dooraft}
  	(L.L.bremse_halte_sw) ! (S.L.bremse_halte_sw)
   
	(L.L.bremse_halte_sw)
	{if}
		(T.L.ev_haltebremse_sw_an)
	{else}
		(T.L.ev_haltebremse_sw_aus)
	{endif}	
{end}

{trigger:bus_20h-switch}
	(L.L.door_20h_sw) ! (S.L.door_20h_sw)

	(L.L.door_20h_sw)
	{if}
		(T.L.ev_haltebremse_sw_an)
	{else}
		(T.L.ev_haltebremse_sw_aus)
	{endif}
{end}

{trigger:cp_tuersperre}	
	(L.L.tuersperre_sw) 1 + (S.L.tuersperre_sw)
	(L.L.tuersperre_sw) 1 >
	{if}
		-1 (S.L.tuersperre_sw)
	{endif}
	
	(L.L.tuersperre_sw) -1 =
	(L.L.doorTarget_1) 1 = &&
	(L.L.doorTarget_0) 0 = &&
	{if}
		1 (S.L.doorsy0)
	{endif}
	
	(L.L.tuersperre_sw) 0 =
	(L.L.doorTarget_1) 0 = &&
	(L.L.doorTarget_0) 1 = &&
	{if}
		1 (S.L.doorsy1)
	{endif}

	(T.L.ev_kippschalter_aus)
{end}

{trigger:int_haltewunsch}
	1 (S.L.haltewunsch)
{end}

{trigger:door_haltewunsch}
	1 (S.L.haltewunsch) (S.L.door_haltewunsch_knopfdruck)
{end}

{trigger:door_haltewunsch_off}
	0 (S.L.door_haltewunsch_knopfdruck)
{end}

{trigger:cp_schalter_kinderwagen}
	(L.L.door_handsteuerung) ! (S.L.door_handsteuerung)
	{if}
		0 (S.L.door_kinderwagenwunsch) (S.L.zufall_kinderwagenwunsch)
		(T.L.ev_kippschalter_ein)
	{else}
		(T.L.ev_kippschalter_aus)
	{endif}
		
{end}

{trigger:cp_schalter_kinderwagen2}
	(L.L.door_handsteuerung2) ! (S.L.door_handsteuerung2)
	{if}
		0 (S.L.door_kinderwagenwunsch) (S.L.zufall_kinderwagenwunsch)
		(T.L.ev_kippschalter_ein)
	{else}
		(T.L.ev_kippschalter_aus)
	{endif}
		
{end}

{trigger:door_kinderwagenwunsch}
	1 (S.L.door_kinderwagenwunsch)
{end}

{trigger:alarm_drzwi}
1 (S.L.alarm_drzwi_sw)
(L.L.elec_busbar_main)
{if}
(S.L.alarm_drzwi)
{endif}
(M.L.kippschaltersound)
{end}

{trigger:alarm_drzwi_off}
0 (S.L.alarm_drzwi_sw) (S.L.alarm_drzwi)
(M.L.kippschaltersound)
{end}


{macro:Door_Init}


	10 random 5 / 1 - (C.L.door_acc_var) * (C.L.fdoor_acc) + (S.L.doorAcc_0)
	10 random 5 / 1 - (C.L.door_acc_var) * (C.L.bdoor_acc) + (S.L.doorAcc_1)
	10 random 5 / 1 - (C.L.door_acc_var) * (C.L.mdoor_acc) + (S.L.doorAcc_2)
	10 random 5 / 1 - (C.L.door_acc_var) * (C.L.bdoor_acc) + (S.L.doorAcc_3)	
	10 random 5 / 1 - (C.L.door_acc_var) * (C.L.bdoor_acc) + (S.L.doorAcc_4)
	10 random 5 / 1 - (C.L.door_acc_var) * (C.L.fdoor_acc) + (S.L.doorAcc_5)
	10 random 5 / 1 - (C.L.door_acc_var) * (C.L.mdoor_acc) + (S.L.doorAcc_6)
	10 random 5 / 1 - (C.L.door_acc_var) * (C.L.bdoor_acc) + (S.L.doorAcc_7)

	10 random 5 / 1 - (C.L.door_maxspeed_var) * (C.L.fdoor_maxspeed) + (S.L.doorMaxSpeed_0_norm)
	10 random 5 / 1 - (C.L.door_maxspeed_var) * (C.L.bdoor_maxspeed) + (S.L.doorMaxSpeed_1_norm)
	10 random 5 / 1 - (C.L.door_maxspeed_var) * (C.L.mdoor_maxspeed) + (S.L.doorMaxSpeed_2_norm)
	10 random 5 / 1 - (C.L.door_maxspeed_var) * (C.L.bdoor_maxspeed) + (S.L.doorMaxSpeed_3_norm)	
	10 random 5 / 1 - (C.L.door_maxspeed_var) * (C.L.bdoor_maxspeed) + (S.L.doorMaxSpeed_4_norm)
	10 random 5 / 1 - (C.L.door_maxspeed_var) * (C.L.fdoor_maxspeed) + (S.L.doorMaxSpeed_5_norm)
	10 random 5 / 1 - (C.L.door_maxspeed_var) * (C.L.mdoor_maxspeed) + (S.L.doorMaxSpeed_6_norm)
	10 random 5 / 1 - (C.L.door_maxspeed_var) * (C.L.bdoor_maxspeed) + (S.L.doorMaxSpeed_7_norm)
	
	(C.L.door_refl) (S.L.doorRefl_0)
	(C.L.door_refl) (S.L.doorRefl_1)
	(C.L.door_refl) (S.L.doorRefl_2)
	(C.L.door_refl) (S.L.doorRefl_3)
	(C.L.door_refl) (S.L.doorRefl_4)
	(C.L.door_refl) (S.L.doorRefl_5)
	(C.L.door_refl) (S.L.doorRefl_6)
	(C.L.door_refl) (S.L.doorRefl_7)

	
	(S.L.tuerverzoegerung_var) (S.L.doortimer0) (S.L.doortimer1) (S.L.doortimer23) (S.L.doortimer45) (S.L.doortimer67)
	0 (S.L.tuersperre_sw)
	0 (S.L.tuersperre)
{end}

