{macro:trg_bus_doorfront0}

  (L.L.doorfront_emergency) !
  {if}
    (L.L.doorTarget_0) ! (S.L.doorTarget_0)
    {if}
      (T.L.ev_doortriggeropen_0)
    {else}
      (T.L.ev_doortriggerclose_0)
    {endif}
    (C.L.door_druckluft)
    {if}
      (L.L.bremse_p_Tank04) 100000 - 0.96 * 100000 + (S.L.bremse_p_Tank04)
    {endif}
  {endif}

{end}

