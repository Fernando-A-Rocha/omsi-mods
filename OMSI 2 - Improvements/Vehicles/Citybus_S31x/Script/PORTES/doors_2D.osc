{macro:DoorLockAtDeparture_Calc}
  (L.L.Velocity) 3 >
  {if}
    (L.L.door_opening_locked) 0 =
    {if}
      (T.L.ev_door_lock)
      1 (S.L.door_opening_locked)
    {endif}
  {endif}


  (L.L.Velocity) 3 <
  {if}
    (L.L.door_opening_locked) 1 =
    {if}
      (T.L.ev_door_unlock)
      0 (S.L.door_opening_locked)
    {endif}
  {endif}
{end}

{macro:traegheit}

'Simuliert träges Verhalten (exponentiell)

'Ladekonventionen:
' Sollwert    l0
' Istwert     l1
' Konstante Anlauf  l2 (Einheiten/s)
' Konstante Ablauf  l3 (Einheiten/s)

'Anlauf oder Auslauf?
  l0 l1 >
  {if}
    l2 (L.S.Timegap) * 1 min -1 max s4
  {else}
    l3 (L.S.Timegap) * 1 min -1 max s4
  {endif}


'Sollwert:
  l0
'Istwert:
  l1
'Beschleunigung:
  - l4 *
'Addition zum Istwert:
  l1 + s1
{end}