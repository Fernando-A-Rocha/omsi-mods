'- Rüdiger Hülsmann	19.12.2009	Timer für Ausstiegstür jetzt Timegap-basiert, Bugfix: Tür schließt jetzt nur bei elec_busbar=1
'- RÜdiger Hülsmann	22.09.2010	Door light trigger value set to 0.1
'- RÜdiger Hülsmann	07.11.2010	Door speed based on reservoir pressure, air-operated doors made an option
'- Marcel Kuhnt		08.11.2010	AI procedure closing doors debugged
'- Rüdiger Hülsmann	21.11.2010	Front doors only operable when busbar on
'- Rüdiger Hülsmann	23.12.2010	External front door operation included, option: doors only operable with actual stop brake
'- Rüdiger Hülsmann	31.12.2010	Electric door function debugged
'- Rüdiger Hülsmann	05.01.2011	20h-switch
'- Rüdiger Hülsmann	07.01.2011	Backdoor manual switch sound debugged, 20h switch depending on bus type
'- Rüdiger Hülsmann	19.01.2011	Electric door support
'- Markus Rabe		25.02.2011	D92 Schließverhalten der Hintertür und Einstiegsbeleuchtung ans Vorbild angepasst
'- Markus Rabe		27.02.2011	linker Flügel Vordertür: Abfangeinrichtung eingebaut
'- Marcel Kuhnt		29.06.2011	Integration in Standard-Doorscript
'- Marcel Kuhnt		07.07.2011	Druckluftsimulation inkl. Dämpfer
'- Marcel Kuhnt		09.07.2011	Manuelles Öffnen/Schließen
'- Marcel Kuhnt		10.07.2011	Manuelles Öffnen/Schließen optimiert
'- Marcel Kuhnt		10.07.2011	Mit westdeutscher Türsteuerung versehen und für O305 erweitert
'- Marcel Kuhnt		10.09.2011	Entriegelte Türen => Leuchtende Türlichter
'- Marcel Kuhnt		10.09.2011	Unterschiedliche Dämpfereinstellungen je Türflügel möglich

'--------------------------------------------------------------------------------

{trigger:handrampe_drag}

(L.L.door_2) 0.9 > (L.L.door_3) 0.9 > &&
{if}
(L.L.door_handrampe) 
	{if}
		0 (S.L.door_handrampe)	
		(T.L.ev_handrampe)		
	{else}		
		1 (S.L.door_handrampe)	
		0 (S.L.rampenwunsch) 
		(T.L.ev_handrampe)
	{endif} 
{endif} 
{end}


{trigger:bus_doorfront0}
	(L.L.door_0) 0.05 < 
	{if}	
		(L.L.cp_schluessel_trans) (L.L.engine_injection_on) ||
		(L.L.cp_lockdoors_targeton) ! && 
		(L.L.bremse_p_Tank04) 500000 > &&
			{if}				
				(M.L.trg_bus_doorfront0)
				(C.L.door_ManBackDoorFrontDoorCombined)
					{if}
						(M.L.trg_bus_doorfront1)						
					{endif}
			{endif}
		1 (S.L.cockpit_tuertaster1)
		0 (S.L.cockpit_tuertaster1close)
		
	{endif}
	
	(L.L.door_0) 0.95 > 
	{if}
		(L.L.cp_schluessel_trans) (L.L.engine_injection_on) ||  (L.L.door_memory0) ||
			{if}
			(M.L.trg_bus_doorfront0close)
			(C.L.door_ManBackDoorFrontDoorCombined)
				{if}
					(M.L.trg_bus_doorfront1)
					(L.L.kneeling) 1 =
					(L.L.door_2) 1 < &&
					{if}
					2 (S.L.kneeling)					
					{endif}  
				{endif}
				0 (S.L.door_memory0)
			{endif}
	0 (S.L.cockpit_tuertaster1)
	1 (S.L.cockpit_tuertaster1close)
	{endif}
	
{end}



{trigger:bus_doorfront0_off}
	0 (S.L.cockpit_tuertaster1)
	0 (S.L.cockpit_tuertaster1close)
{end}



{trigger:bus_doorfront0_external}

	
		(M.L.trg_bus_doorfront0)
		(C.L.door_ManBackDoorFrontDoorCombined)
		{if}
			(M.L.trg_bus_doorfront1)
		{endif}
	{endif}

{end}

{trigger:bus_doorfront1}
	(L.L.door_2) 0.05 <
		{if}
			(L.L.cp_schluessel_trans) (L.L.engine_injection_on) ||
			(L.L.rampe_main) 0 = &&
			(L.L.bremse_p_Tank04) 500000 > &&
	 
				{if}
					(C.L.door_ManBackDoorFrontDoorCombined)
						{if}
						(M.L.trg_bus_dooraft23)
						{else}
						(M.L.trg_bus_doorfront1)
						
						{endif}
				{endif}
		1 (S.L.cockpit_tuertaster2)
		0 (S.L.cockpit_tuertaster2close)
	
		{endif}

	(L.L.door_2) 0.95 >
		{if}
			(L.L.cp_schluessel_trans) (L.L.engine_injection_on) || (L.L.door_memory2) ||
	 
				{if}
					
					(C.L.door_ManBackDoorFrontDoorCombined)
						{if}
						(M.L.trg_bus_dooraft23)
						(L.L.globaltimer) (S.L.door_time)
						(L.L.kneeling) 1 =
						(L.L.door_0) 1 < &&
						{if}
						2 (S.L.kneeling)					
						{endif} 
							
						{else}
						(M.L.trg_bus_doorfront1)
											
						{endif}
						0 (S.L.door_memory2)
				{endif}
		0 (S.L.cockpit_tuertaster2)
		1 (S.L.cockpit_tuertaster2close)
		{endif}
	
{end}


{trigger:bus_doorfront1_off}
	0 (S.L.cockpit_tuertaster2)
	0 (S.L.cockpit_tuertaster2close)
{end}

{trigger:bus_doorfront1close_off}
	0 (S.L.cockpit_tuertaster2close)
{end}

{trigger:bus_doorfront1_lock}
'Doorfront1-Verriegelung: Funktioniert nur, wenn der Türflügel auch zu ist:
	(L.L.door_1) 0.05 <
	(L.L.door_0) 0.05 < &&
	{if}
		(L.L.door_1_locked) ! (S.L.door_1_locked)
		{if}
			(T.L.ev_doorlock1_on)
		{else}
			(T.L.ev_doorlock1_off)
		{endif}
	{endif}
{end}

{trigger:bus_dooraft}
	(M.L.trg_bus_dooraft)
{end}


{trigger:int_haltewunsch}
	1 (S.L.haltewunsch)
{end}

{trigger:door_haltewunsch}
	1 (S.L.haltewunsch) (S.L.door_haltewunsch_knopfdruck)
{end}

{trigger:door_haltewunsch_off}
	0 (S.L.door_haltewunsch_knopfdruck)
{end}

{trigger:door_rampenwunsch}
	1 (S.L.rampenwunsch) 
{end}

{trigger:cp_schalter_kinderwagen}
	(L.L.door_handsteuerung) ! (S.L.door_handsteuerung)
	{if}
		0 (S.L.door_kinderwagenwunsch)
		(T.L.ev_kippschalter_ein)
	{else}
		(T.L.ev_kippschalter_aus)
	{endif}
		
{end}

{trigger:door_kinderwagenwunsch}
	(L.L.door_handsteuerung) !
	{if}
		1 (S.L.door_kinderwagenwunsch)
	{endif}
{end}



'Trigger Dachluken

{trigger:hatch1lock}

(L.L.hatch1_trans) ! 
(L.L.hatch1_slant) ! &&
(L.L.hatch1_slant2) ! &&
{if}

(L.L.hatch1_mode) 1 =
(L.L.hatch1_prevmode) 0.5 = &&
{if}
1 (S.L.hatch1_prevmode)
0.5 (S.L.hatch1_mode)
1 (S.L.hatch1_stop)
{endif}

(L.L.hatch1_mode) 0.5 =
(L.L.hatch1_prevmode) 0 = &&
{if}
1 (S.L.hatch1_mode)
0.5 (S.L.hatch1_prevmode)
0 (S.L.hatch1_stop)
{endif}

(L.L.hatch1_mode) 0 =
{if}
0.5 (S.L.hatch1_mode)
0 (S.L.hatch1_prevmode)
0 (S.L.hatch1_stop)
{endif}

(L.L.hatch1_mode) 0.5 =
(L.L.hatch1_prevmode) 1 = &&
(L.L.hatch1_stop) ! &&
{if}
0.5 (S.L.hatch1_prevmode)
0 (S.L.hatch1_mode)
{else}
0 (S.L.hatch1_stop)
{endif}
{endif}
{end}

{trigger:hatch1handle}
(L.L.hatch1_mode) 0 =
(L.L.hatch1_trans) 0 = &&

{if}
1 (S.L.hatch1_trans)
{else}
0 (S.L.hatch1_trans)
{endif}

(L.L.hatch1_mode) 0.5 =
(L.L.hatch1_trans) 0 = &&
(L.L.hatch1_slant) 0 = &&
(L.L.hatch1_slant2) 0 = &&
{if}
-1 (S.L.hatch1_slant)
{else}
0 (S.L.hatch1_slant)
{endif}

(L.L.hatch1_mode) 1 =
(L.L.hatch1_trans) 0 = &&
(L.L.hatch1_slant) 0 = &&
(L.L.hatch1_slant2) 0 = &&
{if}
1 (S.L.hatch1_slant2)
{else}
0 (S.L.hatch1_slant2)
{endif}

{end}

{trigger:hatch2lock}

(L.L.hatch2_trans) ! 
(L.L.hatch2_slant) ! &&
(L.L.hatch2_slant2) ! &&
{if}

(L.L.hatch2_mode) 1 =
(L.L.hatch2_prevmode) 0.5 = &&
{if}
1 (S.L.hatch2_prevmode)
0.5 (S.L.hatch2_mode)
1 (S.L.hatch2_stop)
{endif}

(L.L.hatch2_mode) 0.5 =
(L.L.hatch2_prevmode) 0 = &&
{if}
1 (S.L.hatch2_mode)
0.5 (S.L.hatch2_prevmode)
0 (S.L.hatch2_stop)
{endif}

(L.L.hatch2_mode) 0 =
{if}
0.5 (S.L.hatch2_mode)
0 (S.L.hatch2_prevmode)
0 (S.L.hatch2_stop)
{endif}

(L.L.hatch2_mode) 0.5 =
(L.L.hatch2_prevmode) 1 = &&
(L.L.hatch2_stop) ! &&
{if}
0.5 (S.L.hatch2_prevmode)
0 (S.L.hatch2_mode)
{else}
0 (S.L.hatch2_stop)
{endif}
{endif}
{end}

{trigger:hatch2handle}
(L.L.hatch2_mode) 0 =
(L.L.hatch2_trans) 0 = &&

{if}
1 (S.L.hatch2_trans)
{else}
0 (S.L.hatch2_trans)
{endif}

(L.L.hatch2_mode) 0.5 =
(L.L.hatch2_trans) 0 = &&
(L.L.hatch2_slant) 0 = &&
(L.L.hatch2_slant2) 0 = &&
{if}
-1 (S.L.hatch2_slant)
{else}
0 (S.L.hatch2_slant)
{endif}

(L.L.hatch2_mode) 1 =
(L.L.hatch2_trans) 0 = &&
(L.L.hatch2_slant) 0 = &&
(L.L.hatch2_slant2) 0 = &&
{if}
1 (S.L.hatch2_slant2)
{else}
0 (S.L.hatch2_slant2)
{endif}

{end}


{macro:Door_Init}
	1000 random 500 / 1 - (C.L.door_acc_var) * (C.L.fdoor_acc) + (S.L.doorAcc_0)
	1000 random 500 / 1 - (C.L.door_acc_var) * (C.L.fdoor_acc) + (S.L.doorAcc_1)
	1000 random 500 / 1 - (C.L.door_acc_var) * (C.L.bdoor_acc) + (S.L.doorAcc_2)
	1000 random 500 / 1 - (C.L.door_acc_var) * (C.L.bdoor_acc) + (S.L.doorAcc_3)

	1000 random 500 / 1 - (C.L.door_maxspeed_var) * (C.L.fdoor_maxspeed) + (S.L.doorMaxSpeed_0_norm)
	1000 random 500 / 1 - (C.L.door_maxspeed_var) * (C.L.fdoor_maxspeed) + (S.L.doorMaxSpeed_1_norm)
	1000 random 500 / 1 - (C.L.door_maxspeed_var) * (C.L.bdoor_maxspeed) + (S.L.doorMaxSpeed_2_norm)
	1000 random 500 / 1 - (C.L.door_maxspeed_var) * (C.L.bdoor_maxspeed) + (S.L.doorMaxSpeed_3_norm)

'Beim Dämpfer wird der Wert bis auf 40% reduziert statt eine Varianz verwendet:
	900 random 1000 / 0.1 + (C.L.door0_damper) * (S.L.doorDamper_0_kennwert)
	900 random 1000 / 0.1 + (C.L.door1_damper) * (S.L.doorDamper_1_kennwert)
	900 random 1000 / 0.1 + (C.L.door2_damper) * (S.L.doorDamper_2_kennwert)
	900 random 1000 / 0.1 + (C.L.door3_damper) * (S.L.doorDamper_3_kennwert)

	(C.L.door_refl) (S.L.doorRefl_0)
	(C.L.door_refl) (S.L.doorRefl_1)
	(C.L.door_refl) (S.L.doorRefl_2)
	(C.L.door_refl) (S.L.doorRefl_3)

	0 (S.L.door0_warten)
	0 (S.L.door0_umkehr)	

	0 (S.L.door0_physblock)
	1 (S.L.door1_physblock)

	0 (S.L.door_pressure_open_0)
	1 (S.L.door_pressure_close_0)
{end}

{macro:Door_Frame}

'Elektrische Rampe (C) 2012 Darius Bode''''''''''''''''''''''''''
'rampe_direction: 0 eingefahren, 1 beim Ausfahren, 2 ausgefahren, 3 beim Einfahren

				(L.L.cp_rampe_targetoff) (L.L.rampe_main) && (L.L.rampe_direction) 2 = &&
					{if}
						0 (S.L.rampe_main)			
						(L.L.globaltimer) (S.L.rampe_starttime)					
					{endif}	
	
	(L.L.cp_schluessel_trans) 1 =
	(L.L.engine_injection_on) && 
	(L.L.Velocity) (C.L.doors_maxvspeed) < &&
	(L.L.door_3) 0 = &&
	(L.L.door_2) 0 = &&
	(L.L.rampe_direction) 0 = (L.L.rampe_direction) 1 = || &&
	
			
			{if}	

				(L.L.cp_rampe_targeton) (L.L.rampe_main) 0 = && (L.L.rampe_direction) 0 = &&
					{if}
						1 (S.L.rampe_main)			
						(L.L.globaltimer) (S.L.rampe_starttime)
					{endif}		
	
			
			
			(L.L.rampe_main) 1 =
			{if}
					
			0 (S.L.rampenwunsch)
			(L.L.rampe_direction) 0 =
				
				{if}
				(T.L.rampe_raus)
				1 (S.L.rampe_aktiv)
				{endif}
			
			1 (S.L.rampe_direction)	(S.L.rampe_doorstatus)			
			(L.L.cp_notloese_anfahrsperre) ! {if} 1 (S.L.bremse_anfahrsperre) {endif}
			 
			(L.L.globaltimer) (L.L.rampe_starttime) - (S.L.rampe_counter)
			
			(L.L.globaltimer) (L.L.rampe_starttime) 4.5 + >
				{if}
				1 (S.L.rampe_flap1)
				{endif}
				
			(L.L.globaltimer) (L.L.rampe_starttime) 6.0 + >
				{if}					
					1 (S.L.rampe_horz)					
				{endif}
				

			(L.L.globaltimer) (L.L.rampe_starttime) 9.5 + >
				{if}
					(L.L.kneeling) 0 =
										{if}
					20 (S.L.rampe_angle)
					{endif}		
					(L.L.kneeling) 1 =
					{if}
					11 (S.L.rampe_angle)
					{endif}						
				{endif}
			
			(L.L.door_2) 0 =
			(L.L.rampe_doorstatus) 1 = &&
			(L.L.globaltimer) (L.L.rampe_starttime) 17.5 + > &&
			{if}
			(M.L.trg_bus_dooraft23)
			0 (S.L.rampe_doorstatus)
			2 (S.L.rampe_direction)
			{endif}			
			
			{endif}
{endif}

' Einfahren

(L.L.rampe_main) 0 =
(L.L.rampe_direction) 2 = &&
(L.L.rampe_direction) 3 = ||
(L.L.cp_schluessel_trans) 1 = &&
(L.L.engine_injection_on) && 

{if}			
			(L.L.rampe_direction) 2 =
				
				{if}				
				3 (S.L.rampe_direction)				
				(L.L.cp_notloese_anfahrsperre) ! {if} 1 (S.L.bremse_anfahrsperre) {endif}
				(L.L.door_2) 1 =
				{if}
				(M.L.trg_bus_dooraft23)
				{endif}
				(T.L.rampe_rein)
				{endif}
			
			
			(L.L.globaltimer) (L.L.rampe_starttime) - (S.L.rampe_counter)

					
			(L.L.globaltimer) (L.L.rampe_starttime) 15 + >
				{if}
				0 (S.L.rampe_flap1)
				{endif}
				
			(L.L.globaltimer) (L.L.rampe_starttime) 4.5 + >
				{if}
				0 (S.L.rampe_horz)
				{endif}
				
			(L.L.globaltimer) (L.L.rampe_starttime) 5.5 + >
				{if}
				0 (S.L.rampe_angle)
				{endif}		
		
			{endif}					
			
{endif}

			
'Blinklichter
			(L.L.engine_injection_on) (L.L.cp_schluessel_trans) 1 = ||
			(L.L.rampe_aktiv) &&
			{if}
			(L.S.Timegap) (L.L.rampe_blinkercount) + (S.L.rampe_blinkercount) 
			
			(L.L.rampe_blinkercount2) 0.7 <
				{if}					
					(L.S.Timegap) (L.L.rampe_blinkercount2) + (S.L.rampe_blinkercount2) 										
				{else}
					0 (S.L.rampe_blinkercount2) 	
					(L.L.rampe_blinker) ! (S.L.rampe_blinker)				
				{endif}
			{endif}
		
			
'Endabschaltung

(L.L.globaltimer) (L.L.rampe_starttime) 17 + > 
(L.L.rampe_angle) 0 = &&
(L.L.rampe_aktiv) 1 = &&
			{if}			
			0 (S.L.rampe_direction)
			0 (S.L.bremse_anfahrsperre)
			0 (S.L.rampe_aktiv)
			0 (S.L.rampe_blinker)
			{endif}
	
(L.L.rampe_aktiv) 
(L.L.cp_schluessel_trans) (L.L.engine_injection_on) || && (L.L.mediramp) &&
	{if}	
	1 (S.L.rampe_aktiv_licht)	
	{else}
	0 (S.L.rampe_aktiv_licht)
	{endif}
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''			
			
	(M.L.Door0_Calc)
	(M.L.Door1_Calc)
	(M.L.DoorAftCalc)
	(M.L.Door2_Calc)
	(M.L.Door3_Calc)

	0
	(S.L.doorDragAcc_0)
	(S.L.doorDragAcc_1)
	(S.L.doorDragAcc_2)
	(S.L.doorDragAcc_3)

	(L.L.door_0) 0.8 > (S.L.PAX_Entry0_Open) 
	(L.L.door_1) 0.8 > (S.L.PAX_Entry1_Open) 	
	(L.L.door_2) 0.8 > (L.L.door_3) 0.8 > && (S.L.PAX_Entry2_Open) (S.L.PAX_Exit0_Open) 
	

'	"Dauerfeuer"-Haltewunsch über Kinderwagenschalter (macht genau dasselbe wie der "trigger:int_haltewunsch"):
	(L.L.door_handsteuerung) (L.L.door_haltewunsch_knopfdruck) ||
	{if}
		1 (S.L.haltewunsch)
	{endif}
	
'	Rampenwunsch
	(L.L.rampenwunsch) (L.L.rampe_aktiv) ! && 
	(L.L.cp_schluessel_trans) (L.L.engine_injection_on) || &&
	
	{if}
	1 (S.L.rampenwunschlampe)
	{else}
	0 (S.L.rampenwunschlampe)
	{endif}
	
	(L.L.rampenwunsch) !	
	{if}
	0 (S.L.rampenwunschlampe)
	{endif}


' 	Anfahrsperre Hintertuer	
' Door position and release do not engage or hold the stop brake.

		
	(L.L.rampe_main) !
	(L.L.rampe_aktiv) ! &&
	(L.L.kneeling) ! &&
	(L.L.bremse_anfahrsperre) &&	
		{if}		
			0 (S.L.bremse_anfahrsperre)		
		{endif}
	
	

		

'	Anhand dieser Bedingungen kann nun die Automatiktür geöffnet werden:
	(C.L.door_ManBackDoorFrontDoorCombined) !
	{if}
		(M.L.DoorAft_Open)
	{endif}

'	Haltewunschlampe:
'	Für HH so gesteuert, dass sie auch durch eine offene Vordertür ausgeht:
	(L.L.haltewunsch) (L.L.door_2) 0.2 < (L.L.door_0) 0.2 < && (L.L.cp_schluessel_trans) (L.L.engine_injection_on) || && &&
	{if}
		1 (S.L.haltewunschlampe)
	{else}
		0 (S.L.haltewunschlampe) (S.L.haltewunsch)
	{endif}

'	Bing:

	(L.L.haltewunsch) (L.L.prev_haltewunsch) ! && (L.L.cp_schluessel_trans) (L.L.engine_injection_on) || &&
	{if}
		(T.L.ev_stop)
	{endif}		

	(L.L.haltewunsch) (S.L.prev_haltewunsch)

'	Abfall des Kinderwagenwunsch-Relais bei fehlender Stromversorgung:

	(L.L.elec_busbar_main) !
	(L.L.engine_injection_on) ! &&
	{if}
		0 (S.L.door_kinderwagenwunsch)
		0 (S.L.haltewunsch)
