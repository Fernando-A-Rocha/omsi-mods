'Trigger for default keyboard input (minus on numpad) to switch on off stopbrake
{macro:trg_bus_dooraft}

(L.L.cp_stopbrake_targeton) 0 = 
	
	{if}
	(M.L.wippschaltereinsound)
	
		(L.L.bremse_halte) !
		(L.L.Velocity) (C.L.doors_maxvspeed) < &&
					
	(L.L.cp_stopbrake_targeton) ! (S.L.cp_stopbrake_targeton)
	1 (S.L.cp_stopbrake_targeton) 
	1 (S.L.bremse_halte_sw)
	
	{else}	
	(M.L.wippschalteraussound)			
	(L.L.cp_stopbrake_targetoff) 
	0 (S.L.cp_stopbrake_targeton) 	
	0 (S.L.bremse_halte_sw)
	{endif}	

{end}

