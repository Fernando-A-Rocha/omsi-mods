		(L.L.PAX_Exit2_Req) (L.L.door_4_wunsch) (L.L.door_kinderwagen2) || || (L.L.door_6) 0.1 > &&
			{if}
				0.01 (S.L.door67LastOpen)
			{endif}	
				
		(L.L.door67LastOpen) (C.L.door67OpenTime) 1.3 / > (L.L.door_freigabe) ! && (L.L.door_67_forceclose) ||
		(L.L.PAX_Entry4_Req) (L.L.PAX_Exit2_Req) || &&
			{if}
				1 (S.L.tuer4_piep)
			{endif}	
			
		(L.L.door_67_forceclose) (L.L.tuer4_piep) && (L.L.door_6) 0 > &&
			{if}
				1 (S.L.tuer_4_piepforced)
			{endif}
		
		(L.L.door_67_forceclose) ! (L.L.door_6) 0 = &&
			{if}
				0 (S.L.tuer_4_piepforced)
			{endif}		

		(L.L.doorTarget_67)
		(L.L.door67LastOpen) (C.L.door67OpenTime) > (L.L.door_kinderwagen2) ! && (L.L.door_4_wunsch) ! && (L.L.PAX_Exit2_Req) ! && (L.L.PAX_Entry4_Req) ! && (L.L.door_67_forceclose) || && 
		{if}			
			(T.L.ev_doortriggerclose_6)
			0 (S.L.doorTarget_67) (S.L.door_67_forceclose) (S.L.door_kinderwagen2) (S.L.door67LastOpen)
			(C.L.door_druckluft)
			{if}
				(L.L.doorEntriegelung_doorActive_67) -1 =
				{if}
					0 (S.L.doorEntriegelung_doorActive_67)
				{endif}
'				(L.L.bremse_p_Tank04) 100000 - 0.94 * 100000 + (S.L.bremse_p_Tank04)
			{endif}
		{endif}
	{endif}

'	TUER 5 *******************************************************************************
	(L.L.elec_busbar_main_sw) (L.L.door_89_forceclose) ||
	{if}
		(L.L.door89LastOpen) 0 > (L.L.door_freigabe) ||
		(L.L.door_5_wunsch) ! && (L.L.door_kinderwagen2) ! &&
		(L.L.door_8) 0.1 > &&
			{if}
				(L.L.door89LastOpen) (L.S.Timegap) + (S.L.door89LastOpen)
			{endif}
			
		(L.L.PAX_Exit3_Req) (L.L.door_5_wunsch) (L.L.door_kinderwagen2) || || (L.L.door_8) 0.1 > &&
			{if}
				0.01 (S.L.door89LastOpen)
			{endif}	
				
		(L.L.door89LastOpen) (C.L.door89OpenTime) 1.3 / > (L.L.door_freigabe) ! && (L.L.door_89_forceclose) ||
		(L.L.PAX_Entry5_Req) (L.L.PAX_Exit3_Req) || &&
			{if}
				1 (S.L.tuer5_piep)
			{endif}	
			
		(L.L.door_89_forceclose) (L.L.tuer5_piep) && (L.L.door_8) 0 > &&
			{if}
				1 (S.L.tuer_5_piepforced)
			{endif}
		
		(L.L.door_89_forceclose) ! (L.L.door_8) 0 = &&
			{if}
				0 (S.L.tuer_5_piepforced)
			{endif}		

		(L.L.doorTarget_89)
		(L.L.door89LastOpen) (C.L.door89OpenTime) > (L.L.door_kinderwagen2) ! && (L.L.door_5_wunsch) ! && (L.L.PAX_Exit3_Req) ! && (L.L.PAX_Entry5_Req) ! && (L.L.door_89_forceclose) || && 
		{if}			
			(T.L.ev_doortriggerclose_8)
			0 (S.L.doorTarget_89) (S.L.door_89_forceclose) (S.L.door_kinderwagen2) (S.L.door89LastOpen)
			(C.L.door_druckluft)
			{if}
				(L.L.doorEntriegelung_doorActive_89) -1 =
				{if}
					0 (S.L.doorEntriegelung_doorActive_89)
				{endif}
'				(L.L.bremse_p_Tank04) 100000 - 0.94 * 100000 + (S.L.bremse_p_Tank04)
			{endif}
		{endif}
	{endif}
{end}

