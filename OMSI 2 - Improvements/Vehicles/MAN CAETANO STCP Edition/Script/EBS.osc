'EBS/ECAS Script
'##########################################

'__/\\\\\\\\\\\\\\\__/\\\\\\\\\\\\\_______/\\\\\\\\\\\_______________________/\\\__________________/\\\\\\\\\\\\\\\________/\\\\\\\\\_____/\\\\\\\\\________/\\\\\\\\\\\___        
' _\/\\\///////////__\/\\\/////////\\\___/\\\/////////\\\__________________/\\\//\\\_______________\/\\\///////////______/\\\////////____/\\\\\\\\\\\\\____/\\\/////////\\\_       
'  _\/\\\_____________\/\\\_______\/\\\__\//\\\______\///__________________/\\\_/\\\________________\/\\\_______________/\\\/____________/\\\/////////\\\__\//\\\______\///__      
'   _\/\\\\\\\\\\\_____\/\\\\\\\\\\\\\\____\////\\\________________________\//\\\\//_________________\/\\\\\\\\\\\______/\\\_____________\/\\\_______\/\\\___\////\\\_________     
'    _\/\\\///////______\/\\\/////////\\\______\////\\\____________________/\\\///\\\_________________\/\\\///////______\/\\\_____________\/\\\\\\\\\\\\\\\______\////\\\______    
'     _\/\\\_____________\/\\\_______\/\\\_________\////\\\_______________/\\\/__\///\\\/\\\___________\/\\\_____________\//\\\____________\/\\\/////////\\\_________\////\\\___   
'      _\/\\\_____________\/\\\_______\/\\\__/\\\______\//\\\_____________/\\\______\//\\\//____________\/\\\______________\///\\\__________\/\\\_______\/\\\__/\\\______\//\\\__  
'       _\/\\\\\\\\\\\\\\\_\/\\\\\\\\\\\\\/__\///\\\\\\\\\\\/_____________\//\\\\\\\\\\\//\\\____________\/\\\\\\\\\\\\\\\____\////\\\\\\\\\_\/\\\_______\/\\\_\///\\\\\\\\\\\/___ 
'        _\///////////////__\/////////////______\///////////________________\///////////_\///_____________\///////////////________\/////////__\///________\///____\///////////_____

'##########################################

'Controls Brakes and includes air system (compressor)
'(c) 2025 - Sobol3D

'Script Version: 4.0

'Needs:
'- Engine (for compressor)

'Revision History:
'- Sobol3D - ate whopper

'--------------------------------------------------------------

'----------------------
'	Trigger
'----------------------

{trigger:parking_brake_toggle}

	(L.L.cp_eswitch_parbr) !
	{if}
		(L.L.bremse_feststell) ! (S.L.bremse_feststell) (S.L.bremse_feststell_sw)
		{if}
			(T.L.ev_bremse_feststell_ein)
		{else}
			(T.L.ev_bremse_feststell_aus)
		{endif}
	{else}
		(L.L.bremse_feststell_sw) ! (S.L.bremse_feststell_sw)
	{endif}

{end}


{trigger:parking_brake_set}
	
	(L.L.bremse_feststell) !
	(L.L.cp_eswitch_parbr) ! &&
	{if}
		(S.L.bremse_feststell)
		(T.L.ev_bremse_feststell_ein)

		1 (S.L.bremse_feststell_sw)
	{endif}

{end}

{trigger:parking_brake_release}

	(L.L.bremse_feststell)
	(L.L.cp_eswitch_parbr) ! &&
	{if}
		! (S.L.bremse_feststell)
		(T.L.ev_bremse_feststell_aus)

		0 (S.L.bremse_feststell_sw)
	{endif}

{end}

{trigger:parking_brake_mouse_drag}

	(L.S.mouse_y) 200 / (L.L.bremse_feststell_sw) + (S.L.bremse_feststell_sw) s0
	l0 0 <
	{if}
		0 (S.L.bremse_feststell_sw)
	{endif}
	l0 1 >
	{if}
		1 (S.L.bremse_feststell_sw)
	{endif}

	(L.L.cp_eswitch_parbr) !
	{if}
		l0 0.6 > (L.L.bremse_feststell) 0 = &&
		{if}
			1 (S.L.bremse_feststell)
			(T.L.ev_bremse_feststell_ein)
		{endif}
		l0 0.4 < (L.L.bremse_feststell) 1 = &&
		{if}
			0 (S.L.bremse_feststell)
			(T.L.ev_bremse_feststell_aus)
		{endif}
	{endif}

	1 (S.L.bremse_feststell_klinke)
{end}

{trigger:parking_brake_mouse_off}
	0 (S.L.bremse_feststell_klinke)
{end}

{trigger:wagenkasten_anheben}
	1 (S.L.anheben_sw)
	(T.L.ev_VDV_toggle_on)

	(L.L.anheben_sw)
	(L.L.elec_busbar_main) &&
	(L.L.ECAS_p_Tank) 550000 > &&
	(L.L.wagenkasten_anheben) 0.5 < &&
	(L.L.Fail_ECAS_true) 1 = ! &&
	{if}
		(T.L.ECAS_anheben_start)
	{else}
		(L.L.wagenkasten_anheben) 0.5 <
		(L.L.Fail_ECAS_true) 1 = ! &&
		{if}
			(T.L.ECAS_anheben_end)
		{endif}
	{endif}
{end}

{trigger:wagenkasten_anheben_off}
	0 (S.L.anheben_sw)
	(T.L.ev_VDV_toggle_off)

	(L.L.anheben_sw)
	(L.L.elec_busbar_main) &&
	(L.L.ECAS_p_Tank) 550000 > &&
	(L.L.wagenkasten_anheben) 0.5 = ||
	(L.L.Fail_ECAS_true) 1 = ! &&
	{if}
		(T.L.ECAS_anheben_end)
	{endif}
{end}

'----------------------
'	Init
'----------------------


{macro:bremse_init}

	1 (S.L.bremse_feststell_sw) (S.L.bremse_feststell)

'Setzen der Luftfederbalgdr�cke

	500000 random 320000 + (S.L.pneum_main_supply_line) 
	500000 random 320000 + (S.L.pneum_1_supply_line) (S.L.ECAS_p_Tank)
	500000 random 320000 + (S.L.pneum_2_supply_line) (S.L.ECAS_p_Tank_I)
	500000 random 320000 + (S.L.pneum_3_supply_line) (S.L.ECAS_p_balgline_0R)
	500000 random 320000 + (S.L.pneum_4_supply_line) (S.L.ECAS_p_balgline_0L)
	500000 random 320000 + (S.L.bremse_p_Tank01) (S.L.bremse_p_Balg_1_R)
	500000 random 320000 + (S.L.bremse_p_Tank02) (S.L.ECAS_p_balgline_1R)
	500000 random 320000 + (S.L.bremse_p_Tank03)
	500000 random 320000 + (S.L.bremse_p_Tank04)

'Leak rates

    40 random 10 + (S.L.pneum_main_supply_line_leak) 
    40 random 1 + (S.L.pneum_1_supply_line_leak)
    40 random 1 + (S.L.pneum_2_supply_line_leak)
    40 random 1 + (S.L.pneum_3_supply_line_leak)
    40 random 1 + (S.L.pneum_4_supply_line_leak)
    1600 random 500 + (S.L.bremse_p_Tank01_leak)
    1600 random 500 + (S.L.bremse_p_Tank02_leak)
    1600 random 500 + (S.L.bremse_p_Tank03_leak)
    1600 random 500 + (S.L.bremse_p_Tank04_leak)
    2700 random 1000 + (S.L.balg_0_R_leak)
    2700 random 2500 + (S.L.balg_0_L_leak)
    2700 random 1000 + (S.L.balg_1_R_leak)
    2700 random 2500 + (S.L.balg_1_L_leak)
    2700 random 1000 + (S.L.balg_2_R_leak)
    2700 random 2500 + (S.L.balg_2_L_leak)
    2700 random 1000 + (S.L.balg_3_R_leak)
    2700 random 2500 + (S.L.balg_3_L_leak)

'Setzen der Bremszylinderdr�cke	
	100000 (S.L.bremse_p_luft) (S.L.bremse_p_brzyl_A1_L) (S.L.bremse_p_brzyl_A1_R) (S.L.bremse_p_brzyl_A2_L) (S.L.bremse_p_brzyl_A2_R) (S.L.bremse_p_brzyl_A3_L) (S.L.bremse_p_brzyl_A3_R) (S.L.bremse_p_brzyl_A4_L) (S.L.bremse_p_brzyl_A4_R) 
	100000 (S.L.Axle_Brakeforce_0_L) (S.L.Axle_Brakeforce_0_R) (S.L.Axle_Brakeforce_1_L) (S.L.Axle_Brakeforce_1_R) (S.L.Axle_Brakeforce_2_L) (S.L.Axle_Brakeforce_2_R) (S.L.Axle_Brakeforce_3_L) (S.L.Axle_Brakeforce_3_R)
	130000 (S.L.ECAS_zieldruck_0_R) (S.L.ECAS_zieldruck_0_L) (S.L.ECAS_zieldruck_1_R) (S.L.ECAS_zieldruck_1_L) (S.L.ECAS_zieldruck_2_R) (S.L.ECAS_zieldruck_2_L) (S.L.ECAS_zieldruck_3_R) (S.L.ECAS_zieldruck_3_L)
	100000 (S.L.bremse_p_Balg_0_R) (S.L.bremse_p_Balg_0_L) (S.L.bremse_p_Balg_1_R) (S.L.bremse_p_Balg_1_L) (S.L.bremse_p_Balg_2_R) (S.L.bremse_p_Balg_2_L) (S.L.bremse_p_Balg_3_R) (S.L.bremse_p_Balg_3_L)
	100000 (S.L.ECAS_p_balgline_0R) (S.L.ECAS_p_balgline_0L) (S.L.bremse_p_Balg_1_R) (S.L.ECAS_p_balgline_1R) (S.L.ECAS_p_balgline_1L) (S.L.ECAS_p_supply_line_I) (S.L.ECAS_p_Tank_I) (S.L.ECAS_p_Tank)

{end}

'----------------------
'	Frame
'----------------------

{macro:bremse_frame}

'    (M.L.jamniczeq_xD)

'	sensors

    (L.L.bremse_p_tank01) (S.L.bremse_p_tank01_sensor)
    (L.L.bremse_p_tank02) (S.L.bremse_p_tank02_sensor)
    (L.L.bremse_p_tank03) (S.L.bremse_p_tank03_sensor)
    (L.L.bremse_p_tank04) (S.L.bremse_p_tank04_sensor)

'	Turning kompressor on/off

	(L.L.pneum_main_supply_line) 910000 >
    (L.L.bremse_kompressor) 1 = &&
    (L.L.pneum_ECAS_supply_valve) ! &&
	{if}
		4 random (S.L.ev_kompressor_var)
		(T.L.ev_kompressor_aus)
		0 (S.L.bremse_kompressor)
	{endif}

    (L.L.pneum_main_supply_line) 760000 < 
	(L.L.engine_n) 300 > &&
	(L.L.bremse_kompressor) 0 = &&
	{if}
		(T.L.ev_kompressor_ein)
		1 (S.L.bremse_kompressor)
	{endif}

	(M.L.bremse_kompressor)

'	(M.L.bremse_druckluftsound)

'	8,1 bar overflow valve

    (L.L.pneum_4sv_valve_kreis_1) !
    (L.L.pneum_4sv_valve_kreis_2) ! &&
    (L.L.pneum_4sv_valve_kreis_3) ! &&
    (L.L.pneum_4sv_valve_kreis_4) ! &&
    (L.L.pneum_4sv_supply_line) 900000 > ||
	{if}
        0 (S.L.pneum_4sv_supply_valve)
    {else}
        (L.L.pneum_4sv_supply_line) 870000 <
        {if}
            1 (S.L.pneum_4sv_supply_valve)
        {endif}
	{endif}

'	Supply line between cutoff valve and 4-way valve

	(L.L.pneum_4sv_supply_valve)
    (L.L.pneum_main_supply_line) (L.L.pneum_4sv_supply_line) > &&
	{if}
        (L.L.pneum_main_supply_line) s1
		(L.L.pneum_4sv_supply_line) s2
		(C.L.pneum_V_main_supply_line) s3
		(C.L.pneum_V_4sv_supply_line) s4
		0.000037 (L.L.pneum_main_supply_line) (F.L.valve_damping) * s5

		(M.L.bremse_druckausgleich_oneway)

		l1 (S.L.pneum_main_supply_line) 
		l2 (S.L.pneum_4sv_supply_line) 
	{endif}

'	Supply line -> switch valve 7,5 bar -> ECAS Tank I

    (L.L.pneum_4sv_supply_line) 750000 >
    (L.L.ECAS_p_Tank) 720000 < &&
	{if}
        1 (S.L.pneum_ECAS_supply_valve)
    {else}
        (L.L.ECAS_p_Tank) 850000 >
        (L.L.pneum_4sv_supply_line) 700000 < ||
        {if}
            0 (S.L.pneum_ECAS_supply_valve)
        {endif}
	{endif}

	(L.L.pneum_ECAS_supply_valve)
    (L.L.pneum_main_supply_line) (L.L.ECAS_p_Tank_I) > &&
	{if}
        (L.L.pneum_main_supply_line) s1
		(L.L.ECAS_p_Tank_I) s2
		(C.L.pneum_V_main_supply_line) s3
		(C.L.bremse_V_tank_ECAS) s4
        0.00003 (L.L.pneum_main_supply_line) (F.L.valve_damping) * s5

		(M.L.bremse_druckausgleich_oneway)

		l1 (S.L.pneum_main_supply_line) 
		l2 (S.L.ECAS_p_Tank_I) 
	{endif}

'	ECAS Tank I -> Ecas line I

	(L.L.ECAS_p_Tank_I) (L.L.ECAS_p_supply_line_I) >
	{if}
        (L.L.ECAS_p_Tank_I) s1
		(L.L.ECAS_p_supply_line_I) s2
		(C.L.bremse_V_tank_ECAS) s3
		(C.L.pneum_V_4sv_supply_line2) s4
		0.000025 (L.L.pneum_main_supply_line) (F.L.valve_damping) * s5

		(M.L.bremse_druckausgleich_oneway)

		l1 (S.L.ECAS_p_Tank_I) 
		l2 (S.L.ECAS_p_supply_line_I) 
	{endif}

'	Ecas line I -> ECAS Tank II

	(L.L.ECAS_p_supply_line_I) (L.L.ECAS_p_Tank) >
	{if}
        (L.L.ECAS_p_supply_line_I) s1
		(L.L.ECAS_p_Tank) s2
		(C.L.pneum_V_4sv_supply_line2) s3
		(C.L.bremse_V_tank_ECAS) s4
		0.00002 (L.L.pneum_main_supply_line) (F.L.valve_damping) * s5

		(M.L.bremse_druckausgleich_oneway)

		l1 (S.L.ECAS_p_supply_line_I) 
		l2 (S.L.ECAS_p_Tank) 
	{endif}

'	ECAS Tank II -> switch valve 5,5 bar -> 4x ECAS supply balgs

	(L.L.ECAS_p_Tank) 720000 >
	{if}
        1 (S.L.ECAS_p_supply_line_valve)
    {else}
        (L.L.ECAS_p_Tank) 670000 <
        {if}
            0 (S.L.ECAS_p_supply_line_valve)
        {endif}
	{endif}

    (L.L.ECAS_p_supply_line_valve)
    (L.L.ECAS_p_Tank) (L.L.ECAS_p_balgline_0R) > &&
	{if}
        (L.L.ECAS_p_Tank) s1
		(L.L.ECAS_p_balgline_0R) s2
		(C.L.bremse_V_tank_ECAS) s3
		(C.L.pneum_V_4sv_supply_line3) s4
		0.000005 s5

		(M.L.bremse_druckausgleich_oneway)

		l1 (S.L.ECAS_p_Tank) 
		l2 (S.L.ECAS_p_balgline_0R) 
	{endif}

    (L.L.ECAS_p_supply_line_valve)
    (L.L.ECAS_p_Tank) (L.L.ECAS_p_balgline_0L) > &&
	{if}
        (L.L.ECAS_p_Tank) s1
		(L.L.ECAS_p_balgline_0L) s2
		(C.L.bremse_V_tank_ECAS) s3
		(C.L.pneum_V_4sv_supply_line3) s4
		0.000005 s5

		(M.L.bremse_druckausgleich_oneway)

		l1 (S.L.ECAS_p_Tank) 
		l2 (S.L.ECAS_p_balgline_0L) 
	{endif}

    (L.L.ECAS_p_supply_line_valve)
    (L.L.ECAS_p_Tank) (L.L.ECAS_p_balgline_1R) > &&
	{if}
        (L.L.ECAS_p_Tank) s1
		(L.L.ECAS_p_balgline_1R) s2
		(C.L.bremse_V_tank_ECAS) s3
		(C.L.pneum_V_4sv_supply_line3) s4
		0.000005 s5

		(M.L.bremse_druckausgleich_oneway)

		l1 (S.L.ECAS_p_Tank) 
		l2 (S.L.ECAS_p_balgline_1R) 
	{endif}

    (L.L.ECAS_p_supply_line_valve)
    (L.L.ECAS_p_Tank) (L.L.ECAS_p_balgline_1L) > &&
	{if}
        (L.L.ECAS_p_Tank) s1
		(L.L.ECAS_p_balgline_1L) s2
		(C.L.bremse_V_tank_ECAS) s3
		(C.L.pneum_V_4sv_supply_line3) s4
		0.000005 s5

		(M.L.bremse_druckausgleich_oneway)

		l1 (S.L.ECAS_p_Tank) 
		l2 (S.L.ECAS_p_balgline_1L) 
	{endif}

'	Supply to 3rd axle ECAS balgs

'   Case I - Solo 3-axle -> supplied from ECAS tanks

    (C.L.axle_count) 3 >=
    (C.L.axle_drivetrain) 2 = &&
    {if}

        (L.L.ECAS_p_supply_line_valve)
        (L.L.ECAS_p_Tank) (L.L.ECAS_p_balgline_2L) > &&
        {if}
            (L.L.ECAS_p_Tank) s1
            (L.L.ECAS_p_balgline_2L) s2
            (C.L.bremse_V_tank_ECAS) s3
            (C.L.pneum_V_4sv_supply_line3) s4
            0.000005 s5

            (M.L.bremse_druckausgleich_oneway)

            l1 (S.L.ECAS_p_Tank) 
            l2 (S.L.ECAS_p_balgline_2L) 
        {endif}

        (L.L.ECAS_p_balgline_2R) 700000 <
        (L.L.ECAS_p_supply_line_valve) &&
        (L.L.ECAS_p_Tank) (L.L.ECAS_p_balgline_2R) > &&
        {if}
            (L.L.ECAS_p_Tank) s1
            (L.L.ECAS_p_balgline_2R) s2
            (C.L.bremse_V_tank_ECAS) s3
            (C.L.pneum_V_4sv_supply_line3) s4
            0.000005 s5

            (M.L.bremse_druckausgleich_oneway)

            l1 (S.L.ECAS_p_Tank) 
            l2 (S.L.ECAS_p_balgline_2R) 
        {endif}

    {endif}

'   Case II - Gelenk 3-axle -> supplied from IV brake circuit

    (C.L.axle_count) 3 >=
    (C.L.axle_drivetrain) 3 = (C.L.axle_drivetrain) 23 = || &&
    {if}

        (L.L.ECAS_p_supply_line_valve)
        (L.L.bremse_p_Tank04) (L.L.ECAS_p_balgline_2L) > &&
        {if}
            (L.L.bremse_p_Tank04) s1
            (L.L.ECAS_p_balgline_2L) s2
            (C.L.bremse_V_tank04) s3
            (C.L.pneum_V_4sv_supply_line3) s4
            0.000005 s5

            (M.L.bremse_druckausgleich_oneway)

            l1 (S.L.bremse_p_Tank04) 
            l2 (S.L.ECAS_p_balgline_2L) 
        {endif}

        (L.L.ECAS_p_supply_line_valve)
        (L.L.bremse_p_Tank04) (L.L.ECAS_p_balgline_2R) > &&
        {if}
            (L.L.bremse_p_Tank04) s1
            (L.L.ECAS_p_balgline_2R) s2
            (C.L.bremse_V_tank04) s3
            (C.L.pneum_V_4sv_supply_line3) s4
            0.000005 s5

            (M.L.bremse_druckausgleich_oneway)

            l1 (S.L.bremse_p_Tank04) 
            l2 (S.L.ECAS_p_balgline_2R) 
        {endif}

    {endif}

    (C.L.axle_count) 4 >=
    {if}

        (L.L.ECAS_p_supply_line_valve)
        (L.L.bremse_p_Tank04) (L.L.ECAS_p_balgline_3L) > &&
        {if}
            (L.L.bremse_p_Tank04) s1
            (L.L.ECAS_p_balgline_3L) s2
            (C.L.bremse_V_tank04) s3
            (C.L.pneum_V_4sv_supply_line3) s4
            0.000005 s5

            (M.L.bremse_druckausgleich_oneway)

            l1 (S.L.bremse_p_Tank04) 
            l2 (S.L.ECAS_p_balgline_3L) 
        {endif}

        (L.L.ECAS_p_supply_line_valve)
        (L.L.bremse_p_Tank04) (L.L.ECAS_p_balgline_3R) > &&
        {if}
            (L.L.bremse_p_Tank04) s1
            (L.L.ECAS_p_balgline_3R) s2
            (C.L.bremse_V_tank04) s3
            (C.L.pneum_V_4sv_supply_line3) s4
            0.000005 s5

            (M.L.bremse_druckausgleich_oneway)

            l1 (S.L.bremse_p_Tank04) 
            l2 (S.L.ECAS_p_balgline_3R) 
        {endif}

    {endif}

'	Vierkreisschutzventil (4-way valve) + tanks

	(L.L.pneum_1_supply_line) (C.L.pneum_kreis_open) <
	{if}
        1 (S.L.pneum_4sv_valve_kreis_1)
	{else}
        (L.L.pneum_1_supply_line) (C.L.pneum_kreis_close) >
        {if}
            0 (S.L.pneum_4sv_valve_kreis_1)
        {endif}
	{endif}

    (L.L.pneum_2_supply_line) (C.L.pneum_kreis_open) <
    {if}
        1 (S.L.pneum_4sv_valve_kreis_2)
    {else}
