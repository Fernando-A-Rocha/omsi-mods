            4 (S.L.ECAS_1_R_adjust_t)
        {else}
            (L.L.ECAS_1_R_adjust)
            {if}
                (L.L.ECAS_1_R_adjust_t) (L.S.Timegap) + 4 min (S.L.ECAS_1_R_adjust_t)
                4 >=
                {if}
                    (L.L.bremse_p_balg_1_R) (L.L.ECAS_1_R_curr_level) (F.L.ECAS_reg_offset) + trunc 100000 max 950000 min (S.L.ECAS_zieldruck_1_R)
                    1 (S.L.ECAS_valve_allowed_1_R)
                {endif}
            {else}
                0 (S.L.ECAS_valve_allowed_1_R) (S.L.ECAS_1_R_adjust_t)
            {endif}
        {endif}

' BALG - 1 - L

        (L.L.ECAS_1_L_adjust)
        {if}
            (L.L.ECAS_1_L_adjust_t) (L.S.Timegap) + 4 min (S.L.ECAS_1_L_adjust_t)
            4 >=
            {if}
                (L.L.bremse_p_balg_1_L) (L.L.ECAS_1_L_curr_level) (F.L.ECAS_reg_offset) + trunc 100000 max 950000 min (S.L.ECAS_zieldruck_1_L)
                1 (S.L.ECAS_valve_allowed_1_L)
            {endif}
        {else}
            0 (S.L.ECAS_valve_allowed_1_L) (S.L.ECAS_1_L_adjust_t)
        {endif}

' BALG - 2 - R

        (C.L.axle_count) 3 >= 
        {if}
            (L.L.ECAS_kneel_allowed) 1 >=
            {if}
                (L.L.ECAS_2_R_curr_level) 5 >
                {if}
                    (L.L.bremse_p_balg_2_R) (L.L.ECAS_2_R_curr_level) (F.L.ECAS_reg_kneel_offset) - trunc 100000 max (S.L.ECAS_zieldruck_2_R)
                    1 (S.L.ECAS_valve_allowed_2_R)
                {else}
                    0 (S.L.ECAS_valve_allowed_2_R)
                {endif}
                
                4 (S.L.ECAS_2_R_adjust_t)
            {else}
                (L.L.ECAS_2_R_adjust)
                {if}
                    (L.L.ECAS_2_R_adjust_t) (L.S.Timegap) + 4 min (S.L.ECAS_2_R_adjust_t)
                    4 >=
                    {if}
                        (L.L.bremse_p_balg_2_R) (L.L.ECAS_2_R_curr_level) (F.L.ECAS_reg_offset) + trunc 100000 max 950000 min (S.L.ECAS_zieldruck_2_R)
                        1 (S.L.ECAS_valve_allowed_2_R)
                    {endif}
                {else}
                    0 (S.L.ECAS_valve_allowed_2_R) (S.L.ECAS_2_R_adjust_t)
                {endif}
            {endif}

' BALG - 2 - L

            (L.L.ECAS_2_L_adjust)
            {if}
                (L.L.ECAS_2_L_adjust_t) (L.S.Timegap) + 4 min (S.L.ECAS_2_L_adjust_t)
                4 >=
                {if}
                    (L.L.bremse_p_balg_2_L) (L.L.ECAS_2_L_curr_level) (F.L.ECAS_reg_offset) + trunc 100000 max 950000 min (S.L.ECAS_zieldruck_2_L)
                    1 (S.L.ECAS_valve_allowed_2_L)
                {endif}
            {else}
                0 (S.L.ECAS_valve_allowed_2_L) (S.L.ECAS_2_L_adjust_t)
            {endif}

        {endif}

' BALG - 3 - R

        (C.L.axle_count) 4 >= 
        {if}

            (L.L.ECAS_kneel_allowed) 1 >=
            {if}
                (L.L.ECAS_3_R_curr_level) 5 >
                {if}
                    (L.L.bremse_p_balg_3_R) (L.L.ECAS_3_R_curr_level) (F.L.ECAS_reg_kneel_offset) - trunc 100000 max (S.L.ECAS_zieldruck_3_R)
                    1 (S.L.ECAS_valve_allowed_3_R)
                {else}
                    0 (S.L.ECAS_valve_allowed_3_R)
                {endif}
                
                4 (S.L.ECAS_3_R_adjust_t)
            {else}
                (L.L.ECAS_3_R_adjust)
                {if}
                    (L.L.ECAS_3_R_adjust_t) (L.S.Timegap) + 4 min (S.L.ECAS_3_R_adjust_t)
                    4 >=
                    {if}
                        (L.L.bremse_p_balg_3_R) (L.L.ECAS_3_R_curr_level) (F.L.ECAS_reg_offset) + trunc 100000 max 950000 min (S.L.ECAS_zieldruck_3_R)
                        1 (S.L.ECAS_valve_allowed_3_R)
                    {endif}
                {else}
                    0 (S.L.ECAS_valve_allowed_3_R) (S.L.ECAS_3_R_adjust_t)
                {endif}
            {endif}

' BALG - 3 - L

            (L.L.ECAS_3_L_adjust)
            {if}
                (L.L.ECAS_3_L_adjust_t) (L.S.Timegap) + 4 min (S.L.ECAS_3_L_adjust_t)
                4 >=
                {if}
                    (L.L.bremse_p_balg_3_L) (L.L.ECAS_3_L_curr_level) (F.L.ECAS_reg_offset) + trunc 100000 max 950000 min (S.L.ECAS_zieldruck_3_L)
                    1 (S.L.ECAS_valve_allowed_3_L)
                {endif}
            {else}
                0 (S.L.ECAS_valve_allowed_3_L) (S.L.ECAS_3_L_adjust_t)
            {endif}

        {endif}
    {else}
        0 (S.L.ECAS_valve_allowed_0_R) (S.L.ECAS_valve_allowed_0_L)
        0 (S.L.ECAS_0_R_adjust_t) (S.L.ECAS_0_L_adjust_t)
        0 (S.L.ECAS_valve_allowed_1_R) (S.L.ECAS_valve_allowed_1_L)
        0 (S.L.ECAS_1_R_adjust_t) (S.L.ECAS_1_L_adjust_t)
        0 (S.L.ECAS_valve_allowed_2_R) (S.L.ECAS_valve_allowed_2_L)
        0 (S.L.ECAS_2_R_adjust_t) (S.L.ECAS_2_L_adjust_t)
        0 (S.L.ECAS_valve_allowed_3_R) (S.L.ECAS_valve_allowed_3_L)
        0 (S.L.ECAS_3_R_adjust_t) (S.L.ECAS_3_L_adjust_t)
    {endif}

    (L.L.ECAS_kneel_allowed) (L.L.ECAS_kneel_allowed_last) =
    (L.L.cp_kneel_up_mode) ! &&
    (L.L.enable_auto_kneel_override) ! &&
    (L.L.vdv_display_startuptime) 5 < ||
    {if}
        0 (S.L.ECAS_kneel_immidiate_command)
    {endif}

    (L.L.cp_kneel_up_mode)
    {if}
        4 (S.L.ECAS_0_R_adjust_t) (S.L.ECAS_0_L_adjust_t)
        4 (S.L.ECAS_1_R_adjust_t) (S.L.ECAS_1_L_adjust_t)
        4 (S.L.ECAS_2_R_adjust_t) (S.L.ECAS_2_L_adjust_t)
        4 (S.L.ECAS_3_R_adjust_t) (S.L.ECAS_3_L_adjust_t)
    {endif}

    (L.L.anheben_sw)
    {if}
        1 (S.L.ECAS_valve_allowed_0_R) (S.L.ECAS_valve_allowed_0_L)
        4 (S.L.ECAS_0_R_adjust_t) (S.L.ECAS_0_L_adjust_t)
        1 (S.L.ECAS_valve_allowed_1_R) (S.L.ECAS_valve_allowed_1_L)
        4 (S.L.ECAS_1_R_adjust_t) (S.L.ECAS_1_L_adjust_t)
        1 (S.L.ECAS_valve_allowed_2_R) (S.L.ECAS_valve_allowed_2_L)
        4 (S.L.ECAS_2_R_adjust_t) (S.L.ECAS_2_L_adjust_t)
        1 (S.L.ECAS_valve_allowed_3_R) (S.L.ECAS_valve_allowed_3_L)
        4 (S.L.ECAS_3_R_adjust_t) (S.L.ECAS_3_L_adjust_t)
    {endif}

'   Final ECAS balg calculation

    (L.L.Velocity) abs (F.L.susp_lean_curve) s0

    (L.L.bremse_p_balg_0_R) 460000 / (L.L.A_Trans_X) 9.81 / + l0 max (S.L.Axle_Springfactor_0_R)
    (L.L.bremse_p_balg_0_L) 460000 / (L.L.A_Trans_X) 9.81 / - l0 max (S.L.Axle_Springfactor_0_L)
    (L.L.bremse_p_balg_1_R) 460000 / (L.L.A_Trans_X) 9.81 / + l0 max (S.L.Axle_Springfactor_1_R)
    (L.L.bremse_p_balg_1_L) 460000 / (L.L.A_Trans_X) 9.81 / - l0 max (S.L.Axle_Springfactor_1_L)

    (C.L.axle_count) 3 >= 
    {if}
        (L.L.bremse_p_balg_2_R) 460000 / (L.L.A_Trans_X) 9.81 / + l0 max (S.L.Axle_Springfactor_2_R)
        (L.L.bremse_p_balg_2_L) 460000 / (L.L.A_Trans_X) 9.81 / - l0 max (S.L.Axle_Springfactor_2_L)
    {endif}

    (C.L.axle_count) 4 >= 
    {if}
        (L.L.bremse_p_balg_3_R) 460000 / (L.L.A_Trans_X) 9.81 / + l0 max (S.L.Axle_Springfactor_3_R)
        (L.L.bremse_p_balg_3_L) 460000 / (L.L.A_Trans_X) 9.81 / - l0 max (S.L.Axle_Springfactor_3_L)
    {endif}

{end}

{macro:bremse_kompressor}

	(L.L.bremse_kompressor) 1 =
	{if}
		(L.L.engine_n) (L.S.Timegap) * 60 / (C.L.bremse_m_kompressor) (L.L.pneum_main_supply_line) (F.L.komp_damping) * *
		(C.L.RT_Luft) * (C.L.pneum_V_main_supply_line) / (L.L.pneum_main_supply_line) + (S.L.pneum_main_supply_line)
	{endif}

{end}

{macro:bremse_druckausgleich}
	
'	l1	Druck im Beh�lter 1
'	l2	Druck im Beh�lter 2
'	l3	Volumen Beh�lter 1
'	l4	Volumen Beh�lter 2
'	l5	Querschnittsfl�che Verbindungsleitung
'...
'	l6	tempor�re Variable, die die maximale Zeitkonstante enth�lt
                                                        
	l1 l2 + 2 / l1 l2 - s0 * (C.L.RT_Luft) / abs sqrt l0 sgn * l5 * (C.L.RT_Luft) * s0

	l1 l2 - 1 l3 / 1 l4 / + l0 * / s6

	(L.S.Timegap) l6 min   l0     * l4 / l2 + s2
	(L.S.Timegap) l6 min   l0 /-/ * l3 / l1 + s1
{end}

{macro:bremse_druckausgleich_oneway}
	
'	l1	Druck im Beh�lter 1
'	l2	Druck im Beh�lter 2
'	l3	Volumen Beh�lter 1
'	l4	Volumen Beh�lter 2
'	l5	Querschnittsfl�che Verbindungsleitung
'...
'	l6	tempor�re Variable, die die maximale Zeitkonstante enth�lt
                                                        
	l1 l2 + 2 / l1 l2 - s0 * (C.L.RT_Luft) / abs sqrt l0 * l5 * (C.L.RT_Luft) * s0

	l1 l2 - 1 l3 / 1 l4 / + l0 * / s6

	(L.S.Timegap) l6 min   l0     * l4 / l2 + s2
	(L.S.Timegap) l6 min   l0 /-/ * l3 / l1 + s1
{end}

{trigger:jamniczeq_rozpompuj_ecas}

	100000 (S.L.bremse_p_Balg_0_L) (S.L.bremse_p_Balg_0_R) (S.L.bremse_p_Balg_1_L) (S.L.bremse_p_Balg_1_R)
	100000 (S.L.ECAS_p_balgline_0L) (S.L.ECAS_p_balgline_0R) (S.L.ECAS_p_balgline_1L) (S.L.ECAS_p_balgline_1R)

{end}

{trigger:jamniczeq_rozpompuj_ecas}

	100000 (S.L.bremse_p_Balg_0_L) (S.L.bremse_p_Balg_0_R) (S.L.bremse_p_Balg_1_L) (S.L.bremse_p_Balg_1_R)
	100000 (S.L.ECAS_p_balgline_0L) (S.L.ECAS_p_balgline_0R) (S.L.ECAS_p_balgline_1L) (S.L.ECAS_p_balgline_1R)

{end}

{trigger:jamniczeq_rozpompuj_ecas2}

	100000 (S.L.ECAS_p_Tank) (S.L.ECAS_p_supply_line_I) (S.L.ECAS_p_Tank_I)

{end}

{trigger:jamniczeq_rozpompuj_ebs}

	100000 (S.L.bremse_p_Tank01) (S.L.bremse_p_Tank02) (S.L.bremse_p_Tank03) (S.L.bremse_p_Tank04)

{end}

{trigger:jamniczeq_rozpompuj_ebs2}

	100000 (S.L.pneum_1_supply_line) (S.L.pneum_3_supply_line) (S.L.pneum_4_supply_line)

{end}

