{trigger:door_all}

	(L.L.vis_dashboard_door_all_button) 1 =
	{if}
		(L.L.doorTarget_01) (L.L.doorTarget_0) || (L.L.doorTarget_23) || (L.L.doorTarget_45) ||
		{if}
			-1 (S.L.door_all) (S.L.door_all_sw)
            (M.L.door_all)
		{else}
			(L.L.door_open_supervisor)
			{if}
				1 (S.L.door_all) (S.L.door_all_sw)
                (M.L.door_all)
			{endif}
		{endif}
		(T.L.ev_VDV_toggle_on)
	{endif}

{end}

{trigger:door_all_off}
	
	(L.L.vis_dashboard_door_all_button) 1 =
	{if}
		0 (S.L.door_all) (S.L.door_all_lock)
		(T.L.ev_VDV_toggle_off)
	{endif}	

    0 (S.L.door_all_sw)

{end}

{trigger:door_all_up}

	(L.L.vis_dashboard_door_all_button) 1 =
	{if}
		(L.L.doorTarget_01) (L.L.doorTarget_0) || (L.L.doorTarget_23) || (L.L.doorTarget_45) ||
		{if}
			-1 (S.L.door_all)
            (M.L.door_all)
		{endif}
		(T.L.ev_VDV_toggle_on)
	{endif}

    -1 (S.L.door_all_sw)

{end}

{trigger:door_all_up_off}
	
	(L.L.vis_dashboard_door_all_button) 1 =
	{if}
		0 (S.L.door_all) (S.L.door_all_lock)
		(T.L.ev_VDV_toggle_off)
	{endif}	

    0 (S.L.door_all_sw)

{end}

{trigger:door_all_down}

	(L.L.vis_dashboard_door_all_button) 1 =
	{if}
        (L.L.door_open_supervisor)
        {if}
            1 (S.L.door_all)
            (M.L.door_all)
        {endif}
		(T.L.ev_VDV_toggle_on)
	{endif}

    1 (S.L.door_all_sw)

{end}

{trigger:door_all_down_off}
	
	(L.L.vis_dashboard_door_all_button) 1 =
	{if}
		0 (S.L.door_all) (S.L.door_all_lock)
		(T.L.ev_VDV_toggle_off)
	{endif}	

    0 (S.L.door_all_sw)
    
{end}

{trigger:CG_active}
	(L.L.vis_cg_type) 4 = !
	{if}
		(L.L.CG_active) ! (S.L.CG_active) (S.L.door_20h_sw)
		(L.L.CG_active)
		{if}
		(T.L.ev_VDV_off)
		1 (S.L.CG_active_last)
		15 random 10 / (S.L.CG_random_01)
		15 random 10 / (S.L.CG_random_23)
		15 random 10 / (S.L.CG_random_45)
		{else}
		(T.L.ev_VDV_on)
		{endif}
	{endif}
{end}

{trigger:bus_dooraft}
	(L.L.vis_cg_type) 4 = !
	{if}
		(L.L.CG_active) ! (S.L.CG_active) (S.L.door_20h_sw)
		(L.L.CG_active)
		{if}
		(T.L.ev_VDV_off)
		1 (S.L.CG_active_last)
		15 random 10 / (S.L.CG_random_01)
		15 random 10 / (S.L.CG_random_23)
		15 random 10 / (S.L.CG_random_45)
		{else}
		(T.L.ev_VDV_on)
		{endif}
	{endif}
{end}

{trigger:bus_20h-switch}

	(L.L.vis_dashboard_H_switch_type)
	{if}
		1 (S.L.bremse_halte_sw) 
		(T.L.ev_VDV_toggle_on)
	{else}
		(L.L.bremse_halte_sw) ! (S.L.bremse_halte_sw)
		(L.L.bremse_halte_sw)
		{if}
			(T.L.ev_haltebremse_sw_an)
		{else}
			(T.L.ev_haltebremse_sw_aus)
		{endif}
	{endif}
{end}

{trigger:bus_20h-switch_off}
	(L.L.vis_dashboard_H_switch_type)
	{if}
		0 (S.L.bremse_halte_sw) 
		(T.L.ev_VDV_toggle_off)
	{endif}
{end}

{trigger:cp_tuersperre_td_r}	

	(L.L.tuersperre_sw) 1.5 = !
	{if}
		(T.L.ev_VDV_on)
		1.5 (S.L.tuersperre_sw)
	{else}
		(T.L.ev_VDV_on)
		0.5 (S.L.tuersperre_sw)

		0 (S.L.tuersperre)
	{endif}	
	
{end}

{trigger:cp_tuersperre_td_l}	

	(L.L.tuersperre_sw) -0.5 = !
	{if}
		(T.L.ev_VDV_on)
		-0.5 (S.L.tuersperre_sw)
	{else}
		(T.L.ev_VDV_on)
		0.5 (S.L.tuersperre_sw)

		0 (S.L.tuersperre)
	{endif}	

{end}

{trigger:cp_tuersperre}	
	(L.L.vis_dashboard_tuersperre_switch_type) 0 =
	{if}
		(L.L.tuersperre_sw) 1 + (S.L.tuersperre_sw)
		(L.L.tuersperre_sw) 1.5 >
		{if}
			-0.5 (S.L.tuersperre_sw)
		{endif}
		(L.L.tuersperre_sw) 1.5 =
		(L.L.tuersperre_sw) 0.5 = ||
		{if}
			0 (S.L.tuersperre)
		{endif}
		(L.L.tuersperre_sw) -0.5 =
		{if}
			0 (S.L.tuersperre)
		{endif}
		(T.L.ev_kippschalter_aus)
	{endif}
{end}

{trigger:cp_tuersperre_L}
	(L.L.vis_dashboard_tuersperre_switch_type) 0 =
	{if}
		(L.L.tuersperre_sw) 1.5 =
		{if}
			0.5 (S.L.tuersperre_sw)
			(T.L.ev_kippschalter_aus)

			0 (S.L.tuersperre)
		{else}
			(L.L.tuersperre_sw) 0.5 =
			{if}
				-0.5 (S.L.tuersperre_sw)
				(T.L.ev_kippschalter_aus)
			{endif}
		{endif}
	{endif}
{end}

{trigger:cp_tuersperre_R}	
	(L.L.vis_dashboard_tuersperre_switch_type) 0 =
	{if}
		(L.L.tuersperre_sw) -0.5 =
		{if}
			0.5 (S.L.tuersperre_sw)
			(T.L.ev_kippschalter_aus)

			0 (S.L.tuersperre)
