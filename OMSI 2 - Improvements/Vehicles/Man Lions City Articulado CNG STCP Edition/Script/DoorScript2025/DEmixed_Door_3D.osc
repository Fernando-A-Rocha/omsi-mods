'SELF REMINDER!
'all door entry/exit requests should be counted from 0, and not from 1.
'especially important for correct functionality of CG-system
'otherwise even if passengers use correct doors, from-CG incorrect doors will open
'f*ck anyone who f*cked up pathlink counting, as this function is completely broken
'congrats for f*cking that up

'to see where are lines for specific doors search for comments:
'4_door_X

'--------------------------------------------------------------------------------
'   TRIGGERS
'--------------------------------------------------------------------------------

' Triggers for door 01 (1)

{trigger:door0_drag}
	(L.S.mouse_x) 400 / (L.L.doorDragAcc_0) + 1 min -1 max (S.L.doorDragAcc_0)
{end}

{trigger:door1_drag}
	(L.S.mouse_x) -400 / (L.L.doorDragAcc_1) + 1 min -1 max (S.L.doorDragAcc_1)
{end}

{trigger:CG_1}
	1 (S.L.PAX_door01_busy) (S.L.PAXReq_01_was_active) (S.L.haltewunsch) (S.L.CG_liczenie_01) (S.L.CG_random_01)
{end}

{trigger:bus_doorfront0f}
	
    (M.L.trg_bus_doorfront0f)
	1 (S.L.cockpit_tuertaster0)
	(T.L.ev_tuertaster_ein)
{end}

{trigger:bus_doorfront0f_off}
	0 (S.L.cockpit_tuertaster0)
	(T.L.ev_tuertaster_aus)
{end}

{trigger:bus_doorfront0}
	
    (M.L.trg_bus_doorfront0)
	1 (S.L.cockpit_tuertaster1)
	(T.L.ev_tuertaster_ein)
{end}

{trigger:bus_doorfront0_off}
	0 (S.L.cockpit_tuertaster1)
	(T.L.ev_tuertaster_aus)
{end}

' Triggers for door 23 (2)

{trigger:door2_drag}
	(L.S.mouse_x) 400 / (L.L.doorDragAcc_2) + 1 min -1 max (S.L.doorDragAcc_2)
{end}

{trigger:door3_drag}
	(L.S.mouse_x) -400 / (L.L.doorDragAcc_3) + 1 min -1 max (S.L.doorDragAcc_3)
{end}

{trigger:CG_2}
	1 (S.L.PAX_door23_busy) (S.L.PAXReq_23_was_active) (S.L.haltewunsch) (S.L.CG_liczenie_23) (S.L.CG_random_23)
{end}

{trigger:bus_doorfront1}
	
	(L.L.vis_dashboard_door_button_count) 2 <=
	{if}
		1 (S.L.door_20h_sw)
		(M.L.trg_bus_doorback23)
		1 (S.L.cockpit_tuertaster2)
		(T.L.ev_tuertaster_ein)
	{endif}

{end}

{trigger:bus_doorfront1_off}
	
	(L.L.vis_dashboard_door_button_count) 2 <=
	{if}
		0 (S.L.cockpit_tuertaster2)
		(T.L.ev_tuertaster_aus)
	{endif}

{end}

' Triggers for door 45 (3)

{trigger:door4_drag}
	(L.S.mouse_x) 400 / (L.L.doorDragAcc_4) + 1 min -1 max (S.L.doorDragAcc_4)
{end}

{trigger:door5_drag}
	(L.S.mouse_x) -400 / (L.L.doorDragAcc_5) + 1 min -1 max (S.L.doorDragAcc_5)
{end}

{trigger:CG_3}
	1 (S.L.PAX_door45_busy) (S.L.PAXReq_45_was_active) (S.L.haltewunsch) (S.L.CG_liczenie_45) (S.L.CG_random_45)
{end}

{trigger:bus_doorfront2}
	
	(L.L.vis_dashboard_door_button_count) 1 <=
	{if}
		1 (S.L.door_20h_sw)
		(M.L.trg_bus_doorfront5)
		1 (S.L.cockpit_tuertaster3)
		(T.L.ev_tuertaster_ein)
	{endif}

{end}

{trigger:bus_doorfront2_off}
	
	(L.L.vis_dashboard_door_button_count) 1 <=
	{if}
		0 (S.L.cockpit_tuertaster3)
		(T.L.ev_tuertaster_aus)
	{endif}

{end}

' Triggers for door 67 (4)

{trigger:cp_door_0_nothahn}
	(L.L.door_0_nothahn_sw) ! (S.L.door_0_nothahn_sw)

	(L.L.door_1_nothahn_sw) !
	(L.L.door_01_nothahn_sw) ! &&
	(L.L.Door_01_nothahn_sw_ext) ! &&
	{if}
		(L.L.door_0_nothahn_sw)
		{if}
			(L.L.vis_doortype_1) 11 =
			(L.L.vis_doortype_1) 12 = ||
			(L.L.vis_doortype_1) 17 = ||
			{if}
				(T.L.ev_enothahn01_auf)
			{else}
				(T.L.ev_nothahn01_auf)
			{endif}
		{else}
			(L.L.vis_doortype_1) 11 =
			(L.L.vis_doortype_1) 12 = ||
			(L.L.vis_doortype_1) 17 = ||
			{if}
				(T.L.ev_enothahn01_zu)
			{else}
				(T.L.ev_nothahn01_zu)
			{endif}
			0 (S.L.door_after_nothahn_reset_timer) (S.L.Door_0_nothahn_antirepeat) (S.L.Door_1_nothahn_antirepeat)
			1 (S.L.door_01_after_nothahn_reset)
		{endif}
	{endif}
{end}

