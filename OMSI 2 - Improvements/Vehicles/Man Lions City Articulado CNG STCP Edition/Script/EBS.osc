                            (L.L.ECAS_zieldruck_1_R) (L.L.ECAS_1_R_curr_level) (F.L.ECAS_reg_kneel) - (S.L.ECAS_zieldruck_1_R)
                        {endif}
                    {endif}
                {else}
                    (L.L.ECAS_target_reached_1_R)
                    {if}
                        (L.L.ECAS_1_R_curr_level) 120 <
                        {if}
                            (L.L.ECAS_zieldruck_1_R) (L.L.ECAS_1_R_curr_level) (F.L.ECAS_reg) + 850000 min (S.L.ECAS_zieldruck_1_R)
                        {endif}
                        
                        (L.L.ECAS_1_R_curr_level) 135 >
                        {if}
                            (L.L.ECAS_zieldruck_1_R) (L.L.ECAS_1_R_curr_level) (F.L.ECAS_reg) - 100000 max (S.L.ECAS_zieldruck_1_R)
                        {endif}
                    {endif}
                {endif}
            {endif}

' BALG - 1 - L

' Step I - check offset + count how many cycles ecas was at offset - 10 cycles = 3.0 s, aim for 5 cycles = 1.5 s

            (L.L.ECAS_1_L_curr_level) 102 <
            (L.L.ECAS_1_L_curr_level) 145 > ||
            (L.L.ECAS_target_reached_1_L) ! &&
            {if}
                (L.L.ECAS_offset_count_1_L) 1 + 15 min (S.L.ECAS_offset_count_1_L)
            {else}
                0 (S.L.ECAS_offset_count_1_L)
            {endif}

' Step II - save relevel as in progress

            (L.L.ECAS_offset_count_1_L) 6 >
            (L.L.ECAS_kneel_immidiate_command) 1 = ||
            {if}
                (L.L.ECAS_relevel_active_1_L) !
                {if}
                    (L.L.bremse_p_balg_1_L) 10000 / trunc 10000 * (S.L.ECAS_zieldruck_1_L)
                    1 (S.L.ECAS_relevel_active_1_L)
                {endif}
            {else}
                (L.L.ECAS_1_L_curr_level) 120 >
                (L.L.ECAS_1_L_curr_level) 135 < &&
                {if}
                    0 (S.L.ECAS_relevel_active_1_L)
                {endif}
            {endif}

' Step III - set new target pressure

' Step IIIa - set flag wheater or not new target pressure was reached

            (L.L.bremse_p_balg_1_L) 10000 / trunc (L.L.ECAS_zieldruck_1_L) 10000 / trunc =
            {if}
                1 (S.L.ECAS_target_reached_1_L)
                0 (S.L.ECAS_valve_allowed_1_L)
            {else}
                0 (S.L.ECAS_target_reached_1_L)

                (L.L.ECAS_relevel_active_1_L)
                {if}
                    1 (S.L.ECAS_valve_allowed_1_L)
                {else}
                    0 (S.L.ECAS_valve_allowed_1_L)
                {endif}
            {endif}

            (L.L.ECAS_relevel_active_1_L)
            {if}

' Step IIIb - if target was reached and offset is still too big, update target pressure

                (L.L.ECAS_target_reached_1_L)
                {if}
                    (L.L.ECAS_1_L_curr_level) 120 <
                    {if}
                        (L.L.ECAS_zieldruck_1_L) (L.L.ECAS_1_L_curr_level) (F.L.ECAS_reg) + 850000 min (S.L.ECAS_zieldruck_1_L)
                    {endif}
                    
                    (L.L.ECAS_1_L_curr_level) 135 >
                    {if}
                        (L.L.ECAS_zieldruck_1_L) (L.L.ECAS_1_L_curr_level) (F.L.ECAS_reg) - 100000 max (S.L.ECAS_zieldruck_1_L)
                    {endif}
                {endif}
            {endif}

' BALG - 2 - R

' Step I - check offset + count how many cycles ecas was at offset - 10 cycles = 3.0 s, aim for 5 cycles = 1.5 s

            (C.L.axle_count) 3 >= 
            {if}
                (L.L.ECAS_kneel_allowed) 1 >=
                {if}
                    (L.L.ECAS_2_R_curr_level) 2 >
                    {if}
                        (L.L.ECAS_offset_count_2_R) 1 + 15 min (S.L.ECAS_offset_count_2_R)
                    {else}
                        0 (S.L.ECAS_offset_count_2_R)
                    {endif}
                {else}
                    (L.L.ECAS_2_R_curr_level) 102 <
                    (L.L.ECAS_2_R_curr_level) 145 > ||
                    (L.L.ECAS_target_reached_2_R) ! &&
                    {if}
                        (L.L.ECAS_offset_count_2_R) 1 + 15 min (S.L.ECAS_offset_count_2_R)
                    {else}
                        0 (S.L.ECAS_offset_count_2_R)
                    {endif}
                {endif}

' Step II - save relevel as in progress

                (L.L.ECAS_offset_count_2_R) 6 >
                (L.L.ECAS_kneel_immidiate_command) 1 = ||
                {if}
                    (L.L.ECAS_relevel_active_2_R) !
                    {if}
                        (L.L.bremse_p_balg_2_R) 10000 / trunc 10000 * (S.L.ECAS_zieldruck_2_R)
                        1 (S.L.ECAS_relevel_active_2_R)
                    {endif}
                {else}
                    (L.L.ECAS_2_R_curr_level) 120 >
                    (L.L.ECAS_2_R_curr_level) 135 < &&
                    {if}
                        0 (S.L.ECAS_relevel_active_2_R)
                    {endif}
                {endif}

' Step III - set new target pressure

' Step IIIa - set flag wheater or not new target pressure was reached

                (L.L.bremse_p_balg_2_R) 10000 / trunc (L.L.ECAS_zieldruck_2_R) 10000 / trunc =
                {if}
                    1 (S.L.ECAS_target_reached_2_R)
                    0 (S.L.ECAS_valve_allowed_2_R)
                {else}
                    0 (S.L.ECAS_target_reached_2_R)

                    (L.L.ECAS_relevel_active_2_R)
                    {if}
                        1 (S.L.ECAS_valve_allowed_2_R)
                    {else}
                        0 (S.L.ECAS_valve_allowed_2_R)
                    {endif}
                {endif}

                (L.L.ECAS_relevel_active_2_R)
                {if}

' Step IIIb - if target was reached and offset is still too big, update target pressure

                    (L.L.ECAS_kneel_allowed) 1 >=
                    {if}
                        (L.L.ECAS_target_reached_2_R)
                        {if}
                            (L.L.ECAS_2_R_curr_level) 2 >
                            {if}
                                (L.L.ECAS_zieldruck_2_R) (L.L.ECAS_2_R_curr_level) (F.L.ECAS_reg_kneel) - (S.L.ECAS_zieldruck_2_R)
                            {endif}
                        {endif}
                    {else}
                        (L.L.ECAS_target_reached_2_R)
                        {if}
                            (L.L.ECAS_2_R_curr_level) 120 <
                            {if}
                                (L.L.ECAS_zieldruck_2_R) (L.L.ECAS_2_R_curr_level) (F.L.ECAS_reg) + 850000 min (S.L.ECAS_zieldruck_2_R)
                            {endif}
                            
                            (L.L.ECAS_2_R_curr_level) 135 >
                            {if}
                                (L.L.ECAS_zieldruck_2_R) (L.L.ECAS_2_R_curr_level) (F.L.ECAS_reg) - 100000 max (S.L.ECAS_zieldruck_2_R)
                            {endif}
                        {endif}
                    {endif}
                {endif}

' BALG - 2 - L

' Step I - check offset + count how many cycles ecas was at offset - 10 cycles = 3.0 s, aim for 5 cycles = 1.5 s

                (L.L.ECAS_2_L_curr_level) 102 <
                (L.L.ECAS_2_L_curr_level) 145 > ||
                (L.L.ECAS_target_reached_2_L) ! &&
                {if}
                    (L.L.ECAS_offset_count_2_L) 1 + 15 min (S.L.ECAS_offset_count_2_L)
                {else}
                    0 (S.L.ECAS_offset_count_2_L)
                {endif}

' Step II - save relevel as in progress

                (L.L.ECAS_offset_count_2_L) 6 >
                (L.L.ECAS_kneel_immidiate_command) 1 = ||
                {if}
                    (L.L.ECAS_relevel_active_2_L) !
                    {if}
                        (L.L.bremse_p_balg_2_L) 10000 / trunc 10000 * (S.L.ECAS_zieldruck_2_L)
                        1 (S.L.ECAS_relevel_active_2_L)
                    {endif}
                {else}
                    (L.L.ECAS_2_L_curr_level) 120 >
                    (L.L.ECAS_2_L_curr_level) 135 < &&
                    {if}
                        0 (S.L.ECAS_relevel_active_2_L)
                    {endif}
                {endif}

' Step III - set new target pressure

' Step IIIa - set flag wheater or not new target pressure was reached

                (L.L.bremse_p_balg_2_L) 10000 / trunc (L.L.ECAS_zieldruck_2_L) 10000 / trunc =
                {if}
                    1 (S.L.ECAS_target_reached_2_L)
                    0 (S.L.ECAS_valve_allowed_2_L)
                {else}
                    0 (S.L.ECAS_target_reached_2_L)

                    (L.L.ECAS_relevel_active_2_L)
                    {if}
                        1 (S.L.ECAS_valve_allowed_2_L)
                    {else}
                        0 (S.L.ECAS_valve_allowed_2_L)
                    {endif}
                {endif}

                (L.L.ECAS_relevel_active_2_L)
                {if}

' Step IIIb - if target was reached and offset is still too big, update target pressure

                    (L.L.ECAS_target_reached_2_L)
                    {if}
                        (L.L.ECAS_2_L_curr_level) 120 <
                        {if}
                            (L.L.ECAS_zieldruck_2_L) (L.L.ECAS_2_L_curr_level) (F.L.ECAS_reg) + 850000 min (S.L.ECAS_zieldruck_2_L)
                        {endif}
                        
                        (L.L.ECAS_2_L_curr_level) 135 >
                        {if}
                            (L.L.ECAS_zieldruck_2_L) (L.L.ECAS_2_L_curr_level) (F.L.ECAS_reg) - 100000 max (S.L.ECAS_zieldruck_2_L)
                        {endif}
                    {endif}
                {endif}
            {endif}

' BALG - 3 - R

' Step I - check offset + count how many cycles ecas was at offset - 10 cycles = 3.0 s, aim for 5 cycles = 1.5 s

            (C.L.axle_count) 4 >= 
            {if}
                (L.L.ECAS_kneel_allowed) 1 >=
                {if}
                    (L.L.ECAS_3_R_curr_level) 2 >
                    {if}
                        (L.L.ECAS_offset_count_3_R) 1 + 15 min (S.L.ECAS_offset_count_3_R)
                    {else}
                        0 (S.L.ECAS_offset_count_3_R)
                    {endif}
                {else}
                    (L.L.ECAS_3_R_curr_level) 102 <
                    (L.L.ECAS_3_R_curr_level) 145 > ||
                    (L.L.ECAS_target_reached_3_R) ! &&
                    {if}
                        (L.L.ECAS_offset_count_3_R) 1 + 15 min (S.L.ECAS_offset_count_3_R)
                    {else}
                        0 (S.L.ECAS_offset_count_3_R)
                    {endif}
                {endif}

' Step II - save relevel as in progress

                (L.L.ECAS_offset_count_3_R) 6 >
                (L.L.ECAS_kneel_immidiate_command) 1 = ||
                {if}
                    (L.L.ECAS_relevel_active_3_R) !
                    {if}
                        (L.L.bremse_p_balg_3_R) 10000 / trunc 10000 * (S.L.ECAS_zieldruck_3_R)
                        1 (S.L.ECAS_relevel_active_3_R)
                    {endif}
                {else}
                    (L.L.ECAS_3_R_curr_level) 120 >
                    (L.L.ECAS_3_R_curr_level) 135 < &&
                    {if}
                        0 (S.L.ECAS_relevel_active_3_R)
                    {endif}
                {endif}

' Step III - set new target pressure

' Step IIIa - set flag wheater or not new target pressure was reached

                (L.L.bremse_p_balg_3_R) 10000 / trunc (L.L.ECAS_zieldruck_3_R) 10000 / trunc =
                {if}
                    1 (S.L.ECAS_target_reached_3_R)
                    0 (S.L.ECAS_valve_allowed_3_R)
                {else}
                    0 (S.L.ECAS_target_reached_3_R)

                    (L.L.ECAS_relevel_active_3_R)
                    {if}
                        1 (S.L.ECAS_valve_allowed_3_R)
                    {else}
                        0 (S.L.ECAS_valve_allowed_3_R)
                    {endif}
                {endif}

                (L.L.ECAS_relevel_active_3_R)
                {if}

' Step IIIb - if target was reached and offset is still too big, update target pressure

                    (L.L.ECAS_kneel_allowed) 1 >=
                    {if}
                        (L.L.ECAS_target_reached_3_R)
                        {if}
                            (L.L.ECAS_3_R_curr_level) 2 >
                            {if}
                                (L.L.ECAS_zieldruck_3_R) (L.L.ECAS_3_R_curr_level) (F.L.ECAS_reg_kneel) - (S.L.ECAS_zieldruck_3_R)
                            {endif}
                        {endif}
                    {else}
                        (L.L.ECAS_target_reached_3_R)
                        {if}
                            (L.L.ECAS_3_R_curr_level) 120 <
                            {if}
                                (L.L.ECAS_zieldruck_3_R) (L.L.ECAS_3_R_curr_level) (F.L.ECAS_reg) + 850000 min (S.L.ECAS_zieldruck_3_R)
                            {endif}
                            
                            (L.L.ECAS_3_R_curr_level) 135 >
                            {if}
                                (L.L.ECAS_zieldruck_3_R) (L.L.ECAS_3_R_curr_level) (F.L.ECAS_reg) - 100000 max (S.L.ECAS_zieldruck_3_R)
                            {endif}
                        {endif}
                    {endif}
                {endif}

' BALG - 3 - L

' Step I - check offset + count how many cycles ecas was at offset - 10 cycles = 3.0 s, aim for 5 cycles = 1.5 s

                (L.L.ECAS_3_L_curr_level) 102 <
                (L.L.ECAS_3_L_curr_level) 145 > ||
                (L.L.ECAS_target_reached_0_L) ! &&
                {if}
                    (L.L.ECAS_offset_count_3_L) 1 + 15 min (S.L.ECAS_offset_count_3_L)
                {else}
                    0 (S.L.ECAS_offset_count_3_L)
                {endif}

' Step II - save relevel as in progress

                (L.L.ECAS_offset_count_3_L) 6 >
                (L.L.ECAS_kneel_immidiate_command) 1 = ||
                {if}
                    (L.L.ECAS_relevel_active_3_L) !
                    {if}
                        (L.L.bremse_p_balg_3_L) 10000 / trunc 10000 * (S.L.ECAS_zieldruck_3_L)
                        1 (S.L.ECAS_relevel_active_3_L)
                    {endif}
                {else}
                    (L.L.ECAS_3_L_curr_level) 120 >
                    (L.L.ECAS_3_L_curr_level) 135 < &&
                    {if}
                        0 (S.L.ECAS_relevel_active_3_L)
                    {endif}
                {endif}

' Step III - set new target pressure

' Step IIIa - set flag wheater or not new target pressure was reached

                (L.L.bremse_p_balg_3_L) 10000 / trunc (L.L.ECAS_zieldruck_3_L) 10000 / trunc =
                {if}
                    1 (S.L.ECAS_target_reached_3_L)
                    0 (S.L.ECAS_valve_allowed_3_L)
                {else}
                    0 (S.L.ECAS_target_reached_3_L)

                    (L.L.ECAS_relevel_active_3_L)
                    {if}
                        1 (S.L.ECAS_valve_allowed_3_L)
                    {else}
                        0 (S.L.ECAS_valve_allowed_3_L)
                    {endif}
                {endif}

                (L.L.ECAS_relevel_active_3_L)
                {if}

' Step IIIb - if target was reached and offset is still too big, update target pressure

                    (L.L.ECAS_target_reached_3_L)
                    {if}
                        (L.L.ECAS_3_L_curr_level) 120 <
                        {if}
                            (L.L.ECAS_zieldruck_3_L) (L.L.ECAS_3_L_curr_level) (F.L.ECAS_reg) + 850000 min (S.L.ECAS_zieldruck_3_L)
                        {endif}
                        
                        (L.L.ECAS_3_L_curr_level) 135 >
                        {if}
                            (L.L.ECAS_zieldruck_3_L) (L.L.ECAS_3_L_curr_level) (F.L.ECAS_reg) - 100000 max (S.L.ECAS_zieldruck_3_L)
                        {endif}
                    {endif}
                {endif}
            {endif}

        {endif}
    {else}
        0 (S.L.ECAS_valve_allowed_0_R) (S.L.ECAS_valve_allowed_0_L)
        0 (S.L.ECAS_offset_count_0_R) (S.L.ECAS_relevel_active_0_R) (S.L.ECAS_target_reached_0_R)
        0 (S.L.ECAS_offset_count_0_L) (S.L.ECAS_relevel_active_0_L) (S.L.ECAS_target_reached_0_L)
        0 (S.L.ECAS_valve_allowed_1_R) (S.L.ECAS_valve_allowed_1_L)
        0 (S.L.ECAS_offset_count_1_R) (S.L.ECAS_relevel_active_1_R) (S.L.ECAS_target_reached_1_R)
        0 (S.L.ECAS_offset_count_1_L) (S.L.ECAS_relevel_active_1_L) (S.L.ECAS_target_reached_1_L)
        0 (S.L.ECAS_valve_allowed_2_R) (S.L.ECAS_valve_allowed_2_L)
        0 (S.L.ECAS_offset_count_2_R) (S.L.ECAS_relevel_active_2_R) (S.L.ECAS_target_reached_2_R)
        0 (S.L.ECAS_offset_count_2_L) (S.L.ECAS_relevel_active_2_L) (S.L.ECAS_target_reached_2_L)
        0 (S.L.ECAS_valve_allowed_3_R) (S.L.ECAS_valve_allowed_3_L)
        0 (S.L.ECAS_offset_count_3_R) (S.L.ECAS_relevel_active_3_R) (S.L.ECAS_target_reached_3_R)
        0 (S.L.ECAS_offset_count_3_L) (S.L.ECAS_relevel_active_3_L) (S.L.ECAS_target_reached_3_L)
    {endif}

    (L.L.ECAS_kneel_allowed) (L.L.ECAS_kneel_allowed_last) =
    (L.L.cp_kneel_up_mode) ! &&
    (L.L.enable_auto_kneel_override) ! &&
    (L.L.vdv_display_startuptime) 5 < ||
    {if}
        0 (S.L.ECAS_kneel_immidiate_command)
    {endif}

    (L.L.ECAS_clock) 0.3 >=
    {if}
        0 (S.L.ECAS_clock)
    {endif}

'   Final ECAS balg calculation

    (L.L.Velocity) abs (F.L.susp_lean_curve) s0

    (L.L.bremse_p_balg_0_R) 460000 / (L.L.A_Trans_X) 9.81 / + l0 max (S.L.Axle_Springfactor_0_R)
    (L.L.bremse_p_balg_0_L) 460000 / (L.L.A_Trans_X) 9.81 / - l0 max (S.L.Axle_Springfactor_0_L)
    (L.L.bremse_p_balg_1_R) 460000 / (L.L.A_Trans_X) 9.81 / + l0 max (S.L.Axle_Springfactor_1_R)
    (L.L.bremse_p_balg_1_L) 460000 / (L.L.A_Trans_X) 9.81 / - l0 max (S.L.Axle_Springfactor_1_L)

    (C.L.axle_count) 3 >= 
    {if}
        (L.L.bremse_p_balg_2_R) 460000 / (L.L.A_Trans_X) 9.81 / + l0 max (S.L.Axle_Springfactor_2_R)
        (L.L.bremse_p_balg_2_L) 460000 / (L.L.A_Trans_X) 9.81 / - l0 max (S.L.Axle_Springfactor_2_L)
    {endif}
    
    (C.L.axle_count) 4 >= 
    {if}
        (L.L.bremse_p_balg_3_R) 460000 / (L.L.A_Trans_X) 9.81 / + l0 max (S.L.Axle_Springfactor_3_R)
        (L.L.bremse_p_balg_3_L) 460000 / (L.L.A_Trans_X) 9.81 / - l0 max (S.L.Axle_Springfactor_3_L)
    {endif}

{end}

{macro:bremse_kompressor}

	(L.L.bremse_kompressor) 1 =
	{if}
		(L.L.engine_n) (L.S.Timegap) * 60 / (C.L.bremse_m_kompressor) * 
		(C.L.RT_Luft) * (C.L.pneum_V_main_supply_line) / (L.L.pneum_main_supply_line) + (S.L.pneum_main_supply_line)
	{endif}

{end}

{macro:bremse_druckausgleich}
	
'	l1	Druck im Beh�lter 1
'	l2	Druck im Beh�lter 2
'	l3	Volumen Beh�lter 1
'	l4	Volumen Beh�lter 2
'	l5	Querschnittsfl�che Verbindungsleitung
'...
'	l6	tempor�re Variable, die die maximale Zeitkonstante enth�lt

	l1 l2 + 2 / l1 l2 - s0 * (C.L.RT_Luft) / abs sqrt l0 sgn * l5 * (C.L.RT_Luft) * s0

	l1 l2 - 1 l3 / 1 l4 / + l0 * / s6

	(L.S.Timegap) l6 min   l0     * l4 / l2 + s2
	(L.S.Timegap) l6 min   l0 /-/ * l3 / l1 + s1
{end}
