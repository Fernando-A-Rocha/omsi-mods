'Controls Brakes and includes air system (compressor)
'(c) 2025 - Sobol3D

'Script Version: 4.0

'Needs:
'- Engine (for compressor)

'Revision History:
'- Sobol3D - ate whopper

'--------------------------------------------------------------

'----------------------
'	Trigger
'----------------------

{trigger:parking_brake_toggle}

	(L.L.cp_eswitch_parbr) !
	{if}
		(L.L.bremse_feststell) ! (S.L.bremse_feststell) (S.L.bremse_feststell_sw)
		{if}
			(T.L.ev_bremse_feststell_ein)
		{else}
			(T.L.ev_bremse_feststell_aus)
		{endif}
	{else}
		(L.L.bremse_feststell_sw) ! (S.L.bremse_feststell_sw)
	{endif}

{end}


{trigger:parking_brake_set}
	
	(L.L.bremse_feststell) !
	(L.L.cp_eswitch_parbr) ! &&
	{if}
		(S.L.bremse_feststell)
		(T.L.ev_bremse_feststell_ein)

		1 (S.L.bremse_feststell_sw)
	{endif}

{end}

{trigger:parking_brake_release}

	(L.L.bremse_feststell)
	(L.L.cp_eswitch_parbr) ! &&
	{if}
		! (S.L.bremse_feststell)
		(T.L.ev_bremse_feststell_aus)

		0 (S.L.bremse_feststell_sw)
	{endif}

{end}

{trigger:parking_brake_mouse_drag}

	(L.S.mouse_y) 200 / (L.L.bremse_feststell_sw) + (S.L.bremse_feststell_sw) s0
	l0 0 <
	{if}
		0 (S.L.bremse_feststell_sw)
	{endif}
	l0 1 >
	{if}
		1 (S.L.bremse_feststell_sw)
	{endif}

	(L.L.cp_eswitch_parbr) !
	{if}
		l0 0.6 > (L.L.bremse_feststell) 0 = &&
		{if}
			1 (S.L.bremse_feststell)
			(T.L.ev_bremse_feststell_ein)
		{endif}
		l0 0.4 < (L.L.bremse_feststell) 1 = &&
		{if}
			0 (S.L.bremse_feststell)
			(T.L.ev_bremse_feststell_aus)
		{endif}
	{endif}

	1 (S.L.bremse_feststell_klinke)
{end}

{trigger:parking_brake_mouse_off}
	0 (S.L.bremse_feststell_klinke)
{end}

{trigger:wagenkasten_anheben}
	1 (S.L.anheben_sw)
	(T.L.ev_VDV_toggle_on)

	(L.L.anheben_sw)
	(L.L.elec_busbar_main) &&
	(L.L.ECAS_p_Tank) 550000 > &&
	(L.L.wagenkasten_anheben) 0.5 < &&
	(L.L.Fail_ECAS_true) 1 = ! &&
	{if}
		(T.L.ECAS_anheben_start)
	{else}
		(L.L.wagenkasten_anheben) 0.5 <
		(L.L.Fail_ECAS_true) 1 = ! &&
		{if}
			(T.L.ECAS_anheben_end)
		{endif}
	{endif}
{end}

{trigger:wagenkasten_anheben_off}
	0 (S.L.anheben_sw)
	(T.L.ev_VDV_toggle_off)

	(L.L.anheben_sw)
	(L.L.elec_busbar_main) &&
	(L.L.ECAS_p_Tank) 550000 > &&
	(L.L.wagenkasten_anheben) 0.5 = ||
	(L.L.Fail_ECAS_true) 1 = ! &&
	{if}
		(T.L.ECAS_anheben_end)
	{endif}
{end}

'----------------------
'	Init
'----------------------

{macro:bremse_init}

	1 (S.L.bremse_feststell_sw) (S.L.bremse_feststell)

'Setzen der Luftfederbalgdr�cke

	500000 random 320000 + (S.L.pneum_main_supply_line) 
	500000 random 320000 + (S.L.pneum_1_supply_line)
	500000 random 320000 + (S.L.pneum_2_supply_line)
	500000 random 320000 + (S.L.pneum_3_supply_line)
	500000 random 320000 + (S.L.pneum_4_supply_line)
	500000 random 320000 + (S.L.bremse_p_Tank01)
	500000 random 320000 + (S.L.bremse_p_Tank02)
	500000 random 320000 + (S.L.bremse_p_Tank03)
	500000 random 320000 + (S.L.bremse_p_Tank04)

'Leak rates

    40 random 10 + (S.L.pneum_main_supply_line_leak) 
    40 random 1 + (S.L.pneum_1_supply_line_leak)
    40 random 1 + (S.L.pneum_2_supply_line_leak)
    40 random 1 + (S.L.pneum_3_supply_line_leak)
    40 random 1 + (S.L.pneum_4_supply_line_leak)
    1600 random 500 + (S.L.bremse_p_Tank01_leak)
    1600 random 500 + (S.L.bremse_p_Tank02_leak)
    1600 random 500 + (S.L.bremse_p_Tank03_leak)
    1600 random 500 + (S.L.bremse_p_Tank04_leak)
    2700 random 1000 + (S.L.balg_0_R_leak)
    2700 random 2500 + (S.L.balg_0_L_leak)
    2700 random 1000 + (S.L.balg_1_R_leak)
    2700 random 2500 + (S.L.balg_1_L_leak)
    2700 random 1000 + (S.L.balg_2_R_leak)
    2700 random 2500 + (S.L.balg_2_L_leak)
    2700 random 1000 + (S.L.balg_3_R_leak)
    2700 random 2500 + (S.L.balg_3_L_leak)

'Setzen der Bremszylinderdr�cke	
	100000 (S.L.bremse_p_luft) (S.L.bremse_p_brzyl_A1_L) (S.L.bremse_p_brzyl_A1_R) (S.L.bremse_p_brzyl_A2_L) (S.L.bremse_p_brzyl_A2_R) (S.L.bremse_p_brzyl_A3_L) (S.L.bremse_p_brzyl_A3_R) (S.L.bremse_p_brzyl_A4_L) (S.L.bremse_p_brzyl_A4_R) 
	100000 (S.L.Axle_Brakeforce_0_L) (S.L.Axle_Brakeforce_0_R) (S.L.Axle_Brakeforce_1_L) (S.L.Axle_Brakeforce_1_R) (S.L.Axle_Brakeforce_2_L) (S.L.Axle_Brakeforce_2_R) (S.L.Axle_Brakeforce_3_L) (S.L.Axle_Brakeforce_3_R)
	130000 (S.L.ECAS_zieldruck_0_R) (S.L.ECAS_zieldruck_0_L) (S.L.ECAS_zieldruck_1_R) (S.L.ECAS_zieldruck_1_L) (S.L.ECAS_zieldruck_2_R) (S.L.ECAS_zieldruck_2_L) (S.L.ECAS_zieldruck_3_R) (S.L.ECAS_zieldruck_3_L)
	100000 (S.L.bremse_p_Balg_0_R) (S.L.bremse_p_Balg_0_L) (S.L.bremse_p_Balg_1_R) (S.L.bremse_p_Balg_1_L) (S.L.bremse_p_Balg_2_R) (S.L.bremse_p_Balg_2_L) (S.L.bremse_p_Balg_3_R) (S.L.bremse_p_Balg_3_L)

{end}

'----------------------
'	Frame
'----------------------

{macro:bremse_frame}

'	sensors

    (L.L.bremse_p_tank01) (S.L.bremse_p_tank01_sensor)
    (L.L.bremse_p_tank02) (S.L.bremse_p_tank02_sensor)
    (L.L.bremse_p_tank03) (S.L.bremse_p_tank03_sensor)
    (L.L.bremse_p_tank04) (S.L.bremse_p_tank04_sensor)

'	Turning kompressor on/off

	(L.L.pneum_main_supply_line) 980000 >
    (L.L.bremse_kompressor) 1 = &&
	{if}
		4 random (S.L.ev_kompressor_var)
		(T.L.ev_kompressor_aus)
		0 (S.L.bremse_kompressor)
	{endif}

    (L.L.pneum_main_supply_line) 720000 < 
	(L.L.engine_n) 300 > &&
	(L.L.bremse_kompressor) 0 = &&
	{if}
		(T.L.ev_kompressor_ein)
		1 (S.L.bremse_kompressor)
	{endif}

	(M.L.bremse_kompressor)

'	(M.L.bremse_druckluftsound)


    
'	Main supply line with resevoir -> Cutoff valve before vierkreisschutzventil
'   1 - open / 0 - closed

	(L.L.pneum_4sv_supply_line) 910000 > 
	{if}
		0 (S.L.pneum_4sv_supply_valve)
    {else}
        1 (S.L.pneum_4sv_supply_valve)
	{endif}

'	Supply line between cutoff valve and 4-way valve

	(L.L.pneum_4sv_supply_valve) 1 =
	{if}
        (L.L.pneum_main_supply_line) s1
		(L.L.pneum_4sv_supply_line) s2
		(C.L.pneum_V_main_supply_line) s3
		(C.L.pneum_V_4sv_supply_line) s4
		0.001 s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_main_supply_line) 
		l2 (S.L.pneum_4sv_supply_line) 
	{endif}

'	Vierkreisschutzventil (4-way valve) + tanks

	(L.L.pneum_1_supply_line) (C.L.pneum_kreis_open) <
	{if}
        1 (S.L.pneum_4sv_valve_kreis_1)
	{else}
        (L.L.pneum_1_supply_line) (C.L.pneum_kreis_close) >
        {if}
            0 (S.L.pneum_4sv_valve_kreis_1)
        {endif}
	{endif}

    (L.L.pneum_2_supply_line) (C.L.pneum_kreis_open) <
    {if}
        1 (S.L.pneum_4sv_valve_kreis_2)
    {else}
        (L.L.pneum_2_supply_line) (C.L.pneum_kreis_close) >
        {if}
            0 (S.L.pneum_4sv_valve_kreis_2)
        {endif}
    {endif}

    (L.L.pneum_3_supply_line) (C.L.pneum_kreis_open) <
    {if}
        1 (S.L.pneum_4sv_valve_kreis_3)
    {else}
        (L.L.pneum_3_supply_line) (C.L.pneum_kreis_close) >
        {if}
            0 (S.L.pneum_4sv_valve_kreis_3)
        {endif}
    {endif}

    (L.L.pneum_4_supply_line) (C.L.pneum_kreis_open) <
    {if}
        1 (S.L.pneum_4sv_valve_kreis_4)
    {else}
        (L.L.pneum_4_supply_line) (C.L.pneum_kreis_close) >
        {if}
            0 (S.L.pneum_4sv_valve_kreis_4)
        {endif}
    {endif}

    (L.L.pneum_4sv_valve_kreis_1) 1 =
    {if}
        (L.L.pneum_4sv_supply_line) s1
		(L.L.pneum_1_supply_line) s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.pneum_V_4sv_supply_line) s4
		0.001 s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_4sv_supply_line) 
		l2 (S.L.pneum_1_supply_line) 
    {endif}

    (L.L.pneum_4sv_valve_kreis_2) 1 =
    {if}
        (L.L.pneum_4sv_supply_line) s1
		(L.L.pneum_2_supply_line) s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.pneum_V_4sv_supply_line) s4
		0.001 s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_4sv_supply_line) 
		l2 (S.L.pneum_2_supply_line) 
    {endif}

    (L.L.pneum_4sv_valve_kreis_3) 1 =
    {if}
        (L.L.pneum_4sv_supply_line) s1
		(L.L.pneum_3_supply_line) s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.pneum_V_4sv_supply_line) s4
		0.001 s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_4sv_supply_line) 
		l2 (S.L.pneum_3_supply_line) 
    {endif}

    (L.L.pneum_4sv_valve_kreis_4) 1 =
    {if}
        (L.L.pneum_4sv_supply_line) s1
		(L.L.pneum_4_supply_line) s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.pneum_V_4sv_supply_line) s4
		0.001 s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_4sv_supply_line) 
		l2 (S.L.pneum_4_supply_line) 
    {endif}

    (L.L.pneum_1_supply_line) (L.L.bremse_p_Tank01) >
    {if}
        (L.L.pneum_1_supply_line) s1
		(L.L.bremse_p_Tank01) s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.bremse_V_tank01) s4
		0.001 s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_1_supply_line) 
		l2 (S.L.bremse_p_Tank01) 
    {endif}

    (L.L.pneum_2_supply_line) (L.L.bremse_p_Tank02) >
    {if}
        (L.L.pneum_2_supply_line) s1
		(L.L.bremse_p_Tank02) s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.bremse_V_tank02) s4
		0.001 s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_2_supply_line) 
		l2 (S.L.bremse_p_Tank02) 
    {endif}

    (L.L.pneum_3_supply_line) (L.L.bremse_p_Tank03) >
    {if}
        (L.L.pneum_3_supply_line) s1
		(L.L.bremse_p_Tank03) s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.bremse_V_tank03) s4
		0.001 s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_3_supply_line) 
		l2 (S.L.bremse_p_Tank03) 
    {endif}

    (L.L.pneum_4_supply_line) (L.L.bremse_p_Tank04) >
    {if}
        (L.L.pneum_4_supply_line) s1
		(L.L.bremse_p_Tank04) s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.bremse_V_tank04) s4
		0.001 s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_4_supply_line) 
		l2 (S.L.bremse_p_Tank04) 
    {endif}

'	Control brake cylinders for individual wheels

' axle 1

    (L.L.bremse_zieldruck_A1_L) (L.L.bremse_p_brzyl_A1_L) >
	{if}
		(L.L.bremse_zieldruck_A1_L) (L.L.bremse_p_brzyl_A1_L) - 20000000000 / (S.L.bremse_A_BrVentil_A1_L)

		(L.L.bremse_p_Tank02) s1
		(L.L.bremse_p_brzyl_A1_L) s2
		(C.L.bremse_V_tank02) s3
		(C.L.bremse_V_Brzyl) s4
		(L.L.bremse_A_BrVentil_A1_L) s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Tank02) 
		l2 (S.L.bremse_p_brzyl_A1_L) 
    {else}
		(L.L.bremse_p_brzyl_A1_L) (L.L.bremse_zieldruck_A1_L) - sqrt 20000000 / (S.L.bremse_A_BrVentil_A1_L)

		(L.L.bremse_p_brzyl_A1_L) s1
		(L.L.bremse_p_luft) s2
		(C.L.bremse_V_Brzyl) s3
		1000000 s4
		(L.L.bremse_A_BrVentil_A1_L) s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_brzyl_A1_L) 
	{endif}

    (L.L.bremse_zieldruck_A1_R) (L.L.bremse_p_brzyl_A1_R) >
	{if}
		(L.L.bremse_zieldruck_A1_R) (L.L.bremse_p_brzyl_A1_R) - 20000000000 / (S.L.bremse_A_BrVentil_A1_R)

		(L.L.bremse_p_Tank02) s1
		(L.L.bremse_p_brzyl_A1_R) s2
		(C.L.bremse_V_tank02) s3
		(C.L.bremse_V_Brzyl) s4
		(L.L.bremse_A_BrVentil_A1_R) s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Tank02) 
		l2 (S.L.bremse_p_brzyl_A1_R) 
    {else}
		(L.L.bremse_p_brzyl_A1_R) (L.L.bremse_zieldruck_A1_R) - sqrt 20000000 / (S.L.bremse_A_BrVentil_A1_R)

		(L.L.bremse_p_brzyl_A1_R) s1
		(L.L.bremse_p_luft) s2
		(C.L.bremse_V_Brzyl) s3
		1000000 s4
		(L.L.bremse_A_BrVentil_A1_R) s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_brzyl_A1_R) 
	{endif}

' axle 2

    (L.L.bremse_zieldruck_A2_L) (L.L.bremse_p_brzyl_A2_L) >
	{if}
		(L.L.bremse_zieldruck_A2_L) (L.L.bremse_p_brzyl_A2_L) - 20000000000 / (S.L.bremse_A_BrVentil_A2_L)

		(L.L.bremse_p_Tank01) s1
		(L.L.bremse_p_brzyl_A2_L) s2
		(C.L.bremse_V_tank02) s3
		(C.L.bremse_V_Brzyl) s4
		(L.L.bremse_A_BrVentil_A2_L) s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Tank01) 
		l2 (S.L.bremse_p_brzyl_A2_L) 
    {else}
		(L.L.bremse_p_brzyl_A2_L) (L.L.bremse_zieldruck_A2_L) - sqrt 20000000 / (S.L.bremse_A_BrVentil_A2_L)

		(L.L.bremse_p_brzyl_A2_L) s1
		(L.L.bremse_p_luft) s2
		(C.L.bremse_V_Brzyl) s3
		1000000 s4
		(L.L.bremse_A_BrVentil_A2_L) s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_brzyl_A2_L) 
	{endif}

    (L.L.bremse_zieldruck_A2_R) (L.L.bremse_p_brzyl_A2_R) >
	{if}
		(L.L.bremse_zieldruck_A2_R) (L.L.bremse_p_brzyl_A2_R) - 20000000000 / (S.L.bremse_A_BrVentil_A2_R)

		(L.L.bremse_p_Tank01) s1
		(L.L.bremse_p_brzyl_A2_R) s2
		(C.L.bremse_V_tank02) s3
		(C.L.bremse_V_Brzyl) s4
		(L.L.bremse_A_BrVentil_A2_R) s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Tank01) 
		l2 (S.L.bremse_p_brzyl_A2_R) 
    {else}
		(L.L.bremse_p_brzyl_A2_R) (L.L.bremse_zieldruck_A2_R) - sqrt 20000000 / (S.L.bremse_A_BrVentil_A2_R)

		(L.L.bremse_p_brzyl_A2_R) s1
		(L.L.bremse_p_luft) s2
		(C.L.bremse_V_Brzyl) s3
		1000000 s4
		(L.L.bremse_A_BrVentil_A2_R) s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_brzyl_A2_R) 
	{endif}

' axle 2 fest

    (L.L.bremse_zieldruck_Fest) (L.L.bremse_p_Brzyl_Fest) >
	{if}
		(L.L.bremse_zieldruck_Fest) (L.L.bremse_p_Brzyl_Fest) - 20000000000 / (S.L.bremse_A_BrVentil_Fest)

		(L.L.bremse_p_Tank03) s1
		(L.L.bremse_p_Brzyl_Fest) s2
		(C.L.bremse_V_tank02) s3
		(C.L.bremse_V_Brzyl) s4
		(L.L.bremse_A_BrVentil_Fest) s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Tank03) 
		l2 (S.L.bremse_p_Brzyl_Fest) 
    {else}
		(L.L.bremse_p_Brzyl_Fest) (L.L.bremse_zieldruck_Fest) - sqrt 20000000 / (S.L.bremse_A_BrVentil_Fest)

		(L.L.bremse_p_Brzyl_Fest) s1
		(L.L.bremse_p_luft) s2
		(C.L.bremse_V_Brzyl) s3
		1000000 s4
		(L.L.bremse_A_BrVentil_Fest) s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Brzyl_Fest) 
	{endif}

' axle 3

    (C.L.axle_count) 3 >=
    {if}
        (L.L.bremse_zieldruck_A3_L) (L.L.bremse_p_brzyl_A3_L) >
        {if}
            (L.L.bremse_zieldruck_A3_L) (L.L.bremse_p_brzyl_A3_L) - 20000000000 / (S.L.bremse_A_BrVentil_A3_L)

            (L.L.bremse_p_Tank01) s1
            (L.L.bremse_p_brzyl_A3_L) s2
            (C.L.bremse_V_tank02) s3
            (C.L.bremse_V_Brzyl) s4
            (L.L.bremse_A_BrVentil_A3_L) s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_Tank01) 
            l2 (S.L.bremse_p_brzyl_A3_L) 
        {else}
            (L.L.bremse_p_brzyl_A3_L) (L.L.bremse_zieldruck_A3_L) - sqrt 20000000 / (S.L.bremse_A_BrVentil_A3_L)

            (L.L.bremse_p_brzyl_A3_L) s1
            (L.L.bremse_p_luft) s2
            (C.L.bremse_V_Brzyl) s3
            1000000 s4
            (L.L.bremse_A_BrVentil_A3_L) s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_brzyl_A3_L) 
        {endif}

        (L.L.bremse_zieldruck_A3_R) (L.L.bremse_p_brzyl_A3_R) >
        {if}
            (L.L.bremse_zieldruck_A3_R) (L.L.bremse_p_brzyl_A3_R) - 20000000000 / (S.L.bremse_A_BrVentil_A3_R)

            (L.L.bremse_p_Tank01) s1
            (L.L.bremse_p_brzyl_A3_R) s2
            (C.L.bremse_V_tank02) s3
            (C.L.bremse_V_Brzyl) s4
            (L.L.bremse_A_BrVentil_A3_R) s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_Tank01) 
            l2 (S.L.bremse_p_brzyl_A3_R) 
        {else}
            (L.L.bremse_p_brzyl_A3_R) (L.L.bremse_zieldruck_A3_R) - sqrt 20000000 / (S.L.bremse_A_BrVentil_A3_R)

            (L.L.bremse_p_brzyl_A3_R) s1
            (L.L.bremse_p_luft) s2
            (C.L.bremse_V_Brzyl) s3
            1000000 s4
            (L.L.bremse_A_BrVentil_A3_R) s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_brzyl_A3_R) 
        {endif}
    {endif}
    
' axle 4

    (C.L.axle_count) 4 >=
    {if}
        (L.L.bremse_zieldruck_A4_L) (L.L.bremse_p_brzyl_A4_L) >
        {if}
            (L.L.bremse_zieldruck_A4_L) (L.L.bremse_p_brzyl_A4_L) - 20000000000 / (S.L.bremse_A_BrVentil_A4_L)

            (L.L.bremse_p_Tank01) s1
            (L.L.bremse_p_brzyl_A4_L) s2
            (C.L.bremse_V_tank02) s3
            (C.L.bremse_V_Brzyl) s4
            (L.L.bremse_A_BrVentil_A4_L) s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_Tank01) 
            l2 (S.L.bremse_p_brzyl_A4_L) 
        {else}
            (L.L.bremse_p_brzyl_A4_L) (L.L.bremse_zieldruck_A4_L) - sqrt 20000000 / (S.L.bremse_A_BrVentil_A4_L)

            (L.L.bremse_p_brzyl_A4_L) s1
            (L.L.bremse_p_luft) s2
            (C.L.bremse_V_Brzyl) s3
            1000000 s4
            (L.L.bremse_A_BrVentil_A4_L) s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_brzyl_A4_L) 
        {endif}

        (L.L.bremse_zieldruck_A4_R) (L.L.bremse_p_brzyl_A4_R) >
        {if}
            (L.L.bremse_zieldruck_A4_R) (L.L.bremse_p_brzyl_A4_R) - 20000000000 / (S.L.bremse_A_BrVentil_A4_R)

            (L.L.bremse_p_Tank01) s1
            (L.L.bremse_p_brzyl_A4_R) s2
            (C.L.bremse_V_tank02) s3
            (C.L.bremse_V_Brzyl) s4
            (L.L.bremse_A_BrVentil_A4_R) s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_Tank01) 
            l2 (S.L.bremse_p_brzyl_A4_R) 
        {else}
            (L.L.bremse_p_brzyl_A4_R) (L.L.bremse_zieldruck_A4_R) - sqrt 20000000 / (S.L.bremse_A_BrVentil_A4_R)

            (L.L.bremse_p_brzyl_A4_R) s1
            (L.L.bremse_p_luft) s2
            (C.L.bremse_V_Brzyl) s3
            1000000 s4
            (L.L.bremse_A_BrVentil_A4_R) s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_brzyl_A4_R) 
        {endif}
    {endif}
    
'	Ambient and breakdown leaks

	(L.L.pneum_main_supply_line) 120000 >
	{if}
        (L.L.pneum_main_supply_line) s1
		(L.L.pneum_main_supply_line) (L.L.pneum_main_supply_line_leak) - s2
		(C.L.pneum_V_main_supply_line) s3
		(C.L.pneum_V_main_supply_line) s4
		(L.L.pneum_main_supply_line_leak) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_main_supply_line) 
	{endif}

	(L.L.pneum_1_supply_line) 120000 >
	{if}
        (L.L.pneum_1_supply_line) s1
		(L.L.pneum_1_supply_line) (L.L.pneum_1_supply_line_leak) - s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.pneum_V_4sv_supply_line) s4
		(L.L.pneum_1_supply_line) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_1_supply_line) 
	{endif}

	(L.L.pneum_2_supply_line) 120000 >
	{if}
        (L.L.pneum_2_supply_line) s1
		(L.L.pneum_2_supply_line) (L.L.pneum_2_supply_line_leak) - s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.pneum_V_4sv_supply_line) s4
		(L.L.pneum_2_supply_line) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_2_supply_line) 
	{endif}

	(L.L.pneum_3_supply_line) 120000 >
	{if}
        (L.L.pneum_3_supply_line) s1
		(L.L.pneum_3_supply_line) (L.L.pneum_3_supply_line_leak) - s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.pneum_V_4sv_supply_line) s4
		(L.L.pneum_3_supply_line) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_3_supply_line) 
	{endif}

	(L.L.pneum_4_supply_line) 120000 >
	{if}
        (L.L.pneum_4_supply_line) s1
		(L.L.pneum_4_supply_line) (L.L.pneum_4_supply_line_leak) 200 / - s2
		(C.L.pneum_V_4sv_supply_line) s3
		(C.L.pneum_V_4sv_supply_line) s4
		(L.L.pneum_4_supply_line) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.pneum_4_supply_line) 
	{endif}

	(L.L.bremse_p_Tank01) 120000 >
	{if}
        (L.L.bremse_p_Tank01) s1
		(L.L.bremse_p_Tank01) (L.L.bremse_p_Tank01_leak) 200 / - s2
		(C.L.bremse_V_tank01) s3
		(C.L.bremse_V_tank01) s4
		(L.L.bremse_p_Tank01) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Tank01) 
	{endif}

	(L.L.bremse_p_Tank02) 120000 >
	{if}
        (L.L.bremse_p_Tank02) s1
		(L.L.bremse_p_Tank02) (L.L.bremse_p_Tank02_leak) 200 / - s2
		(C.L.bremse_V_tank02) s3
		(C.L.bremse_V_tank02) s4
		(L.L.bremse_p_Tank02) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Tank02) 
	{endif}

	(L.L.bremse_p_Tank03) 120000 >
	{if}
        (L.L.bremse_p_Tank03) s1
		(L.L.bremse_p_Tank03) (L.L.bremse_p_Tank03_leak) 200 / - s2
		(C.L.bremse_V_tank03) s3
		(C.L.bremse_V_tank03) s4
		(L.L.bremse_p_Tank03) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Tank03) 
	{endif}

	(L.L.bremse_p_Tank04) 120000 >
	{if}
        (L.L.bremse_p_Tank04) s1
		(L.L.bremse_p_Tank04) (L.L.bremse_p_Tank04_leak) 200 / - s2
		(C.L.bremse_V_tank04) s3
		(C.L.bremse_V_tank04) s4
		(L.L.bremse_p_Tank04) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Tank04) 
	{endif}

	(L.L.bremse_p_Balg_0_R) 120000 >
	{if}
        (L.L.bremse_p_Balg_0_R) s1
		(L.L.bremse_p_Balg_0_R) (L.L.balg_0_R_leak) 200 / - s2
		(C.L.bremse_V_balg_Vorn) s3
		(C.L.bremse_V_balg_Vorn) s4
		(L.L.bremse_p_Balg_0_R) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Balg_0_R) 
	{endif}

	(L.L.bremse_p_Balg_0_L) 120000 >
	{if}
        (L.L.bremse_p_Balg_0_L) s1
		(L.L.bremse_p_Balg_0_L) (L.L.balg_0_L_leak) 200 / - s2
		(C.L.bremse_V_balg_Vorn) s3
		(C.L.bremse_V_balg_Vorn) s4
		(L.L.bremse_p_Balg_0_L) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Balg_0_L) 
	{endif}

	(L.L.bremse_p_Balg_1_R) 120000 >
	{if}
        (L.L.bremse_p_Balg_1_R) s1
		(L.L.bremse_p_Balg_1_R) (L.L.balg_1_R_leak) 200 / - s2
		(C.L.bremse_V_balg_Hinten) s3
		(C.L.bremse_V_balg_Hinten) s4
		(L.L.bremse_p_Balg_1_R) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Balg_1_R) 
	{endif}

	(L.L.bremse_p_Balg_1_L) 120000 >
	{if}
        (L.L.bremse_p_Balg_1_L) s1
		(L.L.bremse_p_Balg_1_L) (L.L.balg_1_L_leak) 200 / - s2
		(C.L.bremse_V_balg_Hinten) s3
		(C.L.bremse_V_balg_Hinten) s4
		(L.L.bremse_p_Balg_1_L) 20000000 / s5

		(M.L.bremse_druckausgleich)

		l1 (S.L.bremse_p_Balg_1_L) 
	{endif}

    (C.L.axle_count) 3 >=
    {if}
        (L.L.bremse_p_Balg_2_R) 120000 >
        {if}
            (L.L.bremse_p_Balg_2_R) s1
            (L.L.bremse_p_Balg_2_R) (L.L.balg_2_R_leak) 200 / - s2
            (C.L.bremse_V_balg_Hinten) s3
            (C.L.bremse_V_balg_Hinten) s4
            (L.L.bremse_p_Balg_2_R) 20000000 / s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_Balg_2_R) 
        {endif}

        (L.L.bremse_p_Balg_2_L) 120000 >
        {if}
            (L.L.bremse_p_Balg_2_L) s1
            (L.L.bremse_p_Balg_2_L) (L.L.balg_2_L_leak) 200 / - s2
            (C.L.bremse_V_balg_Hinten) s3
            (C.L.bremse_V_balg_Hinten) s4
            (L.L.bremse_p_Balg_2_L) 20000000 / s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_Balg_2_L) 
        {endif}
    {endif}
    
    (C.L.axle_count) 4 >=
    {if}
        (L.L.bremse_p_Balg_3_R) 120000 >
        {if}
            (L.L.bremse_p_Balg_3_R) s1
            (L.L.bremse_p_Balg_3_R) (L.L.balg_3_R_leak) 200 / - s2
            (C.L.bremse_V_balg_Hinten) s3
            (C.L.bremse_V_balg_Hinten) s4
            (L.L.bremse_p_Balg_3_R) 20000000 / s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_Balg_3_R) 
        {endif}

        (L.L.bremse_p_Balg_3_L) 120000 >
        {if}
            (L.L.bremse_p_Balg_3_L) s1
            (L.L.bremse_p_Balg_3_L) (L.L.balg_3_L_leak) 200 / - s2
            (C.L.bremse_V_balg_Hinten) s3
            (C.L.bremse_V_balg_Hinten) s4
            (L.L.bremse_p_Balg_3_L) 20000000 / s5

            (M.L.bremse_druckausgleich)

            l1 (S.L.bremse_p_Balg_3_L) 
        {endif}
    {endif}

' additional variable for backwards compatibility with gearbox script

    (L.L.bremse_p_brzyl_A1_L) (L.L.bremse_p_brzyl_A1_R) + 2 / (S.L.bremse_p_Brzyl_VA)

    (L.L.bremse_p_brzyl_A2_L) (L.L.bremse_p_brzyl_A2_R) + 2 / (S.L.bremse_p_Brzyl_HA)

'	EBA emergency brake detection

	(C.L.bremse_EBA) (L.L.elec_busbar_main) &&
	{if}
		(L.L.Brake) 0.77 > 
		(L.L.Velocity_sensor) 25 > &&
		(L.L.EBA_emer_brake_detected) ! &&
		{if}
			1 (S.L.EBA_emer_brake_detected)
			(M.L.lights_startblinkgeber)
		{endif}

		(L.L.Brake) 0.2 <=
		(L.L.EBA_emer_brake_detected) &&
		{if}
			0 (S.L.EBA_emer_brake_detected)
			1 (S.L.EBA_emer_brake_finished)
		{endif}

		(L.L.Velocity_sensor) 1 <
		(L.L.EBA_emer_brake_detected) &&
		{if}
			1 (S.L.EBA_emer_brake_finished)
			0 (S.L.EBA_emer_brake_detected)
		{endif}

		(L.L.throttle) 0 >
		(L.L.lights_sw_warnblinker_sch) ||
		(L.L.lights_sw_blinker) 0 > ||
		(L.L.lights_sw_warnblinker) ||
		(L.L.EBA_emer_brake_finished) &&
		{if}
			0 (S.L.EBA_emer_brake_finished)
		{endif}
	{else}
		0 (S.L.EBA_emer_brake_finished) (S.L.EBA_emer_brake_detected)
	{endif}

	(L.L.bremse_ABS_eingriff)
	(L.L.EBA_emer_brake_detected) ! &&
	{if}
		1 (S.L.EBS_retarder_restricted)
	{else}
		0 (S.L.EBS_retarder_restricted)
	{endif}

'   Sets target values for wheels

'	Haltestellenbremse
'	Setzen des Zieldruckes

	(L.L.bremse_halte)
	(L.L.elec_busbar_main) &&
	(L.L.bremse_feststell) ! &&
	(L.L.Fail_Haltbrake_true) ! &&
	(L.L.cp_eswitch_hstbr) ! &&
	{if}
		(C.L.bremse_pmax_halte) (L.L.bremse_p_Tank01) min (S.L.bremse_zieldruck_halte)
	{else}
		100000 (S.L.bremse_zieldruck_halte)
	{endif}	

'	Sets target braking force

	(L.L.EBA_emer_brake_detected) !
	{if}
        (L.L.bremse_luft) (L.L.bremse_p_tank01) * 1.1 * 100000 + (S.L.bremse_zieldruck_pedal)
        (L.L.bremse_luft) (L.L.bremse_p_tank02) * 1.1 * 100000 + (S.L.bremse_zieldruck_pedal_Axle0)
	{else}
		1150000 (S.L.bremse_zieldruck_pedal) (S.L.bremse_zieldruck_pedal_Axle0)
	{endif}

'	Setzen des Bremszylinderzieldruckes FBA (mit uberlastschutz)

	1 (L.L.bremse_feststell) - (L.L.bremse_p_tank03) * 1.1 * 100000 + s1
	(L.L.bremse_zieldruck_A2) l1 max (S.L.bremse_zieldruck_Fest)

' Blending

    (L.L.antrieb_retardermoment) abs (F.L.bremse_blending) (S.L.bremse_blending_value)
    
' axle 1

    (L.L.bremse_zieldruck_pedal_Axle0) (L.L.bremse_blending_value) * (S.L.bremse_zieldruck_A1_R) (S.L.bremse_zieldruck_A1_L)
    
' axle 2+3+4

    (L.L.bremse_zieldruck_pedal) (L.L.bremse_blending_value) * (L.L.bremse_zieldruck_halte) max (S.L.bremse_zieldruck_A2_R) (S.L.bremse_zieldruck_A2_L) (S.L.bremse_zieldruck_A2) (S.L.bremse_zieldruck_A3_R) (S.L.bremse_zieldruck_A3_L) (S.L.bremse_zieldruck_A4_R) (S.L.bremse_zieldruck_A4_L)

'   End direct control over direct braking force effects on every wheel

' axle 1

	(L.L.bremse_p_brzyl_A1_L) 100000 - 20000 - 850000 / (C.L.max_bremskraft) * s0
	(L.L.Velocity) 3.6 / (L.L.Velocity) 3.6 / * 9.5 0.8 0.6 * * * +
	(C.L.axle_count) /
	(S.L.Axle_Brakeforce_0_L)

	(L.L.bremse_p_brzyl_A1_R) 100000 - 20000 - 850000 / (C.L.max_bremskraft) * s0
	(L.L.Velocity) 3.6 / (L.L.Velocity) 3.6 / * 9.5 0.8 0.6 * * * +
	(C.L.axle_count) /
	(S.L.Axle_Brakeforce_0_R)

' axle 2

	(L.L.bremse_p_brzyl_A2_L) 100000 - 20000 - 850000 / (C.L.max_bremskraft) * s0
