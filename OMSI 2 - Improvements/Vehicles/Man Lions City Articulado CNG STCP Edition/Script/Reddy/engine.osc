'----------------------
'	Trigger
'----------------------

{trigger:kw_m_engine_startbutton}
	(L.L.engine_on) ! (L.L.antrieb_getr_gangwahl) 1 = (L.L.elec_busbar_main) 0.3 > && &&
	(L.L.cp_SCRAM) ! &&
	(L.L.Gear_selector) 0 = &&
	{if}
		
		(L.L.AdBlue_lockup_active) 2 =
		(L.L.cp_SCRAM) ||
		{if}
			0 (S.L.engine_injection_on)
			1 (S.L.engine_starter)
		{else}
			1 (S.L.engine_starter) (S.L.engine_injection_on)
		{endif}
		
		(T.L.ev_engine_starter)
		
	{endif}	
	1 (S.L.cp_taster_anlasser)
	(T.L.ev_VDV_toggle_on)
{end}

{trigger:kw_m_engine_startbutton_off}
	0 (S.L.cp_taster_anlasser)
	0 (S.L.engine_starter)
	(T.L.ev_VDV_toggle_off)
{end}

{trigger:kw_m_enginestart}
	(L.L.engine_starter_antirepeat) !
	(L.L.cp_SCRAM) ! &&
	{if}
		(L.L.engine_on) !
		{if}	
			(L.L.Gear_selector) 0 =
			(L.L.elec_busbar_main) 0.3 > &&
			{if}
				(L.L.AdBlue_lockup_active) 2 =
				{if}
					0 (S.L.engine_injection_on)
					1 (S.L.engine_starter)
					0 (S.L.engine_start_wrong_gear)
				{else}
					1 (S.L.engine_starter) (S.L.engine_injection_on)
					0 (S.L.engine_start_wrong_gear)
				{endif}
				(T.L.ev_engine_starter)
			{else}
				1 (S.L.engine_start_wrong_gear)
			{endif}	
			1 (S.L.engine_starter_antirepeat)
		{else}
			(L.L.elec_busbar_main) (C.L.elec_busbar_minV) >
			{if}
				0 (S.L.engine_injection_on) (S.L.cp_key_rot)
				(T.L.ev_engine_shutdown_actuator_on)
				1 (S.L.engine_starter_antirepeat)
			{endif}
		{endif}
	{endif}

	1 (S.L.cp_taster_anlasser)

	(T.L.ev_key_starter)
{end}

{trigger:kw_m_enginestart_off}
'Sound kommt nur, wenn Abschaltung vorher an war:
	(L.L.engine_injection_on)
	{if}
		(T.L.ev_engine_shutdown_actuator_off)
	{endif}
	
		0 (S.L.cp_taster_motorabstellung) (S.L.cp_taster_anlasser) (S.L.engine_starter_antirepeat) (S.L.engine_starter) (L.L.engine_off_timer2_kurwa)
	
		(L.L.engine_off_timer_kurwa) (L.S.timegap) + 5 min (S.L.engine_off_timer_kurwa)
		5 =
		{if}
			1 (S.L.engine_injection_on)
			0 (L.L.engine_off_timer_kurwa)
			0 (S.L.Oil_level_decreased_after_engine_Start)
		{endif}
	{endif}
	
	(T.L.ev_key_starter_off)
{end}

{trigger:kw_m_engineshutdown}
	(L.L.elec_busbar_main) (C.L.elec_busbar_minV) > 
	{if}
		0 (S.L.engine_injection_on)
		(T.L.ev_engine_shutdown_actuator_on)
	{endif}
	1 (S.L.cp_taster_motorabstellung)

	(T.L.ev_VDV_toggle_on)
{end}

{trigger:kw_m_engineshutdown_off}
'Sound kommt nur, wenn Abschaltung vorher an war:
	(L.L.engine_injection_on) !
	{if}
		(T.L.ev_engine_shutdown_actuator_off)
	{endif}

	0 (S.L.cp_taster_motorabstellung)
	1 (S.L.engine_injection_on)

	(T.L.ev_VDV_toggle_off)
{end}


{trigger:tablet_debug_oil_plus}
	(L.L.oil_level) 0.2 + (S.L.oil_level)
{end}

{trigger:tablet_debug_oil_minus}
	(L.L.oil_level) 0.2 - (S.L.oil_level)
{end}

{trigger:tablet_debug_adblue_plus}
	(L.L.AdBlue_level) 1 + (S.L.AdBlue_level)
{end}

{trigger:tablet_debug_adblue_minus}
	(L.L.AdBlue_level) 1 - (S.L.AdBlue_level)
{end}

{trigger:tablet_debug_webasto_plus}
	(L.L.webasto_tank_content) 1 + (S.L.webasto_tank_content)
{end}

{trigger:tablet_debug_webasto_minus}
	(L.L.webasto_tank_content) 1 - (S.L.webasto_tank_content)
{end}

{trigger:tablet_debug_DPF_regen}
	
	(L.L.bremse_feststell)
	(L.L.engine_n) 100 > &&
	(L.L.Engine_DPF_state) 30 > &&
	{if}
		(L.L.Engine_DPF_Regen_Active) ! (S.L.Engine_DPF_Regen_Active)
	{endif}

{end}

{trigger:tablet_debug_DPF_full}
	160 (S.L.Engine_DPF_state)
{end}

{trigger:tablet_debug_malfunction_reset}
	0 (S.L.oil_level_sensor_failed) (S.L.oil_pressure_sensor_failed) (S.L.oil_temperature_sensor_failed) (S.L.tank_sensor_failed)
	0 (S.L.AdBlue_sensor_failed) (S.L.webasto_tank_sensor_failed) (S.L.vdv_fuckup) (S.L.vdv_asr2_timer)
{end}

{trigger:veh_tank}
	(L.L.engine_tank_content) (L.S.Timegap) 3 * + (C.L.engine_tank_capacity) min (S.L.engine_tank_content)
	(L.L.oil_level) (L.S.Timegap) 1 * + 10 min (S.L.oil_level)
	(L.L.webasto_tank_content) (L.S.Timegap) 1 * + 40 min (S.L.webasto_tank_content)
	(L.L.AdBlue_level) (L.S.Timegap) 0.84 * + 40 min (S.L.AdBlue_level)
{end}

{macro:engine_init}
	50 200 random + (S.L.engine_tank_content)
	(L.S.Weather_Temperature) (S.L.engine_temperature) (S.L.engine_temperature_envir) (S.L.engine_oil_temperature)
	(C.L.engine_RPM_ign_cold) (S.L.engine_RPM_ign)

	2 8 random + (S.L.oil_level)
	2 14 random + (S.L.webasto_tank_content)
	10 30 random + (S.L.AdBlue_level)
	5 150 random + (S.L.Engine_DPF_state)

	200 random (S.L.oil_level_sensor_failed)
	5000 random (S.L.oil_pressure_sensor_failed)
	5000 random (S.L.oil_temperature_sensor_failed)
	5000 random (S.L.tank_sensor_failed)
	5000 random (S.L.AdBlue_sensor_failed)

	10 random 100 / (S.L.oil_consumption_base_multiplier)

{end}

{macro:engine_frame}

' Engine preheating cycle
' needs:
'	- Electrics started up by at least 3s
'	- Engine temperature to be below 20 C
'	Preheat variable reports status = 0 off and ready / 1 running / 2 ready / 3 failed / 4 finished

	(L.L.vdv_display_startuptime) 3.65 >
	(L.L.engine_temperature) 18 < &&
	(L.L.engine_n) 300 <= &&
	(L.L.engine_preheat_done) ! &&
	(L.L.visvar_equipment_is_CNG) ! &&
	{if}
		(L.L.engine_starter) !
		{if}
			(L.L.engine_preheat_timer) (L.S.Timegap) + 20 min (S.L.engine_preheat_timer)
			(L.L.engine_preheat_timer) 20 <
			{if}
				(L.L.engine_temperature) (L.S.Timegap) 2 / + (S.L.engine_temperature)
				1 (S.L.engine_preheat_running)
			{else}
				(L.L.engine_preheat_timer) 2 >
				{if}
					3 (S.L.engine_preheat_running)
				{endif}
			{endif}
		{endif}
	{else}
		(L.L.engine_preheat_running) 1 =
		(L.L.engine_temperature) 18 >= &&
		(L.L.engine_n) 300 <= &&
		{if}
			2 (S.L.engine_preheat_running)
			1 (S.L.engine_preheat_done)
		{endif}
	{endif}

	(L.L.engine_preheat_done) 1 =
	(L.L.vdv_display_startuptime) 3 > &&
	{if}
		(L.L.engine_preheat_notif_time) (L.S.Timegap) + 20 min (S.L.engine_preheat_notif_time)

		(L.L.engine_preheat_notif_time) 20 =
		{if}
			4 (S.L.engine_preheat_running)
		{endif}
	{endif}

	(L.L.engine_n) 300 >
	{if}
		4 (S.L.engine_preheat_running)
	{endif}

	(L.L.vdv_display_startuptime) 3 <
	{if}
		0 (S.L.engine_preheat_timer) (S.L.engine_preheat_running) (S.L.engine_preheat_notif_time) (S.L.engine_preheat_done)
	{endif}

' breakdown randomizer (MYSTERY BOX OWO WHATS INSIDE? OLDRUCK ZU NIEDRIG? UWU LOCK MY ENGINE UP SENPAI)

	(L.L.elec_busbar_main_sw)
	{if}
		5 s2
		300 s3
	{else}
		1 s2
		80 s3
	{endif}

	(L.L.fixdown_timer) (L.S.Timegap) + 200 min (S.L.fixdown_timer)
	l2 >=
	{if}
		l3 random (S.L.fixdown_random)
		0 (S.L.fixdown_timer)
	{endif}

	(L.L.breakdown_timer) (L.S.Timegap) + 200 min (S.L.breakdown_timer)
	(L.L.breakdown_timer) 90 >= 
	{if}
		(L.S.Year) (L.L.visvar_equipment_manufacture_year) - 0 max (F.L.breakdown_multiplier) s4
		1024 l4 * trunc s5
		l5 random (S.L.breakdown_random)
		0 (S.L.breakdown_timer)
	{endif}

	(L.L.breakdown_random) s0
	(L.L.fixdown_random) s1

' ID 1		Wysoka temperatura plynu chlodzacego
'		DYNAMIC

' ID 2		Niski poziom chlodziwa
'		STATIC

	l0 1 = {if} 1 (S.L.Fail_Coolant_true) {endif}
	l1 1 = {if} 0 (S.L.Fail_Coolant_true) {endif}

' ID 3		Cisnienie oleju zbyt niskie
'		STATIC & DYNAMIC

	l0 2 = {if} 1 (S.L.oil_pressure_sensor_failed) {endif}
	l1 2 = {if} 0 (S.L.oil_pressure_sensor_failed) {endif}

' ID 4		Awaria Sterowania silnika
'		STATIC

	l0 3 = {if} 1 (S.L.Fail_EDC_AccelContr_true) {endif}
	l1 3 =	{if} 0 (S.L.Fail_EDC_AccelContr_true) {endif}

' ID 5		Usterka chlodzenia silnika
'		SEMI-STATIC

	l0 5 = {if} 1 (S.L.Fail_Hydrostat_true) {endif}
	l1 5 =	{if} 0 (S.L.Fail_Hydrostat_true) {endif}

' ID 6		Wysoka temperatura oleju
'		DYNAMIC

' ID 7		Usterka czujnika cisnienia doladowania
'		SEMI-STATIC

	l0 6 = {if} 2 (S.L.Fail_EDC_AccelContr_true) {endif}
	l1 6 =	{if} 0 (S.L.Fail_EDC_AccelContr_true) {endif}

' ID 8		Sprawdzic poziom oleju
'		STATIC & DYNAMIC

	l0 7 = {if} 1 (S.L.oil_level_sensor_failed) {endif}
	l1 7 =	{if} 0 (S.L.oil_level_sensor_failed) {endif}

' ID 9		Awaria alternator
'		STATIC

	l0 8 = {if} 1 (S.L.Fail_Alternator_true) {endif}
	l1 8 =	{if} 0 (S.L.Fail_Alternator_true) {endif}

' ID 10		Rozzarzanie
'		DYNAMIC

' ID 11		Rozzarzanie Ponow
'		DYNAMIC

' ID 12		URUCHOM SILNIK
'		DYNAMIC

' ID 13		Cisnienie CNG nieprawidlowe
'		STATIC

	l0 9 = {if} 1 (S.L.Fail_FPS_true) {endif}
	l1 9 =	{if} 0 (S.L.Fail_FPS_true) {endif}

' ID 14		Zapas cisnienia zbyt niski
'		DYNAMIC

	l0 10 = {if} 1 (S.L.pressure_sensors_failed) {endif}
	l1 10 =	{if} 0 (S.L.pressure_sensors_failed) {endif}

' ID 15		KSM Diagnoza 05519-02
'		STATIC

	l0 11 = {if} 1 (S.L.Fail_KSM_true) {endif}
	l1 11 =	{if} 0 (S.L.Fail_KSM_true) {endif}

' ID 16		123 Diagnoza 08133-03
'		STATIC

	l0 12 = {if} 1 (S.L.Fail_123_true) {endif}
	l1 12 =	{if} 0 (S.L.Fail_123_true) {endif}

' ID 17		Czujnik zmierzchu bez funkcji
'		STATIC

	l0 13 = {if} 1 (S.L.Fail_Twilight_true) {endif}
	l1 13 =	{if} 0 (S.L.Fail_Twilight_true) {endif}

' ID 18		Kat przegubu wysoki
'		DYNAMIC

' ID 19		Usterka ochrony przegubu
'		STATIC

	l0 14 = {if} 1 (S.L.Fail_Gelenk_true) {endif}
	l1 14 =	{if} 0 (S.L.Fail_Gelenk_true) {endif}

' ID 20		ABS Diagnoza 03500-01
'		STATIC & DYNAMIC
' ID 21		ASR Diagnoza 03516-02
'		STATIC & DYNAMIC

	l0 15 = {if} 2 (S.L.Fail_ABSASR_true) {endif}
	l0 16 = {if} 3 (S.L.Fail_ABSASR_true) {endif}
	l0 17 = {if} 4 (S.L.Fail_ABSASR_true) {endif}
	l0 18 = {if} 5 (S.L.Fail_ABSASR_true) {endif}
	l0 19 = {if} 1 (S.L.Fail_ABSASR_true) {endif}
	l0 20 = {if} 2 (S.L.Fail_ABSASR_true) {endif}

	l1 15 >=
	l1 20 <= &&
	{if}
		0 (S.L.Fail_ABSASR_true)
	{endif}

' ID 22		EBS Diagnoza 04004-03
'		STATIC & DYNAMIC

	l0 21 = {if} 1 (S.L.Fail_EBS_true) {endif}
	l1 21 =	{if} 0 (S.L.Fail_EBS_true) {endif}

' ID 23		Konieczna wymiana klockow hamulcowych
'		STATIC

	l0 22 = {if} 1 (S.L.Fail_BrakeLining_true) {endif}
	l1 22 =	{if} 0 (S.L.Fail_BrakeLining_true) {endif}

' ID 24		Usterka sygnalu predkosci
'		STATIC & DYNAMIC

	l0 23 = {if} 1 (S.L.Fail_VelocSensor_true) {endif}
	l1 23 = {if} 0 (S.L.Fail_VelocSensor_true) {endif}

	l0 24 = {if} 1 (S.L.Fail_VelocSensor_Interf_true) {endif}
	l1 24 = {if} 0 (S.L.Fail_VelocSensor_Interf_true) {endif}

' ID 25		EBS Diagnoza 03557-04
'		STATIC

	l0 25 = {if} 2 (S.L.Fail_EBS_true) {endif}
	l1 25 =	{if} 0 (S.L.Fail_EBS_true) {endif}

' ID 26		Awaryjne zwolnienie hamulca przystankowego
'		DYNAMIC

' ID 27		INFO Skontroluj uklad centralnego smarowania
'		STATIC

	l0 26 = {if} 1 (S.L.Fail_MUX_true) {endif}
	l1 26 =	{if} 0 (S.L.Fail_MUX_true) {endif}

' ID 28		Pierwsze dopuszczenie niewprowadzone
'		STATIC

	l0 27 = {if} 1 (S.L.Fail_AVSEPS_true) {endif}
	l1 27 =	{if} 0 (S.L.Fail_AVSEPS_true) {endif}

' ID 29		Awaria drzwi 1 otwarcie awaryjne
'		DYNAMIC

' ID 30		Awaria drzwi 2 otwarcie awaryjne
'		DYNAMIC

' ID 31		Awaria drzwi 3 otwarcie awaryjne
'		DYNAMIC

' ID 32		Awaria drzwi 4 otwarcie awaryjne
'		DYNAMIC

' ID 33		Awaria drzwi 5 otwarcie awaryjne
'		DYNAMIC

' ID 34		Brak komunikacji z tachografem
'		STATIC

	l0 28 = {if} 1 (S.L.Fail_TCO_true) {endif}
	l1 28 =	{if} 0 (S.L.Fail_TCO_true) {endif}

' ID 35		Sprawdzic tachograf
'		STATIC

	l0 29 = {if} 2 (S.L.Fail_TCO_true) {endif}
	l1 29 =	{if} 0 (S.L.Fail_TCO_true) {endif}

