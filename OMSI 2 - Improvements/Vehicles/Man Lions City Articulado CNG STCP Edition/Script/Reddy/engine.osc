'		(C.L.engine_starter_n_max) (L.L.engine_n) - (C.L.engine_starter_n_max) / 0 max (L.L.elec_busbar_main) * (C.L.engine_starterM) * s2 (L.L.engine_M) + (S.L.engine_M)
'flie�ender Strom: (0.10472 = 2*PI/60)
'		(L.L.elec_busbar_Rinv_summe) l2 (L.L.engine_n) 0.10472 * * (L.L.elec_busbar_main) (C.L.elec_Vnenn) * sqr / + (S.L.elec_busbar_Rinv_summe)
'Einfache Variante:
'		(L.L.elec_busbar_Rinv_summe) 1 0.15 (L.L.engine_n) 3000 / + / + (S.L.elec_busbar_Rinv_summe)



		l2 (L.L.engine_n) 0.10472 * * 
	{endif}

{end}



{macro:engine_acceleration}
'	Berechnung der Drehzahlbeschleunigung:

	(L.L.visvar_equipment_is_CNG)
	(L.L.engine_on) &&
	{if}
		(L.L.engine_M) (L.L.antrieb_getr_M_an) (L.L.engine_M_additional_load) + - (L.L.engine_n) (F.L.engine_J_variable) /
	{else}
		(L.L.engine_M) (L.L.antrieb_getr_M_an) (L.L.engine_M_additional_load) + - (C.L.engine_J) /
	{endif}

'	... Berechnung der Motordrehzahl anhand der Drehzahlbeschleunigung:

	(L.S.Timegap) * 30 * pi / (L.L.engine_n) + (C.L.engine_governed_max_RPM) min (S.L.engine_n)
{end}


{macro:engine_consumption}
'					      	=2*PI/60
	(L.L.engine_M) 0 max (L.L.engine_n) * 0.10472 * s0
	(L.L.engine_on)
	{if}
		l0 (C.L.engine_power_idle) + (S.L.engine_power)
	{else}
		l0 (S.L.engine_power)
	{endif}
	
'Beim Abw�rgen war der Tank leer - kann ja auch nicht sein! ;-)
	(L.L.engine_n) 100 >
	{if}

' first calculate current injectors dosage per 1 zylinder
'	check if bus is on idle or not

		(L.L.engine_n) (C.L.engine_governed_idle_RPM) 50 + >
		{if}
			(L.L.engine_throttle_injection) (F.L.engine_injectors_crossref_throttle) 
		{else}	
			20
		{endif}

' EDC now checks if engine is cold, if so, ups the dosage by approx 10-15%, and lowers the value if engine is overheat, after 125 C cutting the fuel flow

		(L.L.coolant_temperature_sensor) (F.L.engine_injectors_crossref_eng_temp) * 

' Now calculate MAP sensor factor

'	Throttle position

		(L.L.engine_n) (F.L.engine_injectors_crossref_MAP_RPM) *

'	Turboloader factor

		(L.L.engine_turbo_RPM) (F.L.engine_injectors_crossref_MAP_turbo) *

'	Engine temperature

		(L.L.coolant_temperature_sensor) (F.L.engine_injectors_crossref_MAP_eng_temp) *

'	Speed factor correction

		(L.L.Velocity_sensor) (F.L.engine_injectors_crossref_MAP_velocity) *

'	IAT correction

		(L.S.Weather_Temperature) (F.L.engine_injectors_crossref_MAP_air_temp) *

' now add load factor from additional things (AC, Alternators load etc)

		(L.L.lights_stand) 1.001 * 1 max 1.001 min *
		(L.L.lights_abbl) 1.001 * 1 max 1.001 min *
		(L.L.lights_beleuchtung) 1.001 * 1 max *
		(L.L.HVAC_AC_cooling) 1.05 * 1 max 1.05 min *
		(L.L.HVAC_AC_heizung) 1.05 * 1 max 1.05 min *

' multiply by number of zylinders

		6 *

' now crossrefrence that with current engine speed and divide by 3 (injection, explosion, exhaust)

		(L.L.engine_n) * 3 / s0

' and finally, convert miligrams to liters

		0.0000012 * 0 max (S.L.engine_fuel_current_use_l)

' debug

		l0 (S.L.engine_fuel_debug)

' now convert that variable to be used for current fuel usage per 100km/h

		(L.L.engine_fuel_current_use_l) 60 * 100 (L.L.Velocity) 0.1 max / * 199.9 min (S.L.engine_fuel_l_per_100km)

' now make less fuel in tanks

		(L.L.engine_tank_content) (L.L.engine_fuel_current_use_l) 3600 / 0.00001 max - 0 max (S.L.engine_tank_content)

'		(L.L.engine_energytransfer) (L.L.engine_power) (L.S.Timegap) * 1000 / 3600 / + (S.L.engine_energytransfer)
'		(L.L.engine_energy_used) (L.L.engine_power) (L.S.Timegap) * 1000 / 3600 / (L.L.engine_n) (F.L.engine_efficiency_rpm) (L.L.engine_throttle_injection) (F.L.engine_efficiency_throttle) / / (L.L.Engine_DPF_Regen_Active) 2000 / + (L.L.HVAC_AC_cooling) 4000 / + (L.L.HVAC_AC_heizung) 4000 / + (L.L.HVAC_podestheizung) 4000 / + s0 + (S.L.engine_energy_used)
'		(L.L.engine_fuel_used) l0 (C.L.engine_fuel_value) / s1 + (S.L.engine_fuel_used)
'	
'		l1 (L.S.Timegap) / 3600 * (L.L.engine_throttle_injection) * (S.L.engine_consumption_h)
'		(L.L.engine_tank_content) l1 - 0 max (S.L.engine_tank_content)
	{else}
		0 (S.L.engine_consumption_h) (S.L.engine_fuel_l_per_100km) (S.L.engine_fuel_current_use_l)
	{endif}

{end}

{macro:engine_speedcontrol}

	(L.L.engine_n_timein) 3 <
	{if}
		(L.L.engine_n) (L.L.engine_rpm_target) <
		{if}
			(L.L.engine_additional_throttle) (L.S.Timegap) 1.0 * + 0.4 min (S.L.engine_additional_throttle)
		{else}
			(L.L.engine_additional_throttle) (L.S.Timegap) 1.0 * - 0.07 max (S.L.engine_additional_throttle)
		{endif}
	{else}
		(L.L.engine_n) (L.L.engine_rpm_target) <
		{if}
			(L.L.engine_additional_throttle) (L.S.Timegap) 1.0 * + 0.164 min (S.L.engine_additional_throttle)
		{else}
			(L.L.engine_additional_throttle) (L.S.Timegap) 1.0 * - 0.04 max (S.L.engine_additional_throttle)
		{endif}
	{endif}

	(L.L.engine_internal_throttle) (L.L.engine_additional_throttle) + 1 min 0 max (L.L.engine_EBS_throttle_restr) * (S.L.engine_internal_throttle)

{end}


{macro:engine_temperature}


	(L.L.engine_power) (C.L.engine_Qrate_engine_factor) * (S.L.engine_Qrate_engine)

'	L�ftersteuerung Hydrostat
'	I - 1000 rpm
'	II - 1333 rpm
'	III - 1467 rpm
'	IV - 1667 RPM
'	V - 1933 RPM

	(L.L.engine_n) 300 >
	(L.L.coolant_temperature_sensor) 88 > &&
	(L.L.wiatrak_delay_timer) 0 > ||
	{if}

		(L.L.schaltverzoegerung_runter) 0.45 <
		{if}
			1000 (S.L.wiatrak_rpm_target)

			(L.L.wiatrak_gear_sound_played) !
			{if}
				16 random (S.L.wiatrak_gear_sound)
				(T.L.wiatrak_gear_downshift)
				1 (S.L.wiatrak_gear_sound_played)
			{endif}
		{else}
			0 (S.L.wiatrak_gear_sound_played)

			(L.L.brake)
			(L.L.antrieb_retarder) ||
			(L.L.Velocity_sensor) 2 > &&
			{if}

				(L.L.Velocity_sensor) 8 <
				{if}
					(L.L.coolant_temperature_sensor) 102 >
					{if}
						1933 (S.L.wiatrak_rpm_target)
					{else}
						(L.L.coolant_temperature_sensor) (F.L.engine_cooler_rpm_xref_temp) 1467 max
						(S.L.wiatrak_rpm_target)
					{endif}
				{else}
					(L.L.coolant_temperature_sensor) (F.L.engine_cooler_rpm_xref_temp) 1667 max
					(S.L.wiatrak_rpm_target)
				{endif}

			{else}

				(L.L.Velocity_sensor) 2 <
				{if}
					(L.L.coolant_temperature_sensor) 102 >
					{if}
						(L.L.coolant_temperature_sensor) (F.L.engine_cooler_rpm_xref_temp)
						1000 + 2 /
						(S.L.wiatrak_rpm_target)
					{else}
						1000 (S.L.wiatrak_rpm_target)
					{endif}
				{else}
					(L.L.coolant_temperature_sensor) (F.L.engine_cooler_rpm_xref_temp) 2 /
					(L.L.Velocity_sensor) (F.L.engine_cooler_rpm_xref_speed) 2 / +
					(L.L.engine_n) (F.L.engine_cooler_rpm_xref_throttle) 2 * +
					(L.L.engine_throttle_injection) (F.L.engine_cooler_rpm_xref_throttle2) 3 * + 6 /

					(S.L.wiatrak_rpm_target)
				{endif}
			{endif}
		{endif}
	{endif}

	(L.L.engine_on) !
	{if}
		0 (S.L.wiatrak_delay_timer) (S.L.wiatrak_rpm_target) 
	{endif}

	(L.L.wiatrak_rpm_target) 0 >
	(L.L.coolant_temperature_sensor) 88 < &&
	{if}
		(L.L.wiatrak_delay_timer) (L.S.Timegap) + (S.L.wiatrak_delay_timer) 60 >=
		{if}
			0 (S.L.wiatrak_rpm_target) 
		{endif}
	{endif}

	(L.L.coolant_temperature_sensor) 88 >
	{if}
		0 (S.L.wiatrak_delay_timer)
	{endif}


	(L.L.wiatrak_rpm_target) s0
	(L.L.wiatrak_rpm) s1
	1.5 s2
	1.7 s3
	(M.L.engine_traegheit)
	l1 (S.L.wiatrak_rpm)


	(L.L.engine_temperature) (C.L.kuehlerthermostat_opn) >
	(L.L.elec_busbar_main) (C.L.elec_busbar_minV) > (L.L.engine_on) && &&
	{if}
		1 (S.L.engine_thermostat_open)
	{endif}

	(L.L.engine_temperature) (C.L.kuehlerthermostat_cls) <
	(L.L.engine_on) ! ||
	{if}
		0 (S.L.engine_thermostat_open)
	{endif}

	(L.L.engine_temperature) (C.L.luefterthermostat_opn) >
	(L.L.elec_busbar_main) (C.L.elec_busbar_minV) > (L.L.engine_on) && &&
	{if}
		1 (S.L.engine_luefter) (S.L.engine_luefter_clamped)
	{endif}

	(L.L.engine_temperature) (C.L.luefterthermostat_cls) <
	(L.L.engine_on) ! ||
	{if}
		0 (S.L.engine_luefter) (S.L.engine_luefter_clamped)
	{endif}


	(L.L.engine_thermostat_open)
	(L.L.brake) 0.05 > &&
	(L.L.velocity) 15 > &&
	{if}
		(L.L.engine_n) 1.4 * 1300 min (S.L.radiator_RPM_sollwert)
		1 (S.L.engine_luefter)
	{else}
		(L.L.coolant_temperature_sensor) 95 > !
		{if}
			500 (S.L.radiator_RPM_sollwert)
		{endif}
		(L.L.engine_luefter_clamped) !
		{if}
			0 (S.L.engine_luefter)
		{endif}
	{endif}

	(L.L.engine_luefter)
	(L.L.coolant_temperature_sensor) 95 >= &&
	{if}
		(L.L.brake) 0.05 >
		(L.L.velocity) 15 > &&
		{if}
			(L.L.engine_n) 1.4 * 1300 min (S.L.radiator_RPM_sollwert)
			0 (S.L.lowering_rpm)
		{else}
			(L.L.velocity) 14 < &&
			(L.L.engine_n) 100 > &&
			{if}
				(L.L.lowering_rpm) !
				{if}
					1000 (S.L.radiator_RPM_sollwert)
					1 (S.L.lowering_rpm) (S.L.fan_static)
				{else}
					(L.L.radiator_RPM_sollwert) (L.S.Timegap) 5 * - 500 max (S.L.radiator_RPM_sollwert)
				{endif}
			{else}
				(L.L.engine_n) 1300 min (S.L.radiator_RPM_sollwert)
			{endif}
		{endif}
	{endif}

'debug



	(L.L.breakdown_53_true) 1 = !
	(L.L.breakdown_55_true) 1 = ! &&
	{if}
		(L.L.radiator_RPM) (L.L.radiator_RPM_sollwert) >
		{if}
			(L.L.radiator_RPM) (L.S.Timegap) 500 * - (L.L.radiator_RPM_sollwert) max (S.L.radiator_RPM)
		{else}
			(L.L.radiator_RPM) (L.S.Timegap) 500 * + (L.L.radiator_RPM_sollwert) min (S.L.radiator_RPM)
		{endif}
	{else}
		0 (S.L.radiator_RPM)
	{endif}

'	--------------------------------------------------
'	Berechnung der Raten:
	(L.L.breakdown_53_true) 1 = !
	(L.L.breakdown_55_true) 1 = ! &&
	{if}
		(L.L.engine_temperature) (L.L.engine_temperature_envir) - (C.L.engine_Qrate_cooling_factor) * (S.L.engine_Qrate_cooling)
		(L.L.engine_temperature) (L.S.Weather_Temperature) - (C.L.engine_Qrate_fan_factor) * (L.L.engine_n) * (S.L.engine_Qrate_fan)
	{else}
		(L.L.breakdown_53_true) 1 =
		{if}
			(L.L.engine_temperature) (L.L.engine_temperature_envir) - (C.L.engine_Qrate_cooling_factor) 0.65 * * (S.L.engine_Qrate_cooling)
			(L.L.engine_temperature) (L.S.Weather_Temperature) - (C.L.engine_Qrate_fan_factor) 0.65 * * (L.L.engine_n) * (S.L.engine_Qrate_fan)
		{else}
			(L.L.breakdown_55_true) 1 =
			{if}
				(L.L.engine_temperature) (L.L.engine_temperature_envir) - (C.L.engine_Qrate_cooling_factor) 0.85 * * (S.L.engine_Qrate_cooling)
				(L.L.engine_temperature) (L.S.Weather_Temperature) - (C.L.engine_Qrate_fan_factor) 0.85 * * (L.L.engine_n) * (S.L.engine_Qrate_fan)
			{endif}
		{endif}
	{endif}

	(L.L.engine_temperature_envir) (L.S.Weather_Temperature) - (C.L.engine_Qrate_Veloc_factor_basic) (C.L.engine_Qrate_veloc_factor) (L.L.velocity) abs * + * (S.L.engine_Qrate_veloc)

	(L.L.engine_thermostat_open)
	{if}
		(L.L.engine_luefter) !
		{if}	
'			Reduktion der K�hlwirkung durch nur leer mitdrehenden L�fter
			(L.L.engine_Qrate_fan) 0.4 * (S.L.engine_Qrate_fan)	
		{endif}
	{else}			
'		Nullwirkung des L�fters durch K�hlwasserkurzschluss	
		0 (S.L.engine_Qrate_fan)
	{endif}


'	--------------------------------------------------
'	Berechnung der Temperaturver�nderungen:

	(L.L.engine_Qrate_engine) (L.L.engine_Qrate_cooling) - (L.L.engine_Qrate_fan) - (L.L.cabinair_Qrate_engine_fanheatcooling) - (C.L.engine_cvm_engine) / (L.S.Timegap) * (L.L.engine_temperature) + (S.L.engine_temperature) 
	(L.L.engine_Qrate_cooling) (L.L.engine_Qrate_veloc) - (C.L.engine_cvm_envir) / (L.S.Timegap) * (L.L.engine_temperature_envir) + (S.L.engine_temperature_envir) 


'--------------------------------------------------




{end}


{macro:engine_traegheit}

'Simuliert tr�ges Verhalten (exponentiell)

'Ladekonventionen:
'	Sollwert		l0
'	Istwert			l1
'	Konstante Anlauf	l2 (Einheiten/s)
'	Konstante Ablauf	l3 (Einheiten/s)

'Anlauf oder Auslauf?
	l0 l1 > 
	{if}
		l2 (L.S.Timegap) * 1 min -1 max s4
	{else}
		l3 (L.S.Timegap) * 1 min -1 max s4
	{endif}


'Sollwert:
	l0
'Istwert:
	l1
'Beschleunigung:
	- l4 *
'Addition zum Istwert:
	l1 + s1
{end}



