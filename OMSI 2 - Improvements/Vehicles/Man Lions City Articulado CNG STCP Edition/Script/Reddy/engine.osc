	l0 30 = {if} 1 (S.L.Fail_FuelFilter_true) {endif}
	l1 30 =	{if} 0 (S.L.Fail_FuelFilter_true) {endif}

' ID 37		Predkosc obrotowa silnika zbyt wysoka
'		DYNAMIC

' ID 38		Zaciagnac hamulec postojowy
'		DYNAMIC

' ID 39		AdBlue! Moc zredukowana
'		STATIC

	l0 31 = {if} 1 (S.L.AdBlue_sensor_failed) {endif}
	l1 31 =	{if} 0 (S.L.AdBlue_sensor_failed) {endif}

' ID 40		TBM niedostepny
'		STATIC

	l0 32 = {if} 1 (S.L.Fail_FSS_true) {endif}
	l1 32 =	{if} 0 (S.L.Fail_FSS_true) {endif}

