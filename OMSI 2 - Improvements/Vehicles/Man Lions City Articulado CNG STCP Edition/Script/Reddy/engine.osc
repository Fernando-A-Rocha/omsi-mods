	l1 34 =	{if} 0 (S.L.Fail_ECAS_true) {endif}

' ID 43		EDC Diagnoza 08101-09
'		STATIC

	l0 35 = {if} 1 (S.L.Fail_EDC_true) {endif}
	l1 35 =	{if} 0 (S.L.Fail_EDC_true) {endif}

' ID 44		Usterka oczyszczania spalin
'		STATIC

	l0 36 = {if} 1 (S.L.Fail_SCR_true) {endif}
	l1 36 =	{if} 0 (S.L.Fail_SCR_true) {endif}

' ID 45		Ogrzewanie/Klimatyzacja Usterka
'		STATIC
'	Fault IDs:
'	1 - HLK no thermostat
'	2 - HLK no AC
'	3 - HLK no AC heat pump
'	4 - HLK no auto webasto + no ext temp reading

	l0 37 = {if} 1 (S.L.Fail_HVAC_true) {endif}
	l1 37 =	{if} 0 (S.L.Fail_HVAC_true) {endif}

	l0 38 = {if} 2 (S.L.Fail_HVAC_true) {endif}
	l1 38 =	{if} 0 (S.L.Fail_HVAC_true) {endif}

	l0 39 = {if} 3 (S.L.Fail_HVAC_true) {endif}
	l1 39 =	{if} 0 (S.L.Fail_HVAC_true) {endif}

	l0 40 = {if} 4 (S.L.Fail_HVAC_true) {endif}
	l1 40 =	{if} 0 (S.L.Fail_HVAC_true) {endif}

' ID 46		Usterka ogrzewania dodatkowego
'		STATIC

	l0 41 = {if} 1 (S.L.Fail_webasto_true) {endif}
	l1 41 =	{if} 0 (S.L.Fail_webasto_true) {endif}

	l0 42 = {if} 1 (S.L.webasto_tank_sensor_failed) {endif}
	l1 42 =	{if} 0 (S.L.webasto_tank_sensor_failed) {endif}

' ID 47		Wysoka temperatura skrzyni biegow
'		DYNAMIC

' ID 48		Przestaw skrzynie w polozenie NEUTRALNE
'		DYNAMIC

' ID 49		Usterka skrzyni biegow
